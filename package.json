{
  "name": "ask4trainings",
  "type": "module",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ask4trainings-maker/ask4trainings1.git"
  },
  "bugs": {
    "url": "https://github.com/ask4trainings-maker/ask4trainings1/issues"
  },
  "homepage": "https://ask4trainings.com",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "cms:proxy": "npx decap-server",
    "dev:cms": "concurrently \"npx decap-server\" \"astro dev\"",
    "build": "astro check && astro build && pagefind --site dist && node scripts/audit-internal-links.mjs && node scripts/audit-trailing-slashes.mjs",
    "build:quick": "astro build && node scripts/audit-internal-links.mjs && node scripts/audit-trailing-slashes.mjs",
    "audit:links": "node scripts/audit-internal-links.mjs",
    "audit:slashes": "node scripts/audit-trailing-slashes.mjs",
    "audit:content": "node scripts/cleanup-courses.mjs --dry-run",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.9",
    "glob": "^13.0.6",
    "js-yaml": "^5.4.2",
    "lucide-astro": "^0.556.0",
    "pagefind": "^1.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.5",
    "fast-xml-parser": "^5.11.2",
    "gray-matter": "^4.0.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
