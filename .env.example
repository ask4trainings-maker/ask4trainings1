# ==============================================================================
# ASK4TRAININGS — ENVIRONMENT VARIABLES SPECIFICATION & TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Variables prefixed with PUBLIC_* are exposed to the client browser and baked
#   statically into HTML and JS bundles at build time (Astro / Vite).
# - Variables without PUBLIC_* are server-side secrets consumed by Cloudflare
#   Pages Functions at edge runtime (never exposed to browser clients).
# - NEVER commit sensitive API keys or client secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT-SIDE VARIABLES (PUBLIC_*)
# ------------------------------------------------------------------------------

# Google Apps Script Web App Endpoint for Lead Submissions
# Deploy 'apps-script/enquiry-handler.gs' as a Web App (Execute as: Me, Access: Anyone).
# Example: https://script.google.com/macros/s/AKfycb.../exec
PUBLIC_STUDENT_APPS_SCRIPT_URL=

# Fallback Webhook URL (used if PUBLIC_STUDENT_APPS_SCRIPT_URL is not provided)
PUBLIC_APPS_SCRIPT_URL=

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX (found in GA4 Admin > Data Streams > Measurement ID)
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console Verification Token
# Alphanumeric string from the google-site-verification meta tag
PUBLIC_GSC_VERIFICATION_ID=

# Canonical Production Site URL
# Example: https://ask4trainings.com
PUBLIC_SITE_URL=https://ask4trainings.com


# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (CLOUDFLARE PAGES FUNCTIONS / SVELTIA CMS OAUTH)
# ------------------------------------------------------------------------------
# Configure these in Cloudflare Dashboard:
# Workers & Pages > ask4trainings > Settings > Environment variables
#
# Create via GitHub:
# Settings > Developer settings > OAuth Apps > New OAuth App
# - Homepage URL: https://ask4trainings.com
# - Authorization callback URL: https://ask4trainings.com/api/callback
# ------------------------------------------------------------------------------

# GitHub OAuth Client ID for Sveltia CMS authentication
GITHUB_CLIENT_ID=

# GitHub OAuth Client Secret for Sveltia CMS token exchange
# NOTE: Mark as "Encrypted" in the Cloudflare Pages dashboard
GITHUB_CLIENT_SECRET=

# Optional: GitHub Repository Target Override (defaults to repo in public/admin/config.yml)
# Example: ask4trainings-maker/ask4trainings1
GITHUB_REPO=ask4trainings-maker/ask4trainings1
