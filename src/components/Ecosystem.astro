---
import homeData from '../data/pages/home.json';
import { 
  Video, ScreenShare, MessageSquareQuote, 
  Server, Terminal, 
  FileText, FolderGit2, DownloadCloud, 
  Briefcase, CalendarCheck, Award 
} from 'lucide-astro';
---

<section class="py-24 relative overflow-hidden">
  <!-- Ambient Glow -->
  <div class="absolute top-1/2 left-0 -translate-y-1/2 w-[600px] h-[600px] bg-emerald-400/10 rounded-full blur-[100px] pointer-events-none -z-10"></div>
  
  <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
    <div class="mb-12">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-4">The Ask4Trainings Learning Ecosystem</h2>
      <p class="text-slate-500 max-w-2xl">A complete end-to-end framework designed for enterprise skill mastery.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-auto md:auto-rows-[340px]">
      
      <!-- Card 1: Live Classes (Large Span) -->
      <div class="lg:col-span-2 bg-white/90 backdrop-blur-md border border-slate-200/80 rounded-2xl p-6 shadow-sm hover:border-emerald-500/60 hover:shadow-xl hover:shadow-emerald-500/5 transition-all duration-300 flex flex-col group overflow-hidden relative min-w-0">
        
        <!-- Micro-UI Preview (Top Aligned) -->
        <div class="hidden md:flex flex-col gap-3 mb-8 w-full max-w-lg overflow-hidden bg-slate-50 rounded-xl border border-slate-200 p-4 shrink-0">
          <div class="flex items-center gap-3 flex-wrap">
            <span class="flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold bg-emerald-100 text-emerald-700 rounded-md">
              <ScreenShare class="w-3.5 h-3.5" /> HD Screen Share
            </span>
            <span class="flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium bg-white border border-slate-200 text-slate-600 rounded-md">
              <MessageSquareQuote class="w-3.5 h-3.5" /> Live Doubt Clearing
            </span>
            <span class="flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium bg-white border border-slate-200 text-slate-600 rounded-md">
              <Video class="w-3.5 h-3.5" /> Sandbox Sync
            </span>
          </div>
          <div class="flex items-center justify-between border-t border-slate-200 pt-3 mt-1">
            <div class="flex -space-x-2">
              <img class="w-7 h-7 rounded-full border-2 border-slate-50" src="https://ui-avatars.com/api/?name=Trainer&background=0D6E4F&color=fff" alt="Trainer" width="28" height="28" decoding="async" loading="lazy">
              <img class="w-7 h-7 rounded-full border-2 border-slate-50" src="https://ui-avatars.com/api/?name=Student&background=64748B&color=fff" alt="Student" width="28" height="28" decoding="async" loading="lazy">
              <div class="w-7 h-7 rounded-full border-2 border-slate-50 bg-slate-200 flex items-center justify-center text-[11px] font-semibold tabular-nums tracking-wide">+12</div>
            </div>
            <div class="flex items-center gap-1 opacity-80">
              <span class="w-1 h-3 bg-emerald-500 rounded-full animate-pulse"></span>
              <span class="w-1 h-4 bg-emerald-500 rounded-full animate-pulse delay-75"></span>
              <span class="w-1 h-2 bg-emerald-500 rounded-full animate-pulse delay-150"></span>
              <span class="w-1 h-5 bg-emerald-500 rounded-full animate-pulse delay-300"></span>
            </div>
          </div>
        </div>

        <div class="mt-auto shrink-0">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-100 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <Video class="w-6 h-6" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 leading-tight mb-2">{homeData.bento[0].title}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{homeData.bento[0].description}</p>
        </div>
      </div>

      <!-- Card 2: Cloud Sandboxes -->
      <div class="bg-white/90 backdrop-blur-md border border-slate-200/80 rounded-2xl p-6 shadow-sm hover:border-emerald-500/60 hover:shadow-xl hover:shadow-emerald-500/5 transition-all duration-300 flex flex-col group overflow-hidden min-w-0">
        
        <!-- Micro-UI Preview -->
        <div class="hidden md:flex flex-col gap-0 mb-8 w-full rounded-xl border border-slate-200 overflow-hidden bg-slate-900 shadow-inner shrink-0">
          <div class="bg-slate-800 px-3 py-2 flex items-center gap-2 border-b border-slate-700/50">
            <div class="flex gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-slate-600"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-slate-600"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></div>
            </div>
            <span class="text-[11px] font-semibold text-slate-400 tabular-nums tracking-wide ml-auto">Server Status</span>
          </div>
          <div class="p-3 font-mono text-xs flex flex-col gap-1.5 bg-slate-950">
            <div class="flex items-center gap-2 text-emerald-400">
              <Server class="w-3.5 h-3.5" /> <span class="bg-emerald-400/20 px-1.5 py-0.5 rounded text-emerald-300">Sandbox Active: Port 8080</span>
            </div>
            <div class="flex items-center gap-2 text-slate-500">
              <Terminal class="w-3.5 h-3.5" /> <span>$ deploy --env=prod</span>
            </div>
          </div>
        </div>

        <div class="mt-auto shrink-0">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-100 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <Server class="w-6 h-6" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 leading-tight mb-2">{homeData.bento[1].title}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{homeData.bento[1].description}</p>
        </div>
      </div>

      <!-- Card 3: PDF Vault -->
      <div class="bg-white/90 backdrop-blur-md border border-slate-200/80 rounded-2xl p-6 shadow-sm hover:border-emerald-500/60 hover:shadow-xl hover:shadow-emerald-500/5 transition-all duration-300 flex flex-col group overflow-hidden min-w-0">
        
        <!-- Micro-UI Preview -->
        <div class="hidden md:flex flex-col gap-2 mb-8 w-full shrink-0">
          <div class="flex items-center gap-3 p-2 rounded-lg bg-slate-50 border border-slate-200 group-hover:border-emerald-200 transition-colors">
            <div class="p-1.5 bg-rose-100 text-rose-600 rounded shrink-0"><FileText class="w-4 h-4" /></div>
            <div class="flex-1 min-w-0">
              <div class="text-xs font-semibold text-slate-700 truncate">Guidewire_Architecture.pdf</div>
              <div class="text-[11px] font-semibold text-slate-500 tabular-nums tracking-wide">2.4 MB</div>
            </div>
            <DownloadCloud class="w-4 h-4 text-slate-400 shrink-0" />
          </div>
          <div class="flex items-center gap-3 p-2 rounded-lg bg-slate-50 border border-slate-200 opacity-80 group-hover:opacity-100 transition-all">
            <div class="p-1.5 bg-blue-100 text-blue-600 rounded shrink-0"><FolderGit2 class="w-4 h-4" /></div>
            <div class="flex-1 min-w-0">
              <div class="text-xs font-semibold text-slate-700 truncate">Interview_Blueprints.docx</div>
              <div class="text-[11px] font-semibold text-slate-500 tabular-nums tracking-wide">1.1 MB</div>
            </div>
            <DownloadCloud class="w-4 h-4 text-slate-400 shrink-0" />
          </div>
        </div>

        <div class="mt-auto shrink-0">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-100 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <FileText class="w-6 h-6" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 leading-tight mb-2">{homeData.bento[2].title}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{homeData.bento[2].description}</p>
        </div>
      </div>

      <!-- Card 4: Mock Interviews (Large Span) -->
      <div class="lg:col-span-2 bg-white/90 backdrop-blur-md border border-slate-200/80 rounded-2xl p-6 shadow-sm hover:border-emerald-500/60 hover:shadow-xl hover:shadow-emerald-500/5 transition-all duration-300 flex flex-col group overflow-hidden min-w-0">
        
        <!-- Micro-UI Preview -->
        <div class="hidden md:flex flex-row items-center gap-4 mb-8 w-full max-w-lg shrink-0">
          <div class="flex items-center gap-2 p-3 rounded-xl bg-emerald-50 border border-emerald-200 flex-1 min-w-0">
            <div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center shrink-0">
              <Briefcase class="w-4 h-4" />
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-xs font-bold text-emerald-900 truncate">Resume Review Completed</div>
              <div class="text-[11px] font-semibold text-emerald-700 tabular-nums tracking-wide">ATS Score: 92%</div>
            </div>
            <CalendarCheck class="w-4 h-4 text-emerald-600 shrink-0" />
          </div>
          <div class="flex items-center gap-2 p-3 rounded-xl bg-slate-50 border border-slate-200 flex-1 min-w-0">
            <div class="w-8 h-8 rounded-full bg-slate-800 text-white flex items-center justify-center shrink-0">
              <Award class="w-4 h-4" />
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-xs font-bold text-slate-900 truncate">Technical Mock</div>
              <div class="text-[11px] font-semibold text-slate-500 tabular-nums tracking-wide">Score: 4.8/5.0</div>
            </div>
          </div>
        </div>

        <div class="mt-auto shrink-0">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-100 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <Briefcase class="w-6 h-6" />
          </div>
          <h3 class="text-lg font-bold text-slate-900 leading-tight mb-2">{homeData.bento[3].title}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{homeData.bento[3].description}</p>
        </div>
      </div>

    </div>
  </div>
</section>
