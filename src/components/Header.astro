<script>
// ── MEGA MENU: Category Tab Logic ───────────────────────────────────────────
const categoryTabs = document.querySelectorAll('.category-tab-btn');
const categoryPanels = document.querySelectorAll('.subcourse-panel');

const setActiveCategory = (targetId: string) => {
  categoryTabs.forEach(tab => {
    if (tab.getAttribute('data-category-target') === targetId) {
      tab.setAttribute('data-is-active', 'true');
      tab.className = 'category-tab-btn w-full text-left px-3 py-2 rounded-lg text-xs tracking-normal transition-all flex items-center justify-between bg-emerald-50 text-emerald-700 font-bold border-l-2 border-emerald-600';
    } else {
      tab.setAttribute('data-is-active', 'false');
      tab.className = 'category-tab-btn w-full text-left px-3 py-2 rounded-lg text-xs tracking-normal transition-all flex items-center justify-between text-slate-600 font-semibold hover:text-emerald-700 hover:bg-emerald-50/50 border-l-2 border-transparent';
    }
  });
  categoryPanels.forEach(panel => {
    (panel as HTMLElement).style.display =
      panel.getAttribute('data-category-panel') === targetId ? 'flex' : 'none';
  });
};

categoryTabs.forEach(tab => {
  tab.addEventListener('mouseenter', e => {
    const target = (e.currentTarget as HTMLElement).getAttribute('data-category-target');
    if (target) setActiveCategory(target);
  });
  tab.addEventListener('focus', e => {
    const target = (e.currentTarget as HTMLElement).getAttribute('data-category-target');
    if (target) setActiveCategory(target);
  });
});

// ── MEGA MENU: Show / Hide via JS (decoupled from <li> position) ─────────────
const megaTriggerLi  = document.getElementById('mega-menu-trigger-li');
const megaTriggerBtn = document.getElementById('mega-menu-trigger-btn');
const megaPanel      = document.getElementById('mega-menu-panel');
const megaChevron    = document.getElementById('mega-menu-chevron');
const megaUnderline  = document.getElementById('mega-menu-underline');
let   megaCloseTimer: ReturnType<typeof setTimeout> | null = null;

function openMegaMenu() {
  if (!megaPanel) return;
  if (megaCloseTimer) { clearTimeout(megaCloseTimer); megaCloseTimer = null; }
  megaPanel.classList.remove('opacity-0', 'translate-y-1', 'pointer-events-none');
  megaPanel.classList.add('opacity-100', 'translate-y-0');
  megaTriggerBtn?.setAttribute('aria-expanded', 'true');
  megaChevron?.classList.add('rotate-180');
  megaUnderline?.classList.add('w-full');
  megaUnderline?.classList.remove('w-0');
  // Defensive boundary guard: clamp left edge inside viewport
  requestAnimationFrame(() => {
    if (!megaPanel) return;
    const rect = megaPanel.getBoundingClientRect();
    const safeMargin = 16;
    if (rect.left < safeMargin) {
      megaPanel.style.left = safeMargin + 'px';
      megaPanel.style.transform = 'none';
    }
    if (rect.right > window.innerWidth - safeMargin) {
      const overflow = rect.right - (window.innerWidth - safeMargin);
      const currentLeft = parseFloat(megaPanel.style.left) || rect.left;
      megaPanel.style.left = Math.max(safeMargin, currentLeft - overflow) + 'px';
      megaPanel.style.transform = 'none';
    }
  });
}

function scheduleMegaClose() {
  megaCloseTimer = setTimeout(closeMegaMenu, 120);
}

function closeMegaMenu() {
  if (!megaPanel) return;
  megaPanel.classList.add('opacity-0', 'translate-y-1', 'pointer-events-none');
  megaPanel.classList.remove('opacity-100', 'translate-y-0');
  megaTriggerBtn?.setAttribute('aria-expanded', 'false');
  megaChevron?.classList.remove('rotate-180');
  megaUnderline?.classList.remove('w-full');
  megaUnderline?.classList.add('w-0');
}

// Trigger li: open on mouseenter, schedule close on mouseleave
megaTriggerLi?.addEventListener('mouseenter', openMegaMenu);
megaTriggerLi?.addEventListener('mouseleave', scheduleMegaClose);

// Panel itself: cancel close when re-entering, schedule close on leave
megaPanel?.addEventListener('mouseenter', () => {
  if (megaCloseTimer) { clearTimeout(megaCloseTimer); megaCloseTimer = null; }
});
megaPanel?.addEventListener('mouseleave', scheduleMegaClose);

// Keyboard: toggle on Enter/Space, close on Escape
megaTriggerBtn?.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' || e.key === ' ') {
    e.preventDefault();
    megaPanel?.classList.contains('opacity-100') ? closeMegaMenu() : openMegaMenu();
  }
});
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeMegaMenu();
    (document.activeElement as HTMLElement)?.blur();
  }
});

// Click outside to close
document.addEventListener('click', (e) => {
  if (!megaTriggerLi?.contains(e.target as Node) && !megaPanel?.contains(e.target as Node)) {
    closeMegaMenu();
  }
});

// Mobile Menu Logic
const toggleBtn = document.getElementById('mobile-menu-toggle');
const drawer = document.getElementById('mobile-drawer');
const overlay = document.getElementById('mobile-drawer-overlay');
const iconOpen = document.getElementById('hamburger-icon');
const iconClose = document.getElementById('close-icon');
const mobileLinks = document.querySelectorAll('.mobile-link');
const mobileSearchBtn = document.getElementById('mobile-search-btn');
const searchTrigger = document.getElementById('search-trigger');

let isMenuOpen = false;

const toggleMenu = () => {
  isMenuOpen = !isMenuOpen;
  toggleBtn?.setAttribute('aria-expanded', isMenuOpen.toString());
  
  if (isMenuOpen) {
    document.body.classList.add('overflow-hidden');
    overlay?.classList.remove('hidden');
    requestAnimationFrame(() => {
      overlay?.classList.remove('opacity-0');
      drawer?.classList.remove('translate-x-full');
    });
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
  } else {
    document.body.classList.remove('overflow-hidden');
    overlay?.classList.add('opacity-0');
    drawer?.classList.add('translate-x-full');
    setTimeout(() => {
      overlay?.classList.add('hidden');
    }, 300);
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }
};

toggleBtn?.addEventListener('click', toggleMenu);
overlay?.addEventListener('click', toggleMenu);

mobileLinks.forEach(link => {
  link.addEventListener('click', () => {
    if (isMenuOpen) toggleMenu();
  });
});

mobileSearchBtn?.addEventListener('click', () => {
  if (isMenuOpen) toggleMenu();
  searchTrigger?.click();
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && isMenuOpen) {
    toggleMenu();
  }
});
</script>
