---
import { getCollection } from 'astro:content';
import categoriesData from '../data/categories.json';
import navigationData from '../data/navigation.json';
import settingsData from '../data/settings.json';
import SearchModal from './SearchModal.astro';

const allCourses = await getCollection('courses');

// Clean legacy title prefixes for display in micro-cards
function cleanMegaTitle(title: string): string {
  return title
    .replace(/^(Best\s+|Course\s+Tag\s*[-–]?\s*|Courses\s*)/i, '')
    .replace(/\s{2,}/g, ' ')
    .trim();
}

function getCourseUrl(course: any): string {
  const cleanSlug = course.id.replace(/\.mdx?$/, '');
  return `/${cleanSlug}/`;
}

const categories = categoriesData.categories.map((cat: any) => ({
  id: cat.id,
  name: cat.title,
  description: cat.description
}));

const coursesByCategory = categories.reduce((acc, cat) => {
  const cats = allCourses.filter(c => c.data.category === cat.id);
  // Sort alphabetically within each category
  acc[cat.id] = cats.sort((a, b) => a.data.title.localeCompare(b.data.title));
  return acc;
}, {} as Record<string, any[]>);

const totalCourseCount = allCourses.length;

// Route Normalization & Active State Logic
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const checkActive = (href: string) => currentPath === href.replace(/\/$/, '') || (href === '/' && currentPath === '/');

const isCoursesActive = currentPath === '/courses' || currentPath.startsWith('/courses/');
const isBlogActive = currentPath === '/blog' || currentPath.startsWith('/blog/');
const isAboutActive = checkActive('/about-us');
const isContactActive = checkActive('/contact-us');
---
<header id="main-site-header" class="w-full sticky top-0 z-50 transition-transform duration-300 ease-in-out">
  <!-- Top Contact Strip -->
  <div class="hidden md:block bg-slate-100 text-slate-600 text-xs py-1.5 border-b border-slate-100 font-mono tracking-wide">
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full flex justify-between items-center">
      <!-- Left: Contacts -->
      <div class="flex items-center gap-6">
        <a href={`tel:${settingsData.contact.phone2}`} class="hover:text-slate-900 transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {settingsData.contact.phone2}
        </a>
        <a href={`mailto:${settingsData.contact.email}`} class="hover:text-slate-900 transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          {settingsData.contact.email}
        </a>
      </div>

      <!-- Right: Socials -->
      <div class="flex items-center gap-5">
        <!-- Facebook -->
        {settingsData.socials.facebook && (
          <a href={settingsData.socials.facebook} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-[#1877F2] transition-colors" aria-label="Facebook">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
          </a>
        )}
        <!-- X (Twitter) -->
        {settingsData.socials.twitter && (
          <a href={settingsData.socials.twitter} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-black transition-colors" aria-label="X (Twitter)">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
          </a>
        )}
        <!-- LinkedIn -->
        {settingsData.socials.linkedin && (
          <a href={settingsData.socials.linkedin} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-[#0A66C2] transition-colors" aria-label="LinkedIn">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        )}
        <!-- YouTube -->
        {settingsData.socials.youtube && (
          <a href={settingsData.socials.youtube} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-[#FF0000] transition-colors" aria-label="YouTube">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        )}
        <!-- Instagram -->
        {settingsData.socials.instagram && (
          <a href={settingsData.socials.instagram} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-[#E1306C] transition-colors" aria-label="Instagram">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <nav id="main-nav" class="bg-white/80 hover:bg-white backdrop-blur-md border-b border-slate-200 transition-colors duration-300 relative" aria-label="Main Navigation">
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 h-16 flex justify-between items-center w-full">
      <!-- Logo -->
      <a href="/" class="flex-shrink-0 flex items-center">
        <span class="text-2xl font-black font-heading text-slate-900 tracking-tight">Ask 4 <span class="text-emerald-600">Trainings</span></span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex flex-1 justify-center">
        <ul class="flex items-center gap-8 font-medium text-sm text-slate-600">
          <!-- Mega Menu Trigger (panel is anchored to nav, not this li) -->
          <li id="mega-menu-trigger-li">
            <button
              id="mega-menu-trigger-btn"
              class={`transition-colors py-5 flex items-center gap-1.5 focus:outline-none relative ${isCoursesActive ? 'text-emerald-600' : 'text-slate-600 hover:text-slate-900'}`}
              aria-expanded="false"
              aria-controls="mega-menu-panel"
              aria-current={isCoursesActive ? 'page' : undefined}
            >
              All Courses
              <svg id="mega-menu-chevron" class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              <span class={`absolute bottom-0 left-0 h-0.5 bg-emerald-600 rounded-t-full transition-all duration-300 ${isCoursesActive ? 'w-full' : 'w-0'}`} id="mega-menu-underline"></span>
            </button>
          </li>
          
          <li>
            <a href="/blog/" class={`group/link relative py-5 block transition-colors ${isBlogActive ? 'text-emerald-600' : 'text-slate-600 hover:text-slate-900'}`} aria-current={isBlogActive ? 'page' : undefined}>
              Blog
              <span class={`absolute bottom-0 left-0 h-0.5 bg-emerald-600 rounded-t-full transition-all duration-300 ${isBlogActive ? 'w-full' : 'w-0 group-hover/link:w-full'}`}></span>
            </a>
          </li>
          <li>
            <a href="/about-us/" class={`group/link relative py-5 block transition-colors ${isAboutActive ? 'text-emerald-600' : 'text-slate-600 hover:text-slate-900'}`} aria-current={isAboutActive ? 'page' : undefined}>
              About Us
              <span class={`absolute bottom-0 left-0 h-0.5 bg-emerald-600 rounded-t-full transition-all duration-300 ${isAboutActive ? 'w-full' : 'w-0 group-hover/link:w-full'}`}></span>
            </a>
          </li>
          <li>
            <a href="/contact-us/" class={`group/link relative py-5 block transition-colors ${isContactActive ? 'text-emerald-600' : 'text-slate-600 hover:text-slate-900'}`} aria-current={isContactActive ? 'page' : undefined}>
              Contact
              <span class={`absolute bottom-0 left-0 h-0.5 bg-emerald-600 rounded-t-full transition-all duration-300 ${isContactActive ? 'w-full' : 'w-0 group-hover/link:w-full'}`}></span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Action Cluster -->
      <div class="hidden lg:flex items-center gap-4 flex-shrink-0">
        <!-- Search Trigger -->
        <button id="search-trigger" class="p-2 text-slate-500 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors border border-transparent hover:border-slate-200 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <span class="text-xs font-mono bg-slate-100 border border-slate-200 px-1.5 py-0.5 rounded text-slate-500">⌘K</span>
        </button>
        
        <!-- LMS Portal Ghost Button -->
        <a href="#lms" class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 border border-slate-700 hover:border-slate-500 rounded-lg transition-all flex items-center gap-2 group relative">
          <svg class="w-4 h-4 text-slate-500 group-hover:text-slate-900 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          {navigationData.lmsButtonText}
          <div class="absolute top-full right-0 mt-2 w-64 bg-slate-100 border border-slate-200 rounded-xl p-4 shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all text-left z-50">
            <p class="text-xs text-slate-600 leading-relaxed mb-3">Access your dedicated cloud sandboxes, recorded sessions, and study materials.</p>
            <span class="text-xs font-semibold text-emerald-600 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span> Active Students Only</span>
          </div>
        </a>

        <!-- Enquire / WhatsApp CTA -->
        <a href="https://wa.me/918099949888" target="_blank" rel="noopener noreferrer" class="px-5 py-2 text-sm font-semibold bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition-all shadow-md hover:-translate-y-0.5 flex items-center gap-2">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Enquire Now
      </a>
    </div>
    
    <!-- Mobile Menu Button -->
    <button id="mobile-menu-toggle" aria-expanded="false" class="lg:hidden p-2 text-slate-600 hover:text-slate-900 focus:outline-none z-[60] relative" aria-label="Toggle Menu">
      <svg id="hamburger-icon" class="w-6 h-6 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg id="close-icon" class="w-6 h-6 hidden transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- ============================================================
       MEGA MENU PANEL — Anchored to <nav>, NOT to <li>
       Uses inset-x safe coordinates: never clips left or right edge.
       Flex-column layout: header strip | dual-pane scroll | pinned footer.
  ============================================================ -->
  <div
    id="mega-menu-panel"
    role="region"
    aria-label="Course categories"
    class="hidden lg:block absolute left-4 right-4 top-full mt-1 z-50 pointer-events-none opacity-0 translate-y-1 transition-all duration-200 ease-out"
    style="max-width: min(calc(100% - 2rem), 72rem); left: max(1rem, calc(50% - 36rem));"
  >
    <div class="bg-white border border-slate-200 rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[calc(100vh-5.5rem)] pointer-events-auto">

      <!-- ── DUAL-PANE ROW (fills remaining height) ── -->
      <div class="flex flex-1 overflow-hidden">

        <!-- Left: Category Sidebar — fixed width, independent scroll -->
        <div class="flex-shrink-0 w-52 xl:w-60 border-r border-slate-200 overflow-y-auto overscroll-contain py-3 px-2 space-y-0.5 custom-scrollbar">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`category-tab-btn w-full text-left px-3 py-2 rounded-lg text-xs tracking-normal transition-all flex items-center justify-between ${idx === 0 ? 'bg-emerald-50 text-emerald-700 font-bold border-l-2 border-emerald-600' : 'text-slate-600 font-semibold hover:text-emerald-700 hover:bg-emerald-50/50 border-l-2 border-transparent'}`}
              data-category-target={cat.id}
              data-is-active={idx === 0 ? "true" : "false"}
            >
              <span class="min-w-0 truncate">{cat.name}</span>
              <span class="text-[11px] text-slate-500 font-medium tabular-nums flex-shrink-0 ml-1">({(coursesByCategory[cat.id] || []).length})</span>
            </button>
          ))}
        </div>

        <!-- Right: Course Display — flex-col, header + scrolling grid + pinned footer -->
        <div class="flex-1 min-w-0 flex flex-col overflow-hidden">
          {categories.map((cat, idx) => (
            <div
              class="subcourse-panel flex-col overflow-hidden flex-1"
              data-category-panel={cat.id}
              style={idx === 0 ? "display: flex;" : "display: none;"}
            >
              <!-- Sub-header row (always visible) -->
              <div class="flex items-center justify-between px-4 pt-4 pb-3 border-b border-slate-200 flex-shrink-0">
                <div class="min-w-0">
                  <h4 class="text-slate-900 font-semibold text-sm truncate">{cat.name} Courses</h4>
                  <p class="text-xs text-slate-500 line-clamp-1">{cat.description}</p>
                </div>
                <a
                  href={`/courses/?category=${cat.id}`}
                  class="text-xs text-emerald-600 hover:text-amber-400 font-medium flex items-center gap-1 shrink-0 ml-3"
                >
                  View Category Hub ↗
                </a>
              </div>

              <!-- Scrollable course grid (isolated scroll — does NOT move sidebar) -->
              <div class="flex-1 overflow-y-auto overscroll-contain p-4 custom-scrollbar">
                <div class="grid grid-cols-1 xl:grid-cols-2 gap-2">
                  {(coursesByCategory[cat.id] || []).map((course: any) => (
                    <a
                      href={getCourseUrl(course)}
                      class="group p-2.5 rounded-lg bg-slate-100/50 hover:bg-emerald-50 border border-slate-100 hover:border-emerald-600/40 transition-all flex flex-col gap-1 min-w-0"
                    >
                      <span class="text-[13px] font-semibold text-slate-900 group-hover:text-emerald-700 leading-snug line-clamp-2 tracking-normal transition-colors break-words">
                        {cleanMegaTitle(course.data.menuTitle || course.data.title || course.data.h1 || course.id)}
                      </span>
                      <span class="text-[11px] font-medium text-slate-500 flex items-center gap-1.5 tabular-nums">
                        <span>{course.data.batchInfo?.duration || '45-60 Hrs'}</span>
                        <span>•</span>
                        <span class="text-emerald-600">{course.data.batchInfo?.format || 'Live Online'}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </div>

              <!-- Pinned footer strip (OUTSIDE scroll container — always visible) -->
              <div class="flex-shrink-0 px-4 py-3 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500 bg-slate-50/60">
                <span class="flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  24/7 Sandbox Lab Access Included
                </span>
                <a href="/courses/" class="text-slate-600 hover:text-emerald-600 font-medium">
                  Explore All {totalCourseCount} Courses →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</nav>

<SearchModal />
</header>

<!-- Mobile Slide-Over Drawer -->
<div id="mobile-drawer-overlay" class="fixed inset-0 bg-white/80 backdrop-blur-sm z-[55] hidden opacity-0 transition-opacity duration-300"></div>
<div id="mobile-drawer" class="fixed top-0 right-0 h-full w-[300px] sm:w-[350px] bg-white border-l border-slate-200 z-[55] transform translate-x-full transition-transform duration-300 overflow-y-auto flex flex-col">
<div class="p-5 border-b border-slate-200 flex-shrink-0 mt-14">
  <button id="mobile-search-btn" class="w-full flex items-center justify-between p-3 bg-slate-100 rounded-lg border border-slate-200 text-slate-600 hover:text-slate-900 hover:border-emerald-600/50 transition-colors">
    <span class="flex items-center gap-2"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg> Search Courses</span>
  </button>
</div>

<div class="flex-1 overflow-y-auto overscroll-contain p-5 custom-scrollbar">
  <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-4">Course Categories</h3>
  <div class="space-y-2 mb-8">
    {categories.map(cat => (
      <details class="group bg-slate-100/30 rounded-lg overflow-hidden border border-transparent hover:border-slate-100 transition-colors">
        <summary class="flex items-center justify-between p-3 cursor-pointer list-none text-slate-600 hover:text-slate-900 text-sm font-medium focus:outline-none">
          <span class="flex items-center gap-2">
            {cat.name}
            <span class="text-[10px] bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded font-mono">{(coursesByCategory[cat.id] || []).length}</span>
          </span>
          <svg class="w-4 h-4 text-slate-500 transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
