---
export interface Props {
  title: string;
  category: string;
  duration: string;
  format: string;
  slug: string;
}
const { title, category, duration, format, slug } = Astro.props;
---
<article class="bg-surface-0 border border-border rounded-lg p-6 hover:-translate-y-1 hover:shadow-xl transition-transform duration-200 flex flex-col h-full">
  <div class="mb-4 flex items-center justify-between">
    <span class="text-xs font-semibold text-primary bg-primary-light px-2 py-1 rounded-full uppercase tracking-wider">{category.replace('-', ' ')}</span>
    <span class="text-xs text-ink-500 font-medium">{format}</span>
  </div>
  <h3 class="text-xl font-heading font-bold text-ink-900 mb-3 flex-grow leading-tight">{title}</h3>
  <div class="flex items-center gap-2 mb-6 text-sm text-ink-500">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    {duration}
  </div>
  <a href={`/${slug}`} class="block w-full text-center bg-primary hover:bg-primary-hover text-surface-0 font-medium py-2 px-4 rounded-lg transition-colors mt-auto">
    View Course
  </a>
</article>
