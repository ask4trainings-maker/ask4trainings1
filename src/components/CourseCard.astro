---
export interface Props {
  title: string;
  category: string;
  duration: string;
  format: string;
  slug: string;
}
const { title, category, duration, format, slug } = Astro.props;
---
<article 
  class="course-card group bg-slate-900/60 backdrop-blur-sm border border-white/10 rounded-xl p-5 sm:p-6 flex flex-col h-full relative overflow-hidden transition-all duration-300 hover:border-primary/50 hover:-translate-y-1 hover:shadow-[0_8px_30px_rgb(0,0,0,0.6)]"
  data-category={category}
>
  <!-- Ambient Hover Glow -->
  <div class="absolute -inset-1 bg-gradient-to-br from-primary/10 to-accent/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 blur-xl -z-10 pointer-events-none"></div>
  
  <!-- Header: Category & Batch Info -->
  <div class="mb-5 flex flex-wrap items-center justify-between gap-2">
    <span class="text-[10px] font-bold text-primary-light bg-primary/20 border border-primary/30 px-2.5 py-1 rounded-full uppercase tracking-wider">
      {category.replace('-', ' ')}
    </span>
    <span class="text-[10px] font-mono text-accent-light bg-accent/20 border border-accent/30 px-2 py-1 rounded flex items-center gap-1.5 uppercase tracking-wide">
      <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse-slow"></span>
      Weekend Batch
    </span>
  </div>

  <!-- Title -->
  <h3 class="text-xl font-heading font-bold text-surface-0 mb-4 leading-tight group-hover:text-primary-light transition-colors">
    <a href={`/${slug}`} class="focus:outline-none focus-visible:underline">
      {title}
    </a>
  </h3>

  <!-- Specs (Monospace) -->
  <div class="flex items-center gap-3 mb-6 text-xs font-mono text-slate-400">
    <span class="flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      {duration}
    </span>
    <span class="text-white/20">•</span>
    <span class="flex items-center gap-1.5 text-slate-300">
      <svg class="w-3.5 h-3.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
      {format}
    </span>
  </div>

  <!-- Key Modules (Checklist) -->
  <ul class="space-y-2.5 mb-8 flex-grow">
    <li class="flex items-start gap-2 text-sm text-slate-300 leading-snug">
      <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      Hands-on Architecture Labs
    </li>
    <li class="flex items-start gap-2 text-sm text-slate-300 leading-snug">
      <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      Real-world Industry Projects
    </li>
    <li class="flex items-start gap-2 text-sm text-slate-300 leading-snug">
      <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      Certification Preparation
    </li>
  </ul>

  <!-- Action Row -->
  <div class="mt-auto flex items-center justify-between gap-3 pt-5 border-t border-white/10">
    <a href={`/${slug}`} class="text-sm font-semibold text-slate-300 hover:text-surface-0 transition-colors flex items-center gap-1 group/link">
      View Syllabus
      <svg class="w-4 h-4 transform group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
    <a href={`https://wa.me/918099949888?text=Hi Ask4Trainings, I want details for ${title}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Query" class="flex items-center justify-center w-9 h-9 rounded bg-whatsapp/10 hover:bg-whatsapp text-whatsapp hover:text-slate-900 border border-whatsapp/30 hover:border-whatsapp transition-all duration-300">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
  </div>
</article>
