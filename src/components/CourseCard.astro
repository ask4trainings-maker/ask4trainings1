---
export interface Props {
  title: string;
  category: string;
  duration: string;
  mode: string;
  slug: string;
}
const { title, category, duration, mode, slug: rawSlug } = Astro.props;

// Ensure slug has no .md extension and strictly ends with '/'
const slug = rawSlug.replace(/\.mdx?$/, '');
const courseHref = `/${slug}/`;
---
<article 
  class="course-card group bg-white border border-slate-200/90 rounded-2xl p-6 transition-all duration-200 hover:border-emerald-500/80 hover:shadow-lg hover:shadow-emerald-500/5 hover:-translate-y-1 flex flex-col h-full relative overflow-hidden"
  data-category={category}
>
  <!-- Ambient Hover Glow -->
  <div class="absolute -inset-1 bg-gradient-to-br from-primary/10 to-accent/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 blur-xl -z-10 pointer-events-none"></div>
  
  <!-- Header: Category & Batch Info -->
  <div class="mb-5 flex flex-wrap items-center justify-between gap-2">
    <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-2.5 py-0.5 rounded-full uppercase tracking-normal">
      {category.replace('-', ' ')}
    </span>
    <span class="text-xs font-medium text-slate-700 bg-slate-100 px-2.5 py-0.5 rounded-full flex items-center gap-1.5 uppercase tracking-normal">
      <span class="w-1.5 h-1.5 rounded-full bg-slate-400 animate-pulse-slow"></span>
      Weekend Batch
    </span>
  </div>

  <!-- Title -->
  <h3 class="text-base lg:text-lg font-bold text-slate-900 mb-4 leading-snug group-hover:text-emerald-600 transition-colors line-clamp-2">
    <a href={courseHref} class="focus:outline-none focus-visible:underline">
      {title}
    </a>
  </h3>

  <!-- Specs (Monospace) -->
  <div class="flex items-center gap-3 mb-6 text-xs font-medium text-slate-500 tabular-nums">
    <span class="flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      {duration}
    </span>
    <span class="text-white/20">•</span>
    <span class="flex items-center gap-1.5 text-slate-600">
      <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
      {mode}
    </span>
  </div>

  <!-- Key Modules (Checklist) -->
  <ul class="space-y-2.5 mb-8 flex-grow">
    <li class="flex items-start gap-2 text-sm text-slate-600 leading-snug">
      <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      Hands-on Architecture Labs
    </li>
    <li class="flex items-start gap-2 text-sm text-slate-600 leading-snug">
      <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      Real-world Industry Projects
    </li>
    <li class="flex items-start gap-2 text-sm text-slate-600 leading-snug">
      <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      Certification Preparation
    </li>
  </ul>

  <!-- Action Row -->
  <div class="mt-auto pt-5 border-t border-slate-200">
    <a href={courseHref} class="w-full py-2.5 px-4 rounded-xl text-sm font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-600 hover:text-white transition-all flex items-center justify-center gap-2 group/link border border-emerald-200 hover:border-emerald-600 shadow-sm">
      Explore Syllabus
      <svg class="w-4 h-4 transform group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>
</article>
