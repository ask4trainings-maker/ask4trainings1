---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from './CourseCard.astro';
import SchemaOrg from './seo/SchemaOrg.astro';
import { getBreadcrumbSchema } from '../utils/seoSchema';
import categoriesData from '../content/categories.json';
import categoriesMeta from '../data/categories.json';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  categoryKey: string;
  categorySlug: string;
  courses: CollectionEntry<'courses'>[];
}

const { categoryKey, categorySlug, courses } = Astro.props;

// Lookup category content
const catContent = (categoriesData as any)[categoryKey] || {};
const catMeta = (categoriesMeta.categories as any[]).find(c => c.id === categoryKey) || {};

const categoryLabel = catContent.label || catMeta.title || categoryKey;
const categoryIntro = catContent.intro || catMeta.description || `Explore comprehensive enterprise ${categoryLabel} courses with live interactive sessions and real-world projects.`;
const careerOpportunities = catContent.careerOpportunities || '';

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://ask4trainings.com';
const pageUrl = `${siteUrl}/${categorySlug}/`;

const metaTitle = `${categoryLabel} Courses & Online Training | Ask4Trainings`;
const metaDescription = `Master ${categoryLabel} with industry-leading training programs at Ask4Trainings. Real-time projects, certified mentors, live interactive labs & placement support.`;

// Clean title helper
function cleanTitle(title: string): string {
  return title
    .replace(/^(Best\s+|Course\s+Tag\s*[-–]?\s*|Courses\s*)/i, '')
    .replace(/\s{2,}/g, ' ')
    .trim();
}

// Schema: CollectionPage + ItemList + Breadcrumbs
const breadcrumbs = [
  { name: 'Home', path: `${siteUrl}/` },
  { name: 'Categories', path: `${siteUrl}/courses/` },
  { name: categoryLabel, path: pageUrl }
];

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': `${categoryLabel} Online Training & Certification Courses`,
  'description': metaDescription,
  'url': pageUrl,
  'publisher': {
    '@type': 'EducationalOrganization',
    'name': 'Ask4Trainings',
    'url': siteUrl,
    'logo': `${siteUrl}/logo.svg`
  },
  'mainEntity': {
    '@type': 'ItemList',
    'name': `${categoryLabel} Courses Curriculum Catalog`,
    'numberOfItems': courses.length,
    'itemListElement': courses.map((c, index) => ({
      '@type': 'ListItem',
      'position': index + 1,
      'name': c.data.title,
      'url': `${siteUrl}/${c.data.slug}/`,
      'description': c.data.metaDescription || c.data.overview || c.data.title
    }))
  }
};

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [collectionPageSchema, breadcrumbSchema]
};

// WhatsApp Advisor Link
const whatsappMsg = `Hi Ask4Trainings, I am looking for details and curriculum about ${categoryLabel} courses. Could you please connect me with a course advisor?`;
const whatsappUrl = `https://wa.me/918099949888?text=${encodeURIComponent(whatsappMsg)}`;

// Sibling tracks for cross-linking
const allTracks = [
  { slug: 'guidewire-courses', label: 'Guidewire', key: 'guidewire' },
  { slug: 'siemens-courses', label: 'Siemens', key: 'siemens' },
  { slug: 'cloud-computing', label: 'Cloud Computing', key: 'cloud-computing' },
  { slug: 'devops-courses', label: 'DevOps', key: 'devops' },
  { slug: 'oracle-courses', label: 'Oracle', key: 'oracle' },
  { slug: 'sap-courses', label: 'SAP', key: 'sap' },
  { slug: 'microsoft-dynamics-365-courses', label: 'MS D365', key: 'ms-d365' },
  { slug: 'development-courses', label: 'Development', key: 'development' },
  { slug: 'trending-courses', label: 'Trending', key: 'trending-courses' },
  { slug: 'new-courses', label: 'New Courses', key: 'new-courses' },
  { slug: 'other-tools-courses', label: 'Other Tools', key: 'other-tools' },
].filter(t => t.key !== categoryKey);
---

<BaseLayout 
  title={metaTitle}
  description={metaDescription}
>
  <Fragment slot="head">
    <SchemaOrg schema={schemaGraph} />
  </Fragment>

  <!-- Hero Section -->
  <section class="relative bg-slate-900 text-white py-16 md:py-20 overflow-hidden">
    <!-- Ambient Background Lighting -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-emerald-500/15 rounded-full blur-[140px]"></div>
      <div class="absolute bottom-0 right-10 w-96 h-96 bg-emerald-600/10 rounded-full blur-[100px]"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center justify-center sm:justify-start gap-2 text-xs md:text-sm text-slate-400 font-medium">
        <a href="/" class="hover:text-emerald-400 transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          <span>Home</span>
        </a>
        <span class="text-slate-600">/</span>
        <a href="/courses/" class="hover:text-emerald-400 transition-colors">Categories</a>
        <span class="text-slate-600">/</span>
        <span class="text-emerald-400 font-semibold">{categoryLabel}</span>
      </nav>

      <!-- Track Hub Pill & Headline -->
      <div class="max-w-3xl text-center sm:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 text-xs font-semibold uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Enterprise Track Hub
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white tracking-tight leading-tight mb-4">
          {categoryLabel} Training & Certification
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed whitespace-pre-line mb-8">
          {categoryIntro}
        </p>

        <!-- Metric Badges -->
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 sm:gap-4 text-xs sm:text-sm font-medium">
          <div class="flex items-center gap-2 bg-slate-800/80 border border-slate-700/80 px-3.5 py-1.5 rounded-xl text-slate-200">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            <span>{courses.length} Certified Courses</span>
          </div>
          <div class="flex items-center gap-2 bg-slate-800/80 border border-slate-700/80 px-3.5 py-1.5 rounded-xl text-slate-200">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            <span>Live Interactive Sessions</span>
          </div>
          <div class="flex items-center gap-2 bg-slate-800/80 border border-slate-700/80 px-3.5 py-1.5 rounded-xl text-slate-200">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>100% Placement Assistance</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Courses Grid Section -->
  <section class="py-12 md:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-4">
      <div>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 tracking-tight">
          Explore {categoryLabel} Specializations
        </h2>
        <p class="text-slate-600 text-sm mt-1">
          Showing all {courses.length} verified curriculum tracks led by certified industry mentors.
        </p>
      </div>
      <a href="/courses/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-600 hover:text-emerald-700 transition-colors">
        View All Categories
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    {courses.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {courses.map(course => (
          <CourseCard
            title={cleanTitle(course.data.title)}
            category={course.data.category}
            duration={course.data.duration}
            mode={course.data.mode}
            slug={course.data.slug}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-12 bg-white rounded-2xl border border-slate-200 p-8">
        <p class="text-slate-600 mb-4">New {categoryLabel} batches are currently being scheduled.</p>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 text-white font-semibold text-sm hover:bg-emerald-700 transition-colors shadow-sm">
          Inquire About Upcoming Batches
        </a>
      </div>
    )}
  </section>

  <!-- Career Opportunities & Value Section -->
  {careerOpportunities && (
    <section class="py-12 bg-slate-100/70 border-y border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100/80 px-2.5 py-1 rounded-md">
              Industry Demand
            </span>
            <h2 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 mt-3 mb-4">
              Career Scope & Opportunities in {categoryLabel}
            </h2>
            <p class="text-slate-700 text-base leading-relaxed mb-6">
              {careerOpportunities}
            </p>
            <ul class="space-y-3">
              <li class="flex items-start gap-2.5 text-slate-700 text-sm">
                <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Direct exposure to live enterprise implementation scenarios and architecture patterns.</span>
              </li>
              <li class="flex items-start gap-2.5 text-slate-700 text-sm">
                <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>1-on-1 interview preparation, resume optimization, and mock technical screenings.</span>
              </li>
              <li class="flex items-start gap-2.5 text-slate-700 text-sm">
                <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Guidance toward recognized global certification exams.</span>
              </li>
            </ul>
          </div>

          <!-- Quick Value Bento Card -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm">
            <h3 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              Why Train With Ask4Trainings?
            </h3>
            <div class="space-y-4 text-sm text-slate-600">
              <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-100">
                <strong class="text-slate-900 block font-semibold mb-1">Corporate Mentorship</strong>
                Learn from practicing enterprise architects with 12+ years of production experience.
              </div>
              <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-100">
                <strong class="text-slate-900 block font-semibold mb-1">Flexible Batch Timings</strong>
                Weekend and weekday evening cohorts structured for working software engineers.
              </div>
              <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-100">
                <strong class="text-slate-900 block font-semibold mb-1">Post-Training Assistance</strong>
                Lifetime access to class recordings, community forums, and project source repositories.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Advisory / Guidance Callout Section -->
  <section class="py-14 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white p-8 sm:p-12 overflow-hidden shadow-xl border border-slate-700/60">
      <!-- Glow decoration -->
      <div class="absolute -top-12 -right-12 w-64 h-64 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/80 border border-emerald-800/80 px-3 py-1 rounded-full inline-block mb-3">
          Free Consultation
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-extrabold text-white tracking-tight mb-3">
          Need Guidance? Connect with our Lead Course Advisor
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
          Unsure which {categoryLabel} specialization fits your current career level? Speak directly with certified enterprise instructors to evaluate your profile, review sample curriculum, and book a free live demo session.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a 
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm transition-all shadow-lg hover:shadow-emerald-500/20 hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Chat on WhatsApp
          </a>

          <a 
            href="tel:+918099949888" 
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-sm transition-all border border-slate-600 hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call Admissions: +91 80999 49888
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Cross-Category Exploration Strip -->
  <section class="py-10 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <h3 class="text-base font-bold text-slate-900">
          Explore Other Enterprise Tracks
        </h3>
        <a href="/courses/" class="text-xs font-semibold text-emerald-600 hover:text-emerald-700">
          Browse All 11 Domains &rarr;
        </a>
      </div>

      <div class="flex flex-wrap gap-2.5">
        {allTracks.map(track => (
          <a
            href={`/${track.slug}/`}
            class="px-3.5 py-1.5 rounded-xl bg-white hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 border border-slate-200 hover:border-emerald-300 text-xs font-medium transition-all shadow-xs"
          >
            {track.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
