---
export interface Props {
  courseName?: string;
  sourcePage?: string;
  lockCourseName?: boolean;
  title?: string;
  subtitle?: string;
  showTrustBadges?: boolean;
}

const { 
  courseName = '', 
  sourcePage = '', 
  lockCourseName = false,
  title = "Get Free Counselling",
  subtitle = "Tell us your query and we'll call you back within 2 hours.",
  showTrustBadges = false
} = Astro.props;

const formId = `enquiry-form-${Math.random().toString(36).substring(2, 9)}`;
---
<div class="relative w-full h-full group/form">
  <!-- Ambient Backlight / Glow Effect -->
  <div class="absolute -inset-1 bg-gradient-to-r from-emerald-500/15 to-teal-500/15 rounded-3xl blur-xl -z-10"></div>
  
  <div class="enquiry-form-container relative w-full h-full bg-white border border-slate-200/90 rounded-2xl shadow-2xl shadow-slate-900/10 dark:shadow-black/40 ring-1 ring-white/50 overflow-hidden flex flex-col">
    
    <!-- Top Accent -->
    <div class="h-1.5 w-full shrink-0 bg-gradient-to-r from-emerald-500 via-teal-500 to-emerald-600"></div>
    
    <!-- Optimistic Success UI -->
    <div id={`${formId}-success`} class="absolute inset-0 z-20 flex-col items-center justify-center bg-white/95 backdrop-blur-md rounded-2xl p-4 sm:p-6 text-center transition-all duration-300 opacity-0 pointer-events-none flex">
      <div class="w-12 sm:w-16 h-12 sm:h-16 bg-emerald-600/10 rounded-full flex items-center justify-center mb-4 border border-emerald-600/30">
        <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
      </div>
      <div class="rounded-xl border border-emerald-600/20 bg-emerald-600/5 p-3 sm:p-4 text-center text-xs sm:text-sm font-medium text-slate-900 mb-6 w-full max-w-[280px]">
        Thank you! Your enquiry has been received. Our team will contact you shortly.
      </div>
      <button type="button" class="reset-form-btn px-5 py-2.5 bg-white/5 hover:bg-white/10 text-slate-600 text-sm font-semibold rounded-lg transition-colors border border-slate-200">
        Submit another enquiry
      </button>
    </div>

    <!-- Inner Padding Wrapper -->
    <div class="p-5 sm:p-6 lg:p-8 flex-grow flex flex-col">
      <div class="mb-6 mt-1">
        <div class="flex items-center justify-between gap-2 mb-2">
          <h3 class="text-xl sm:text-2xl font-bold font-heading tracking-tight text-slate-900">{title}</h3>
          <span class="bg-emerald-50 text-emerald-700 border border-emerald-200/80 text-[11px] font-semibold px-2.5 py-0.5 rounded-full inline-flex items-center gap-1.5 shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Fast Filling
          </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-500">{subtitle}</p>
      </div>

      <form id={formId} class="enquiry-form flex flex-col space-y-4" data-source={sourcePage}>
        <!-- Honeypot -->
        <input type="text" name="b_field" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        
        <div>
          <label for={`${formId}-name`} class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">
            Full Name <span class="text-error">*</span>
          </label>
          <input
            id={`${formId}-name`}
            name="name"
            type="text"
            placeholder="e.g. Rahul Sharma"
            required
            class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm font-medium text-slate-900 transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-600 placeholder:text-slate-400"
          />
        </div>

        <div>
          <label for={`${formId}-phone`} class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">
            Phone Number <span class="text-error">*</span>
          </label>
          <div class="flex gap-2 w-full">
            <select
              name="countryCode"
              class="w-[30%] max-w-[96px] shrink-0 truncate rounded-lg border border-slate-300 bg-white px-2 sm:px-3 py-3 text-xs sm:text-sm font-medium text-slate-900 transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-600 appearance-none"
            >
              <option value="+91">+91 (IN)</option>
              <option value="+1">+1 (US)</option>
              <option value="+44">+44 (UK)</option>
              <option value="+61">+61 (AU)</option>
              <option value="+971">+971 (AE)</option>
            </select>
            <input
              id={`${formId}-phone`}
              name="phone"
              type="tel"
              pattern="^[6-9]\\d{9}$"
              placeholder="10-digit mobile number"
              required
              title="Please enter a valid 10-digit Indian mobile number starting with 6-9."
              class="flex-1 min-w-0 rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm font-medium text-slate-900 transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-600 placeholder:text-slate-400"
            />
          </div>
        </div>

        <div>
          <label for={`${formId}-email`} class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">
            Email Address <span class="text-error">*</span>
          </label>
          <input
            id={`${formId}-email`}
            name="email"
            type="email"
            required
            placeholder="you@email.com"
            class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm font-medium text-slate-900 transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-600 placeholder:text-slate-400"
          />
        </div>

        <div>
          <label for={`${formId}-course`} class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">
            Course of Interest
          </label>
          <input
            id={`${formId}-course`}
            name="course"
            type="text"
            placeholder="e.g. AWS Cloud Architect"
            value={courseName}
            readonly={lockCourseName ? true : undefined}
            class={`w-full rounded-lg border px-4 py-3 text-sm font-medium transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-600 placeholder:text-slate-400 ${
              lockCourseName 
                ? 'cursor-not-allowed bg-slate-50 border-slate-200 text-slate-500' 
                : 'bg-white border-slate-300 text-slate-900'
            }`}
          />
        </div>

        <button
          type="submit"
          class="submit-btn mt-2 w-full rounded-xl bg-emerald-600 hover:bg-emerald-700 px-4 py-3.5 text-center text-base font-semibold text-white shadow-md shadow-emerald-600/20 active:scale-[0.99] transition-all flex items-center justify-center gap-2 disabled:opacity-70 disabled:cursor-not-allowed border border-emerald-200/20 group/btn"
        >
          <span class="submit-text">Register Now</span>
          <svg class="submit-icon w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
          <svg class="loading-spinner hidden animate-spin w-5 h-5 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
        </button>
      </form>
    </div>

    {showTrustBadges && (
      <div class="border-t border-slate-100 bg-slate-50/70 p-4 rounded-b-2xl flex items-center justify-between text-slate-600 text-xs font-medium mt-auto w-full">
        <div class="flex flex-col items-center gap-1.5 flex-1">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span class="whitespace-nowrap text-[11px] sm:text-xs">Placement Support</span>
        </div>
        <div class="w-px h-6 bg-slate-200"></div>
        <div class="flex flex-col items-center gap-1.5 flex-1">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span class="whitespace-nowrap text-[11px] sm:text-xs">Live Projects</span>
        </div>
        <div class="w-px h-6 bg-slate-200"></div>
        <div class="flex flex-col items-center gap-1.5 flex-1">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
          </svg>
          <span class="whitespace-nowrap text-[11px] sm:text-xs">Certified</span>
        </div>
      </div>
    )}
  </div>
</div>

<script>
  const forms = document.querySelectorAll('.enquiry-form');
  const APPS_SCRIPT_URL = import.meta.env.PUBLIC_STUDENT_APPS_SCRIPT_URL || import.meta.env.PUBLIC_APPS_SCRIPT_URL;

  forms.forEach(form => {
    const formId = form.id;
    const successUI = document.getElementById(`${formId}-success`);
    const resetBtn = successUI?.querySelector('.reset-form-btn');
    const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement;
    const submitText = form.querySelector('.submit-text');
    const loadingSpinner = form.querySelector('.loading-spinner');

    const resetForm = () => {
      if (successUI) {
        successUI.classList.add('opacity-0', 'pointer-events-none');
      }
      (form as HTMLFormElement).reset();
    };

    resetBtn?.addEventListener('click', resetForm);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form as HTMLFormElement);
      const data = Object.fromEntries(formData.entries());
      
      // Honeypot check
      if (data.b_field) {
        resetForm();
        return;
      }

      // Lock state
      if (submitBtn) submitBtn.disabled = true;
      if (submitText) submitText.textContent = 'Submitting...';
      if (loadingSpinner) loadingSpinner.classList.remove('hidden');
      form.querySelector('.submit-icon')?.classList.add('hidden');

      const fullPhoneNumber = `${data.countryCode} ${data.phone}`;
      
      const payload = {
        type: 'student',
        date: new Date().toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' }),
        time: new Date().toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata' }),
        name: data.name,
        phone: fullPhoneNumber,
        email: data.email,
        course: data.course || 'General Enquiry',
        sourceUrl: form.getAttribute('data-source') || window.location.href
      };

      try {
        if (!APPS_SCRIPT_URL) {
          console.info("Dev Mode: Apps Script URL not defined. Simulated submission payload:", payload);
          await new Promise(r => setTimeout(r, 800));
        } else {
          await fetch(APPS_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'text/plain' },
            body: JSON.stringify(payload)
          });
        }
        
        // Optimistic UI Success
        if (successUI) {
          successUI.classList.remove('opacity-0', 'pointer-events-none');
        }
      } catch (err) {
        console.error('Submission failed', err);
        alert('There was a problem submitting your enquiry. Please try again or contact us via WhatsApp.');
      } finally {
        // Unlock state
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.textContent = 'Register Now';
        if (loadingSpinner) loadingSpinner.classList.add('hidden');
        form.querySelector('.submit-icon')?.classList.remove('hidden');
      }
    });
  });
</script>
