---
import IconFacebook from './icons/IconFacebook.astro';
import IconX from './icons/IconX.astro';
import IconLinkedIn from './icons/IconLinkedIn.astro';
import IconYouTube from './icons/IconYouTube.astro';
import IconInstagram from './icons/IconInstagram.astro';
import settingsData from '../data/settings.json';
import navigationData from '../data/navigation.json';
---
<footer class="bg-ink-900 text-surface-50 py-12">
  <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-8">
    <div>
      <h3 class="text-xl font-heading font-bold text-primary-light mb-4">Ask 4 Trainings</h3>
      <p class="text-ink-500 text-sm leading-relaxed mb-4">
        Leading IT training institute providing real-time, project-based training on enterprise technologies.
      </p>
      <p class="text-sm text-ink-500 mb-6">{settingsData.contact.address}</p>
      <div class="flex items-center gap-4">
        {settingsData.socials.facebook && (
          <a href={settingsData.socials.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-slate-500 hover:text-white transition-colors">
            <IconFacebook class="w-5 h-5"/>
          </a>
        )}
        {settingsData.socials.twitter && (
          <a href={settingsData.socials.twitter} target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="text-slate-500 hover:text-white transition-colors">
            <IconX class="w-5 h-5"/>
          </a>
        )}
        {settingsData.socials.linkedin && (
          <a href={settingsData.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-slate-500 hover:text-white transition-colors">
            <IconLinkedIn class="w-5 h-5"/>
          </a>
        )}
        {settingsData.socials.youtube && (
          <a href={settingsData.socials.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-slate-500 hover:text-white transition-colors">
            <IconYouTube class="w-5 h-5"/>
          </a>
        )}
        {settingsData.socials.instagram && (
          <a href={settingsData.socials.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-slate-500 hover:text-white transition-colors">
            <IconInstagram class="w-5 h-5"/>
          </a>
        )}
      </div>
    </div>
    <div>
      <h4 class="font-heading font-semibold mb-4 text-slate-900">Quick Links</h4>
      <ul class="space-y-2 text-sm text-ink-500">
        {navigationData.footerLinks.map((link: any) => (
          <li><a href={link.href} class="hover:text-primary-light transition-colors">{link.title}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4 class="font-heading font-semibold mb-4 text-slate-900">Popular Categories</h4>
      <ul class="space-y-2 text-sm text-ink-500">
        <li><a href="/courses/guidewire" class="hover:text-primary-light transition-colors">Guidewire</a></li>
        <li><a href="/courses/sap" class="hover:text-primary-light transition-colors">SAP</a></li>
        <li><a href="/courses/oracle" class="hover:text-primary-light transition-colors">Oracle</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-heading font-semibold mb-4 text-slate-900">Contact</h4>
      <ul class="space-y-2 text-sm text-ink-500">
        <li>{settingsData.contact.phone1}</li>
        <li>{settingsData.contact.email}</li>
      </ul>
    </div>
  </div>
  <div class="container mx-auto px-4 mt-8 pt-8 border-t border-ink-700 text-center text-sm text-ink-500">
    &copy; {new Date().getFullYear()} Ask 4 Trainings. All rights reserved.
  </div>
</footer>
