---
import IconFacebook from './icons/IconFacebook.astro';
import IconX from './icons/IconX.astro';
import IconLinkedIn from './icons/IconLinkedIn.astro';
import IconYouTube from './icons/IconYouTube.astro';
import IconInstagram from './icons/IconInstagram.astro';
import settingsData from '../data/settings.json';
import navigationData from '../data/navigation.json';
import categoriesData from '../data/categories.json';

const currentYear = new Date().getFullYear();
const categories = categoriesData?.categories ?? [];
const topCategories = categories.slice(0, 5);
---
<footer class="bg-slate-950 text-slate-300 py-16 border-t border-slate-900" data-pagefind-ignore>
  <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
    
    <!-- Column 1: Brand & Office -->
    <div class="space-y-6">
      <h3 class="text-2xl font-heading font-bold text-emerald-500 tracking-tight">Ask 4 Trainings</h3>
      <p class="text-slate-400 text-sm leading-relaxed">
        An elite IT training ecosystem delivering real-time, project-driven mastery across enterprise technologies.
      </p>
      <div class="pt-4 space-y-3">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <p class="text-[13px] text-slate-400 tabular-nums leading-relaxed whitespace-pre-line">{settingsData?.contact?.address ?? 'Location Data Unavailable'}</p>
        </div>
      </div>
    </div>

    <!-- Column 2: Trending Tech -->
    <div>
      <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300 mb-4">Trending Tech</h4>
      <ul class="space-y-3">
        {topCategories.map((cat: any) => (
          <li>
            <a href={`/courses?category=${cat.id}`} class="text-[13px] text-slate-400 tabular-nums leading-relaxed hover:text-emerald-400 hover:translate-x-1 transition-all inline-block">
              {cat.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 3: Quick Links & Policies -->
    <div>
      <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300 mb-4">Company Policies</h4>
      <ul class="space-y-3">
        {navigationData?.footerLinks?.map((link: any) => (
          <li>
            <a href={link.href} class="text-[13px] text-slate-400 tabular-nums leading-relaxed hover:text-emerald-400 hover:translate-x-1 transition-all inline-block">
              {link.title}
            </a>
          </li>
        ))}
        <li><a href="/privacy-policy" class="text-[13px] text-slate-400 tabular-nums leading-relaxed hover:text-emerald-400 hover:translate-x-1 transition-all inline-block">Privacy Policy</a></li>
        <li><a href="/terms-of-service" class="text-[13px] text-slate-400 tabular-nums leading-relaxed hover:text-emerald-400 hover:translate-x-1 transition-all inline-block">Terms of Service</a></li>
      </ul>
    </div>

    <!-- Column 4: Contact & Socials -->
    <div>
      <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300 mb-4">Get in Touch</h4>
      <ul class="space-y-3 mb-8">
        <li>
          <a href={`tel:${settingsData?.contact?.phone1 ?? ''}`} class="flex items-center gap-3 text-[13px] text-slate-400 tabular-nums leading-relaxed hover:text-emerald-400 transition-colors">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {settingsData?.contact?.phone1 ?? '+91 000 000 0000'}
          </a>
        </li>
        {settingsData?.contact?.phone2 && (
          <li>
            <a href={`tel:${settingsData.contact.phone2}`} class="flex items-center gap-3 text-[13px] text-slate-400 tabular-nums leading-relaxed hover:text-emerald-400 transition-colors">
              <span class="w-4 h-4"></span>
              {settingsData.contact.phone2}
            </a>
          </li>
        )}
        <li>
          <a href={`mailto:${settingsData?.contact?.email ?? ''}`} class="flex items-center gap-3 text-[13px] text-slate-400 tabular-nums leading-relaxed hover:text-emerald-400 transition-colors">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {settingsData?.contact?.email ?? 'contact@ask4trainings.com'}
          </a>
        </li>
      </ul>
      
      <div class="flex items-center gap-4">
        {settingsData?.socials?.facebook && (
          <a href={settingsData.socials.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-10 h-10 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-emerald-600 hover:border-emerald-500 transition-all">
            <IconFacebook class="w-4 h-4"/>
          </a>
        )}
        {settingsData?.socials?.twitter && (
          <a href={settingsData.socials.twitter} target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="w-10 h-10 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-emerald-600 hover:border-emerald-500 transition-all">
            <IconX class="w-4 h-4"/>
          </a>
        )}
        {settingsData?.socials?.linkedin && (
          <a href={settingsData.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-10 h-10 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-emerald-600 hover:border-emerald-500 transition-all">
            <IconLinkedIn class="w-4 h-4"/>
          </a>
        )}
        {settingsData?.socials?.youtube && (
          <a href={settingsData.socials.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="w-10 h-10 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-emerald-600 hover:border-emerald-500 transition-all">
            <IconYouTube class="w-4 h-4"/>
          </a>
        )}
        {settingsData?.socials?.instagram && (
          <a href={settingsData.socials.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-10 h-10 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-emerald-600 hover:border-emerald-500 transition-all">
            <IconInstagram class="w-4 h-4"/>
          </a>
        )}
      </div>
    </div>
  </div>
  
  <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full mt-16 pt-8 border-t border-slate-800 flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="text-sm text-slate-500">
      &copy; {currentYear} Ask 4 Trainings. All rights reserved.
    </div>
    <div class="text-sm text-slate-500 flex items-center gap-4">
      <a href="/privacy-policy" class="hover:text-emerald-400 transition-colors">Privacy</a>
      <span class="w-1 h-1 rounded-full bg-slate-700"></span>
      <a href="/terms-of-service" class="hover:text-emerald-400 transition-colors">Terms</a>
    </div>
  </div>
</footer>
