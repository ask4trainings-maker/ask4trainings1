---
import IconFacebook from './icons/IconFacebook.astro';
import IconX from './icons/IconX.astro';
import IconLinkedIn from './icons/IconLinkedIn.astro';
import IconYouTube from './icons/IconYouTube.astro';
import IconInstagram from './icons/IconInstagram.astro';
import { getEntry } from 'astro:content';

const footerEntry = await getEntry('settings', 'footer');
const fd = footerEntry?.data || {};
const companySummary = fd.companySummary || 'Empowering IT professionals and graduates since 2012 with enterprise-grade cloud curriculum, real-time project mentorship, and global certification pathways.';
const address = fd.contactInfo?.address || 'Plot No 32/27, Door No:402, Deeksha Hospital Building, Nizampet \'X\' Road, Sardar Patel Nagar, Hyderabad, Telangana - 500072';
const phone = fd.contactInfo?.phone || '+91 80999 49888';
const email = fd.contactInfo?.email || 'ask4trainings@gmail.com';
const popularCourses = fd.popularCourses || [];
const termsPoliciesLinks = fd.termsPoliciesLinks || [];
const socialLinks = fd.socialLinks || [];
const copyrightText = fd.copyright || '© 2026 Ask4Trainings. All rights reserved.';

const currentYear = new Date().getFullYear();

// Determine Icon component based on platform name
const getIcon = (platform: string) => {
  const normalized = platform.toLowerCase();
  if (normalized.includes('facebook')) return IconFacebook;
  if (normalized.includes('twitter') || normalized.includes('x')) return IconX;
  if (normalized.includes('linkedin')) return IconLinkedIn;
  if (normalized.includes('youtube')) return IconYouTube;
  if (normalized.includes('instagram')) return IconInstagram;
  return null;
};
---
<footer class="bg-slate-950 text-slate-300 py-16" data-pagefind-ignore>
  <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12">
    
    <!-- Column 1: Brand & Office -->
    <div class="lg:col-span-4 space-y-4">
      <img src="/logo.svg" alt="Ask 4 Trainings" width="120" height="30" class="h-15 w-auto bg-white/98 px-2 py-1.5 rounded-3xl" decoding="async" loading="lazy" />
      <p class="text-slate-400 text-sm leading-relaxed mt-4">
        {companySummary}
      </p>
      <div class="pt-4 space-y-3">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <p class="text-[13px] text-slate-400 tabular-nums leading-relaxed whitespace-pre-line">{address}</p>
        </div>
      </div>
    </div>

    <!-- Column 2: Popular Courses -->
    <div class="lg:col-span-3">
      <h4 class="text-xs font-bold tracking-wider text-slate-200 uppercase mb-4">POPULAR COURSES</h4>
      <ul class="space-y-1">
        {popularCourses.map((link: any) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-slate-400 hover:text-emerald-400 transition-colors py-1 block line-clamp-1"
            >
              {link.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 3: Terms & Policies -->
    <div class="lg:col-span-2">
      <h4 class="text-xs font-bold tracking-wider text-slate-200 uppercase mb-4">TERMS & POLICIES</h4>
      <ul class="space-y-1">
        {termsPoliciesLinks.map((link: any) => (
          <li>
            <a href={link.href} class="text-sm text-slate-400 hover:text-emerald-400 transition-colors py-1 block">
              {link.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 4: Contact & Socials -->
    <div class="lg:col-span-3">
      <h4 class="text-xs font-bold tracking-wider text-slate-200 uppercase mb-4">CONTACT</h4>
      <ul class="space-y-3 mb-6">
        <li>
          <a href={`tel:${phone.replace(/\s+/g, '')}`} class="flex items-center gap-3 text-[13px] text-slate-400 tabular-nums leading-relaxed hover:text-emerald-400 transition-colors">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {phone}
          </a>
        </li>

        <li>
          <a href={`mailto:${email}`} class="flex items-center gap-3 text-[13px] text-slate-400 tabular-nums leading-relaxed hover:text-emerald-400 transition-colors">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {email}
          </a>
        </li>
      </ul>
      
      <div class="flex items-center gap-3">
        {socialLinks.filter((s: any) => s.active).map((social: any) => {
          const Icon = getIcon(social.platform);
          return Icon ? (
            <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.platform} class="h-9 w-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-emerald-400 hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-all">
              <Icon class="w-4 h-4"/>
            </a>
          ) : null;
        })}
      </div>
    </div>
  </div>
  
  <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full mt-12 pt-6 border-t border-slate-900 flex justify-center">
    <div class="text-xs text-slate-500">
      {copyrightText.replace('2026', currentYear.toString())}
    </div>
  </div>
</footer>
