---
export interface Props {
  trainerProfile?: {
    heading: string;
    description: string;
    highlights: (string | Record<string, any>)[];
  };
}

const { trainerProfile } = Astro.props;

if (!trainerProfile || !trainerProfile.heading) {
  return null;
}
---
<section id="trainer-profile" class="py-16 bg-white border-b border-slate-100 scroll-mt-24">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Image / Graphic -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-sm aspect-square bg-slate-50 rounded-full border border-slate-200 flex items-center justify-center overflow-hidden">
          <div class="absolute inset-0 bg-emerald-600/5 rounded-full border-[10px] border-white"></div>
          <svg class="w-32 h-32 text-slate-300" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
        </div>
      </div>
      
      <!-- Content -->
      <div class="lg:col-span-7">
        <div class="inline-block px-3 py-1 bg-emerald-50 text-emerald-700 text-sm font-semibold rounded-full mb-4">
          Trainer Excellence
        </div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-6 leading-tight">
          {trainerProfile.heading}
        </h2>
        <p class="text-lg text-slate-600 mb-8 leading-relaxed">
          {trainerProfile.description}
        </p>
        
        {trainerProfile.highlights && trainerProfile.highlights.length > 0 && (
          <ul class="space-y-4">
            {trainerProfile.highlights.map(highlight => (
              <li class="flex items-start gap-4">
                <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-slate-700 text-lg">{typeof highlight === 'string' ? highlight : (highlight.text || highlight.title || highlight.highlight || JSON.stringify(highlight))}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</section>
