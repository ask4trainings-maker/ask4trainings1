---
import TrainerIllustration from '../TrainerIllustration.astro';
export interface Props {
  courseTitle?: string;
  trainerProfile?: {
    heading?: string;
    title?: string;
    image?: string;
    description?: string;
    highlights?: (string | Record<string, any>)[];
  };
}

const { courseTitle = 'Course', trainerProfile } = Astro.props;

if (!trainerProfile) {
  return null;
}
---
<section id="trainer-profile" class="bg-emerald-50/40 py-16 border-y border-emerald-100 scroll-mt-28">
  <div class="max-w-7xl mx-auto px-4">
    
    <!-- Section Header -->
    <div class="mb-10 flex flex-col items-center sm:items-start text-center sm:text-left max-w-2xl mx-auto sm:mx-0">
      <h2 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-slate-900 mb-2">
        {courseTitle} Trainer
      </h2>
      <div class="h-1 w-16 bg-amber-400 mt-2 rounded-full mx-auto sm:mx-0"></div>
    </div>

    <!-- Responsive Two-Column Split Layout -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center mt-8 sm:mt-10">
      
      <!-- Left Column -->
      <div class="md:col-span-5 lg:col-span-4 flex justify-center items-center">
        {trainerProfile.image ? (
          <img 
            src={trainerProfile.image} 
            alt={`${courseTitle} Expert Trainer`}
            class="w-full h-auto max-w-[220px] sm:max-w-[280px] mx-auto drop-shadow-xl rounded-2xl object-cover border border-slate-200"
            loading="lazy"
          />
        ) : (
          <TrainerIllustration />
        )}
      </div>
      
      <!-- Right Column -->
      <div class="md:col-span-7 lg:col-span-8 bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
        <div class="inline-block px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-semibold rounded-full mb-4">
          Trainer Excellence
        </div>
        
        <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2">
          {trainerProfile.title || trainerProfile.heading || `Expert Led ${courseTitle} Trainer`}
        </h3>
        
        <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed mt-2">
          {trainerProfile.description || 'Practical training, mentoring, and enterprise architecture overview.'}
        </p>
        
        {trainerProfile.highlights && trainerProfile.highlights.length > 0 && (
          <div class="mt-6">
            <h4 class="text-sm sm:text-base font-bold text-slate-900 mt-4 mb-3">Highlights</h4>
            <ul class="space-y-1.5">
              {trainerProfile.highlights.map((highlight: any) => (
                <li class="flex items-start gap-2.5">
                  <div class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed">
                    {typeof highlight === 'string' ? highlight : (highlight.item || highlight.text || highlight.title || highlight.highlight || JSON.stringify(highlight))}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
