---
import WhatsAppCTA from '../WhatsAppCTA.astro';
import EnquiryForm from '../EnquiryForm.astro';

export interface Props {
  courseName: string;
  duration: string;
  format: string;
}

const { courseName, duration, format } = Astro.props;
---
<div class="sticky top-28 space-y-6">
  <!-- Batch Info Card -->
  <div class="bg-slate-800/60 backdrop-blur-md border border-white/10 rounded-2xl p-6 shadow-xl hover:border-primary/30 transition-colors">
    <h3 class="text-lg font-heading font-bold text-surface-0 mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      Batch Quick Facts
    </h3>
    <dl class="space-y-3 text-sm">
      <div class="flex justify-between items-center border-b border-white/5 pb-2">
        <dt class="text-slate-400 font-medium">Duration</dt>
        <dd class="text-surface-0 font-semibold">{duration}</dd>
      </div>
      <div class="flex justify-between items-center border-b border-white/5 pb-2">
        <dt class="text-slate-400 font-medium">Mode</dt>
        <dd class="text-surface-0 font-semibold">{format}</dd>
      </div>
      <div class="flex justify-between items-center border-b border-white/5 pb-2">
        <dt class="text-slate-400 font-medium">Next Batch</dt>
        <dd class="text-whatsapp font-semibold flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-whatsapp animate-pulse inline-block"></span>
          Flexible Start
        </dd>
      </div>
      <div class="flex justify-between items-center">
        <dt class="text-slate-400 font-medium">Schedule</dt>
        <dd class="text-surface-0 font-semibold text-right">Weekday & Weekend</dd>
      </div>
    </dl>
    
    <div class="mt-6 flex flex-col gap-3">
      <WhatsAppCTA courseName={courseName} className="w-full text-center px-4 py-3 justify-center text-sm font-semibold shadow-[0_0_15px_rgba(37,211,102,0.2)] hover:shadow-[0_0_25px_rgba(37,211,102,0.4)]" />
      <a href="#enquiry-form" class="w-full bg-white/5 border border-white/10 hover:bg-white/10 text-surface-0 font-medium px-4 py-2.5 rounded-lg text-center text-sm transition-colors flex justify-center items-center gap-2">
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Download Syllabus
      </a>
    </div>
  </div>

  <!-- Enquiry Form Container -->
  <div id="enquiry-form" class="scroll-mt-32">
    <EnquiryForm 
      title="Request a Callback" 
      subtitle="Fill out the form below and we will contact you shortly."
      courseName={courseName} 
    />
  </div>

  <!-- Trust Badges -->
  <div class="grid grid-cols-3 gap-2">
    {[
      { label: '100% Placement', icon: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
      { label: 'Live Projects', icon: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z' },
      { label: 'Certified', icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z' }
    ].map(b => (
      <div class="bg-slate-800/40 border border-white/10 rounded-xl p-3 text-center hover:border-primary/30 transition-colors">
        <svg class="w-5 h-5 text-primary mx-auto mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={b.icon}/>
        </svg>
        <p class="text-xs text-slate-300 font-medium leading-tight">{b.label}</p>
      </div>
    ))}
  </div>
</div>
