<svg preserveAspectRatio="xMidYMid meet" class="w-full h-full text-slate-300" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="cloud-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8B5CF6" />
      <stop offset="100%" stop-color="#6D28D9" />
    </linearGradient>
    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#8B5CF6" />
    </marker>
  </defs>
  
  <path d="M 200 60 L 200 340" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" opacity="0.3" />
  
  <g transform="translate(100, 40)">
    <rect x="0" y="0" width="200" height="40" rx="8" fill="#1E293B" stroke="url(#cloud-grad)" stroke-width="2"/>
    <text x="100" y="25" text-anchor="middle" fill="#F8FAFC" font-size="14" font-weight="600" font-family="sans-serif">Code Repo</text>
  </g>

  <g transform="translate(100, 110)">
    <rect x="0" y="0" width="200" height="40" rx="8" fill="#1E293B" stroke="url(#cloud-grad)" stroke-width="2"/>
    <text x="100" y="25" text-anchor="middle" fill="#F8FAFC" font-size="14" font-weight="600" font-family="sans-serif">Containerization</text>
  </g>

  <g transform="translate(100, 180)">
    <rect x="0" y="0" width="200" height="40" rx="8" fill="#1E293B" stroke="url(#cloud-grad)" stroke-width="2"/>
    <text x="100" y="25" text-anchor="middle" fill="#F8FAFC" font-size="14" font-weight="600" font-family="sans-serif">Orchestration</text>
  </g>

  <g transform="translate(100, 250)">
    <rect x="0" y="0" width="200" height="40" rx="8" fill="#1E293B" stroke="url(#cloud-grad)" stroke-width="2"/>
    <text x="100" y="25" text-anchor="middle" fill="#F8FAFC" font-size="14" font-weight="600" font-family="sans-serif">Cloud Deployment</text>
  </g>

  <g transform="translate(100, 320)">
    <rect x="0" y="0" width="200" height="40" rx="8" fill="#1E293B" stroke="url(#cloud-grad)" stroke-width="2"/>
    <text x="100" y="25" text-anchor="middle" fill="#F8FAFC" font-size="14" font-weight="600" font-family="sans-serif">Monitoring</text>
  </g>

  <path d="M 200 80 L 200 110" stroke="url(#cloud-grad)" stroke-width="2" marker-end="url(#arrow)" />
  <path d="M 200 150 L 200 180" stroke="url(#cloud-grad)" stroke-width="2" marker-end="url(#arrow)" />
  <path d="M 200 220 L 200 250" stroke="url(#cloud-grad)" stroke-width="2" marker-end="url(#arrow)" />
  <path d="M 200 290 L 200 320" stroke="url(#cloud-grad)" stroke-width="2" marker-end="url(#arrow)" />
</svg>
