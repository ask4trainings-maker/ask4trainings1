---
export interface Props {
  benefits?: any; // Accept both legacy object and new array
}

const { benefits } = Astro.props;

// Determine if it's the new array shape or legacy shape
const isArray = Array.isArray(benefits);
const hasBasic = !isArray && benefits?.basicKnowledge && benefits.basicKnowledge.length > 0;
const hasTech = !isArray && benefits?.techSkills && benefits.techSkills.length > 0;
const hasCareer = !isArray && benefits?.careerInterests && benefits.careerInterests.length > 0;

if ((!isArray || benefits.length === 0) && !hasBasic && !hasTech && !hasCareer) {
  return null;
}
---
<section id="benefits" class="py-16 bg-white scroll-mt-28">
  <div class="max-w-7xl mx-auto px-4">
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <h2 class="text-3xl font-heading font-bold text-slate-900 mb-4">Course Benefits</h2>
      <p class="text-slate-600">Everything you gain from this comprehensive learning path.</p>
    </div>
    
    {isArray ? (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-8">
        {benefits.map((benefit: any) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs hover:border-emerald-500/50 transition-all flex flex-col">
            <h3 class="text-lg font-bold text-slate-900 tracking-tight mb-3">
              {benefit.title}
            </h3>
            {benefit.description && (
              <div class="space-y-2 mb-4 text-xs sm:text-sm text-slate-600 leading-relaxed">
                {String(benefit.description).split('\n\n').map((para) => (
                  <p>{para.trim()}</p>
                ))}
              </div>
            )}
            {benefit.points && benefit.points.length > 0 && (
              <ul class="space-y-1.5 mt-auto pt-3 border-t border-slate-100 text-xs sm:text-sm text-slate-600">
                {benefit.points.map((pt: string) => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-500 font-bold">•</span>
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {hasBasic && (
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200">
            <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-4">Basic Knowledge</h3>
            <ul class="space-y-3">
              {benefits?.basicKnowledge?.map((item: any) => (
                <li class="flex items-start gap-3 text-slate-600 text-sm">
                  <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>{typeof item === 'string' ? item : (item.item || item.text || item.title || item.point || item.objective || JSON.stringify(item))}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        
        {hasTech && (
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200">
            <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-4">Technical Skills</h3>
            <ul class="space-y-3">
              {benefits?.techSkills?.map((item: any) => (
                <li class="flex items-start gap-3 text-slate-600 text-sm">
                  <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>{typeof item === 'string' ? item : (item.item || item.text || item.title || item.point || item.objective || JSON.stringify(item))}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        
        {hasCareer && (
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200">
            <div class="w-12 h-12 bg-orange-50 text-orange-600 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-4">Career Advancement</h3>
            <ul class="space-y-3">
              {benefits?.careerInterests?.map((item: any) => (
                <li class="flex items-start gap-3 text-slate-600 text-sm">
                  <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>{typeof item === 'string' ? item : (item.item || item.text || item.title || item.point || item.objective || JSON.stringify(item))}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </div>
</section>
