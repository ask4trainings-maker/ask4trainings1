---
export interface Props {
  eligibility?: (string | Record<string, any>)[];
}

const { eligibility = [] } = Astro.props;

if (!eligibility || eligibility.length === 0) {
  return null;
}

const normalizedItems = eligibility.map((item) => {
  if (typeof item === 'string') {
    try {
      const parsed = JSON.parse(item);
      return {
        title: parsed.title || parsed.question || parsed.role || 'Target Profile',
        description: parsed.description || parsed.answer || parsed.detail || item
      };
    } catch {
      return { title: 'Eligible Candidate', description: item };
    }
  }
  return {
    title: item.title || item.question || item.role || 'Target Profile',
    description: item.description || item.answer || item.detail || ''
  };
});
---
<section id="eligibility" class="bg-slate-50/60 py-16 border-y border-slate-200/60 scroll-mt-28">
  <div class="max-w-7xl mx-auto px-4">
    <div class="mb-10 flex flex-col items-center sm:items-start text-center sm:text-left max-w-2xl mx-auto sm:mx-0">
      <h2 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-slate-900 mb-4">Who Should Enroll?</h2>
      <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl">This program is perfectly suited for the following profiles.</p>
    </div>
    
    <div class="flex overflow-x-auto sm:grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 py-8 -my-8 -mx-4 px-5 sm:mx-0 sm:px-0 sm:py-4 sm:-my-4 snap-x snap-mandatory no-scrollbar max-w-6xl mx-auto mobile-fade-mask" data-swipe-container>
      {normalizedItems.map(item => (
        <div class="swipe-card shrink-0 w-[78vw] sm:w-auto snap-start rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-7 shadow-xs hover:border-emerald-500/60 hover:shadow-lg hover:shadow-emerald-500/10 hover:-translate-y-0.5 transition-all duration-300 flex flex-col">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight flex items-center gap-2 mb-3">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            {item.title}
          </h3>
          <div class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed space-y-4">
            {item.description.split('\n\n').map((p: string) => (
              p.trim() && <p>{p.trim()}</p>
            ))}
          </div>
        </div>
      ))}
    </div>

    {normalizedItems.length > 1 && (
      <div class="flex sm:hidden justify-center items-center gap-2 mt-4" data-eligibility-dots>
        {normalizedItems.map((_, i) => (
          <button
            type="button"
            class={`h-2 rounded-full transition-all duration-300 ${i === 0 ? 'w-6 bg-emerald-600' : 'w-2 bg-slate-300'}`}
            data-dot-index={i}
            aria-label={`Go to profile ${i + 1}`}
          />
        ))}
      </div>
    )}
  </div>
  
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.querySelector('#eligibility [data-swipe-container]');
      if (!container) return;

      const cards = container.querySelectorAll('.swipe-card');
      const dotsContainer = document.querySelector('#eligibility [data-eligibility-dots]');
      const dots = dotsContainer ? dotsContainer.querySelectorAll('[data-dot-index]') : [];

      const updateActive = () => {
        if (!cards.length) return;
        const firstCard = cards[0];
        const cardWidth = firstCard.offsetWidth;
        const gap = cards[1] ? (cards[1].offsetLeft - (firstCard.offsetLeft + cardWidth)) : 16;
        const scrollPos = container.scrollLeft;
        const activeIndex = Math.min(cards.length - 1, Math.max(0, Math.round(scrollPos / (cardWidth + gap))));

        cards.forEach((card, idx) => {
          if (idx === activeIndex) {
            card.classList.add('is-snapped');
          } else {
            card.classList.remove('is-snapped');
          }
        });

        dots.forEach((dot, idx) => {
          if (idx === activeIndex) {
            dot.classList.add('w-6', 'bg-emerald-600');
            dot.classList.remove('w-2', 'bg-slate-300');
          } else {
            dot.classList.remove('w-6', 'bg-emerald-600');
            dot.classList.add('w-2', 'bg-slate-300');
          }
        });
      };

      container.addEventListener('scroll', updateActive, { passive: true });
      window.addEventListener('resize', updateActive, { passive: true });
      updateActive();

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          if (cards[idx]) {
            cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
          }
        });
      });
    });
  </script>
  <style>
    @media (max-width: 639px) {
      .mobile-fade-mask {
        -webkit-mask-image: linear-gradient(to right, black 0%, black 82%, transparent 100%);
        mask-image: linear-gradient(to right, black 0%, black 82%, transparent 100%);
      }
      .swipe-card {
        opacity: 0.65;
        transform: scale(0.96);
        transform-origin: left center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .swipe-card.is-snapped {
        opacity: 1;
        transform: scale(1);
        box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.08), 0 8px 10px -6px rgb(0 0 0 / 0.06);
      }
      .swipe-card:active {
        transform: scale(0.96) !important;
      }
    }
  </style>
</section>
