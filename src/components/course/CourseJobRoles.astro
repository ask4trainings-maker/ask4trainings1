---
export interface Props {
  jobRoles?: (string | Record<string, any>)[];
}

const { jobRoles = [] } = Astro.props;

if (!jobRoles || jobRoles.length === 0) {
  return null;
}
---
<section id="job-roles" class="py-16 bg-slate-50 border-b border-slate-100 scroll-mt-24">
  <div class="max-w-7xl mx-auto px-4">
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <h2 class="text-3xl font-heading font-bold text-slate-900 mb-4">Target Job Roles</h2>
      <p class="text-slate-600">Prepare for these high-demand positions in the industry.</p>
    </div>
    
    <div class="flex flex-wrap justify-center gap-4 max-w-5xl mx-auto">
      {jobRoles.map(role => (
        <div class="flex items-center gap-3 px-6 py-4 bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md hover:border-emerald-400 transition-all group cursor-default">
          <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center group-hover:bg-emerald-100 transition-colors">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <span class="font-bold text-slate-700 group-hover:text-emerald-700 transition-colors">{typeof role === 'string' ? role : (role.text || role.title || role.role || JSON.stringify(role))}</span>
        </div>
      ))}
    </div>
  </div>
</section>
