---
interface Props {
  jobRoles: Array<any>;
}
const { jobRoles = [] } = Astro.props;
---
{jobRoles.length > 0 && (
  <section id="job-roles" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Target Job Roles</h2>
      <p class="text-slate-600 text-sm mt-1">Prepare for these high-demand positions in the industry.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" data-job-roles-container>
      <!-- Left Column: Role Selector List -->
      <div class="lg:col-span-5 space-y-3">
        {jobRoles.map((item, idx) => (
          <button
            type="button"
            class={`w-full text-left px-5 py-4 rounded-xl font-semibold text-sm sm:text-base flex items-center justify-between border transition-all cursor-pointer ${
              idx === 0
                ? 'bg-emerald-600 text-white border-emerald-600 shadow-sm'
                : 'bg-white text-slate-700 border-slate-200/90 hover:bg-slate-50'
            }`}
            data-role-tab={idx}
          >
            <span>{typeof item === 'string' ? item : item.role}</span>
            <span class="text-sm font-bold opacity-75">›</span>
          </button>
        ))}
      </div>

      <!-- Right Column: Active Role Detail Card -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs min-h-[260px] flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="h-10 w-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
                💼
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-slate-900" data-active-role-title>
                {typeof jobRoles[0] === 'string' ? jobRoles[0] : jobRoles[0]?.role}
              </h3>
            </div>
            <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed mb-6" data-active-role-desc>
              {typeof jobRoles[0] === 'string' ? '' : jobRoles[0]?.description}
            </p>
          </div>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
              Required Competencies
            </h4>
            <div class="flex flex-wrap gap-2" data-active-role-competencies>
              {((typeof jobRoles[0] === 'string' ? undefined : jobRoles[0]?.competencies) || ["Industry Best Practices", "Tool Mastery"]).map((comp: string) => (
                <span class="px-3 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium border border-slate-200/60">
                  {comp}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ jobRoles }}>
      document.addEventListener('DOMContentLoaded', () => {
        const container = document.querySelector('[data-job-roles-container]');
        if (!container || !jobRoles.length) return;

        const tabs = container.querySelectorAll('[data-role-tab]');
        const titleEl = container.querySelector('[data-active-role-title]');
        const descEl = container.querySelector('[data-active-role-desc]');
        const compContainer = container.querySelector('[data-active-role-competencies]');

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const idx = parseInt(tab.getAttribute('data-role-tab'), 10);
            const activeData = jobRoles[idx];
            if (!activeData) return;

            // Reset all tab button styles
            tabs.forEach((t) => {
              t.className = 'w-full text-left px-5 py-4 rounded-xl font-semibold text-sm sm:text-base flex items-center justify-between border transition-all cursor-pointer bg-white text-slate-700 border-slate-200/90 hover:bg-slate-50';
            });

            // Apply active style to clicked button
            tab.className = 'w-full text-left px-5 py-4 rounded-xl font-semibold text-sm sm:text-base flex items-center justify-between border transition-all cursor-pointer bg-emerald-600 text-white border-emerald-600 shadow-sm';

            const isStr = typeof activeData === 'string';

            // Update detail card content
            if (titleEl) titleEl.textContent = isStr ? activeData : activeData.role;
            if (descEl) descEl.textContent = isStr ? '' : activeData.description;

            if (compContainer) {
              const comps = (!isStr && activeData.competencies?.length) ? activeData.competencies : ["Industry Best Practices", "Tool Mastery"];
              compContainer.innerHTML = comps.map(c =>
                `<span class="px-3 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium border border-slate-200/60">${c}</span>`
              ).join('');
            }
          });
        });
      });
    </script>
  </section>
)}
