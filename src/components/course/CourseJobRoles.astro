---
interface Props {
  jobRoles: Array<any>;
}
const { jobRoles = [] } = Astro.props;
---
{jobRoles.length > 0 && (
  <section id="job-roles" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full max-w-full overflow-hidden">
    <div class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Target Job Roles</h2>
      <p class="text-slate-600 text-sm mt-1">Prepare for these high-demand positions in the industry.</p>
    </div>

    <!-- MOBILE: Side Scrollable Cards -->
    <div class="flex lg:hidden overflow-x-auto gap-4 py-8 -my-8 -mx-4 px-4 snap-x snap-mandatory no-scrollbar mobile-fade-mask" data-swipe-container>
      {jobRoles.map((item) => (
        <div class="swipe-card shrink-0 w-[78vw] sm:w-[85%] snap-start rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs min-h-[260px] flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="h-10 w-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
                💼
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-slate-900">
                {typeof item === 'string' ? item : item.role}
              </h3>
            </div>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed mb-6">
              {typeof item === 'string' ? '' : item.description}
            </p>
          </div>
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
              Required Competencies
            </h4>
            <div class="flex flex-wrap gap-2">
              {((typeof item === 'string' ? undefined : item.competencies) || ["Industry Best Practices", "Tool Mastery"]).map((comp: string) => (
                <span class="px-3 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium border border-slate-200/60">
                  {comp}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    {jobRoles.length > 1 && (
      <div class="flex lg:hidden justify-center items-center gap-2 mt-4 mb-2" data-jobroles-dots>
        {jobRoles.map((_, i) => (
          <button
            type="button"
            class={`h-2 rounded-full transition-all duration-300 ${i === 0 ? 'w-6 bg-emerald-600' : 'w-2 bg-slate-300'}`}
            data-dot-index={i}
            aria-label={`Go to role ${i + 1}`}
          />
        ))}
      </div>
    )}

    <!-- DESKTOP: Tab Selector Layout -->
    <div class="hidden lg:grid grid-cols-12 gap-8 items-start" data-job-roles-container>
      <!-- Left Column: Role Selector List -->
      <div class="lg:col-span-5 flex lg:flex-col overflow-x-auto no-scrollbar gap-2 lg:gap-3 pb-2 lg:pb-0 snap-x">
        {jobRoles.map((item, idx) => (
          <button
            type="button"
            class={`shrink-0 snap-start px-4 py-2 text-xs sm:text-sm lg:w-full lg:text-left lg:px-5 lg:py-4 rounded-xl font-semibold flex items-center justify-between border transition-all cursor-pointer whitespace-nowrap lg:whitespace-normal ${
              idx === 0
                ? 'bg-emerald-600 text-white border-emerald-600 shadow-sm'
                : 'bg-white text-slate-700 border-slate-200/90 hover:bg-slate-50'
            }`}
            data-role-tab={idx}
          >
            <span>{typeof item === 'string' ? item : item.role}</span>
            <span class="text-sm font-bold opacity-75 hidden lg:inline-block">›</span>
          </button>
        ))}
      </div>

      <!-- Right Column: Active Role Detail Card -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-xs min-h-[260px] flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="h-10 w-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
                💼
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-slate-900" data-active-role-title>
                {typeof jobRoles[0] === 'string' ? jobRoles[0] : jobRoles[0]?.role}
              </h3>
            </div>
            <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed mb-6" data-active-role-desc>
              {typeof jobRoles[0] === 'string' ? '' : jobRoles[0]?.description}
            </p>
          </div>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
              Required Competencies
            </h4>
            <div class="flex flex-wrap gap-2" data-active-role-competencies>
              {((typeof jobRoles[0] === 'string' ? undefined : jobRoles[0]?.competencies) || ["Industry Best Practices", "Tool Mastery"]).map((comp: string) => (
                <span class="px-3 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium border border-slate-200/60">
                  {comp}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ jobRoles }}>
      document.addEventListener('DOMContentLoaded', () => {
        const container = document.querySelector('[data-job-roles-container]');
        if (!container || !jobRoles.length) return;

        const tabs = container.querySelectorAll('[data-role-tab]');
        const titleEl = container.querySelector('[data-active-role-title]');
        const descEl = container.querySelector('[data-active-role-desc]');
        const compContainer = container.querySelector('[data-active-role-competencies]');

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const idx = parseInt(tab.getAttribute('data-role-tab'), 10);
            const activeData = jobRoles[idx];
            if (!activeData) return;

            // Reset all tab button styles
            tabs.forEach((t) => {
              t.className = 'shrink-0 snap-start px-4 py-2 text-xs sm:text-sm lg:w-full lg:text-left lg:px-5 lg:py-4 rounded-xl font-semibold flex items-center justify-between border transition-all cursor-pointer whitespace-nowrap lg:whitespace-normal bg-white text-slate-700 border-slate-200/90 hover:bg-slate-50';
            });

            // Apply active style to clicked button
            tab.className = 'shrink-0 snap-start px-4 py-2 text-xs sm:text-sm lg:w-full lg:text-left lg:px-5 lg:py-4 rounded-xl font-semibold flex items-center justify-between border transition-all cursor-pointer whitespace-nowrap lg:whitespace-normal bg-emerald-600 text-white border-emerald-600 shadow-sm';

            const isStr = typeof activeData === 'string';

            // Update detail card content
            if (titleEl) titleEl.textContent = isStr ? activeData : activeData.role;
            if (descEl) descEl.textContent = isStr ? '' : activeData.description;

            if (compContainer) {
              const comps = (!isStr && activeData.competencies?.length) ? activeData.competencies : ["Industry Best Practices", "Tool Mastery"];
              compContainer.innerHTML = comps.map(c =>
                `<span class="px-3 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium border border-slate-200/60">${c}</span>`
              ).join('');
            }
          });
        });
      });
    </script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const container = document.querySelector('#job-roles [data-swipe-container]');
        if (!container) return;

        const cards = container.querySelectorAll('.swipe-card');
        const dotsContainer = document.querySelector('#job-roles [data-jobroles-dots]');
        const dots = dotsContainer ? dotsContainer.querySelectorAll('[data-dot-index]') : [];

        const updateActive = () => {
          if (!cards.length) return;
          const firstCard = cards[0];
          const cardWidth = firstCard.offsetWidth;
          const gap = cards[1] ? (cards[1].offsetLeft - (firstCard.offsetLeft + cardWidth)) : 16;
          const scrollPos = container.scrollLeft;
          const activeIndex = Math.min(cards.length - 1, Math.max(0, Math.round(scrollPos / (cardWidth + gap))));

          cards.forEach((card, idx) => {
            if (idx === activeIndex) {
              card.classList.add('is-snapped');
            } else {
              card.classList.remove('is-snapped');
            }
          });

          dots.forEach((dot, idx) => {
            if (idx === activeIndex) {
              dot.classList.add('w-6', 'bg-emerald-600');
              dot.classList.remove('w-2', 'bg-slate-300');
            } else {
              dot.classList.remove('w-6', 'bg-emerald-600');
              dot.classList.add('w-2', 'bg-slate-300');
            }
          });
        };

        container.addEventListener('scroll', updateActive, { passive: true });
        window.addEventListener('resize', updateActive, { passive: true });
        updateActive();

        dots.forEach((dot, idx) => {
          dot.addEventListener('click', () => {
            if (cards[idx]) {
              cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
            }
          });
        });
      });
    </script>
    <style>
      @media (max-width: 1023px) {
        .mobile-fade-mask {
          -webkit-mask-image: linear-gradient(to right, black 0%, black 82%, transparent 100%);
          mask-image: linear-gradient(to right, black 0%, black 82%, transparent 100%);
        }
        .swipe-card {
          opacity: 0.65;
          transform: scale(0.96);
          transform-origin: left center;
          transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .swipe-card.is-snapped {
          opacity: 1;
          transform: scale(1);
          box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.08), 0 8px 10px -6px rgb(0 0 0 / 0.06);
        }
        .swipe-card:active {
          transform: scale(0.96) !important;
        }
      }
    </style>
  </section>
)}
