---
import categoriesData from '../../content/categories.json';

export interface Props {
  title: string;
  category: string;
  duration: string;
  mode: string;
  rating: string;
  valueProp?: string;
  videoUrl?: string;
  heroImage?: string;
  brochureUrl?: string;
}

const { 
  title, 
  category, 
  duration, 
  mode, 
  rating, 
  valueProp,
  videoUrl,
  heroImage,
  brochureUrl 
} = Astro.props;

const categoryLabel = (categoriesData as any)[category]?.label || category.replace(/-/g, ' ');

// YouTube URL Sanitizer
function getYoutubeEmbedUrl(url?: string) {
  if (!url) return null;
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
  const match = url.match(regExp);
  const videoId = (match && match[2].length === 11) ? match[2] : null;
  return videoId ? `https://www.youtube-nocookie.com/embed/${videoId}` : null;
}

const embedUrl = getYoutubeEmbedUrl(videoUrl);
---
<div class="relative bg-gradient-to-b from-emerald-50/40 via-white to-white border-b border-slate-100 py-12 lg:py-16 overflow-hidden">
  <!-- Ambient glows -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-emerald-600/15 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 right-1/4 w-64 h-64 bg-emerald-600/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Content -->
      <div class="lg:col-span-7 xl:col-span-8">
        <!-- Breadcrumb -->
        <nav class="flex flex-wrap items-center gap-2 text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-emerald-500 transition-colors">Home</a>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <a href={`/courses/?category=${category}`} class="hover:text-emerald-500 transition-colors">{categoryLabel}</a>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-slate-900 font-semibold truncate max-w-[200px] sm:max-w-xs">{title}</span>
        </nav>

        <!-- Badge -->
        <div class="mb-4">
          <span class="text-xs font-semibold text-emerald-800 bg-white border border-emerald-200 px-3 py-1 rounded-full shadow-sm uppercase tracking-wider">
            {categoryLabel}
          </span>
        </div>

        <!-- Title & Value Prop -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-slate-900 mb-6 leading-tight max-w-4xl">
          {title}
        </h1>
        {valueProp && (
          <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl mb-8">
            {valueProp}
          </p>
        )}

        <!-- 3-Chip Metadata Row -->
        <div class="flex flex-wrap items-center gap-3 mb-8">
          <div class="flex items-center gap-2 text-sm font-medium text-slate-700 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg shadow-sm">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            {duration}
          </div>
          <div class="flex items-center gap-2 text-sm font-medium text-slate-700 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg shadow-sm">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            {mode}
          </div>
          <div class="flex items-center gap-2 text-sm font-medium text-slate-700 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg shadow-sm">
            <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 24 24"><path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
            {rating}
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-4">
          <a href="#enquiry-form" class="inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-6 py-3 rounded-lg shadow-md hover:shadow-lg transition-all focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500">
            Enroll Now
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
          <a href={brochureUrl || "#"} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-white border border-slate-300 hover:border-emerald-500 hover:text-emerald-600 text-slate-700 font-semibold px-6 py-3 rounded-lg shadow-sm transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-slate-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Download Brochure
          </a>
        </div>
      </div>

      <!-- Right Column: Media (YouTube or Fallback Image) -->
      <div class="lg:col-span-5 xl:col-span-4 flex w-full">
        {embedUrl ? (
          <div class="w-full aspect-video bg-slate-900 border border-slate-200 rounded-2xl overflow-hidden relative shadow-xl lg:rotate-1 hover:rotate-0 transition-transform duration-300">
            <iframe 
              src={embedUrl}
              class="absolute inset-0 w-full h-full border-0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              title={`Video introduction for ${title}`}
            ></iframe>
          </div>
        ) : (
          <div class="w-full aspect-[4/3] bg-emerald-50 border border-emerald-100/50 rounded-2xl overflow-hidden relative shadow-lg flex items-center justify-center group lg:-rotate-1 hover:rotate-0 transition-transform duration-300">
            {heroImage ? (
              <img src={heroImage} alt={title} class="w-full h-full object-cover" />
            ) : (
              <div class="flex flex-col items-center text-emerald-800/40">
                <svg class="w-20 h-20 mb-4 drop-shadow-sm" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-16 h-16 bg-white/80 backdrop-blur-sm rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                    <svg class="w-8 h-8 text-emerald-600 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                </div>
              </div>
            )}
          </div>
        )}
      </div>

    </div>
  </div>
</div>
