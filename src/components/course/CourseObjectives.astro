---
export interface Props {
  objectives?: (string | Record<string, any>)[];
}

const { objectives = [] } = Astro.props;

if (!objectives || objectives.length === 0) {
  return null;
}
---
<section id="objectives" class="py-16 bg-white border-b border-slate-100 scroll-mt-24">
  <div class="max-w-7xl mx-auto px-4">
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <h2 class="text-3xl font-heading font-bold text-slate-900 mb-4">Course Objectives</h2>
      <p class="text-slate-600">Key outcomes and skills you will master by the end of this program.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {objectives.map(objective => (
        <div class="flex items-start gap-4 p-6 rounded-2xl bg-slate-50 border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <p class="text-slate-700 leading-relaxed">{typeof objective === 'string' ? objective : (objective.text || objective.title || objective.point || objective.objective || JSON.stringify(objective))}</p>
        </div>
      ))}
    </div>
  </div>
</section>
