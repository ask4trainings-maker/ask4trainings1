---
export interface Props {
  objectives?: (string | Record<string, any>)[];
}

const { objectives = [] } = Astro.props;

if (!objectives || objectives.length === 0) {
  return null;
}
---
<section id="objectives" class="bg-slate-50/50 py-16 border-y border-slate-200/60 scroll-mt-28">
  <div class="max-w-7xl mx-auto px-4">
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <h2 class="text-3xl font-heading font-bold text-slate-900 mb-4">Course Objectives</h2>
      <p class="text-slate-600">Key outcomes and skills you will master by the end of this program.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
      {objectives.map(objective => (
        <div class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-7 shadow-xs hover:border-emerald-500/60 hover:shadow-lg hover:shadow-emerald-500/10 hover:-translate-y-0.5 transition-all duration-300 flex items-start gap-3">
          <span class="text-emerald-600 mt-0.5">✓</span>
          <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed">
            {typeof objective === 'string' ? objective : ((objective as any).item || (objective as any).text || (objective as any).title || (objective as any).point || (objective as any).objective || JSON.stringify(objective))}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
