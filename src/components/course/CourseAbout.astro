---
import GuidewireInfographic from './infographics/GuidewireInfographic.astro';
import SAPInfographic from './infographics/SAPInfographic.astro';
import CloudDevOpsInfographic from './infographics/CloudDevOpsInfographic.astro';
import DataAIInfographic from './infographics/DataAIInfographic.astro';
import SiemensPLMInfographic from './infographics/SiemensPLMInfographic.astro';
import DefaultEnterpriseInfographic from './infographics/DefaultEnterpriseInfographic.astro';

export interface Props {
  aboutCourse?: string;
  courseTitle?: string;
  category?: string;
  whyMaster?: {
    title?: string;
    description?: string;
    pillars?: { title: string; description: string }[];
  };
}

const { aboutCourse, courseTitle = "the Course", category, whyMaster } = Astro.props;

// Resolve display values: whyMaster fields take priority, fall back to legacy aboutCourse
const bodyText = whyMaster?.description || aboutCourse;
const sectionTitle = whyMaster?.title || `Why Master ${courseTitle}?`;
const pillars = whyMaster?.pillars && whyMaster.pillars.length > 0
  ? whyMaster.pillars
  : null; // null = use hardcoded defaults

if (!bodyText && !whyMaster?.title) {
  return null;
}
---
<section id="about" class="bg-white py-16 scroll-mt-28">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Column (60%) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-block px-3 py-1 bg-emerald-50 text-emerald-700 text-sm font-semibold rounded-full border border-emerald-100">
          Course Deep Dive
        </div>
        <h2 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-slate-900 break-words min-w-0">{sectionTitle}</h2>
        {bodyText && (
          <div class="prose prose-slate prose-emerald max-w-none text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed text-lg">
            <p>{bodyText}</p>
          </div>
        )}
      </div>
      
      <!-- Right Column (40%) -->
      <div class="lg:col-span-5 w-full">
        <div class="bg-slate-900 text-white rounded-2xl border border-slate-800 p-6 sm:p-8 shadow-md">
          <!-- Enterprise SVG Graphic -->
          <div class="w-full overflow-x-auto no-scrollbar sm:overflow-visible my-6">
            <div class="min-w-[340px] sm:min-w-0 flex justify-center aspect-[4/3] bg-slate-900 rounded-xl mb-6 p-4">
              {category === 'guidewire' ? <GuidewireInfographic /> :
               category === 'sap' ? <SAPInfographic /> :
               ['cloud-computing', 'devops'].includes(category || '') ? <CloudDevOpsInfographic /> :
               category === 'trending-courses' ? <DataAIInfographic /> :
               category === 'siemens' ? <SiemensPLMInfographic /> :
               <DefaultEnterpriseInfographic />}
            </div>
          </div>
          
          <!-- Micro Cards: CMS-driven pillars or hardcoded defaults -->
          <div class="space-y-4">
            {pillars ? pillars.map((pillar: { title: string; description: string }) => (
              <div class="flex items-start gap-3">
                <span class="text-xl leading-none">⚡</span>
                <div>
                  <h4 class="font-bold text-white text-sm">{pillar.title}</h4>
                  <p class="text-xs text-slate-400 mt-0.5">{pillar.description}</p>
                </div>
              </div>
            )) : (
              <>
                <div class="flex items-start gap-3">
                  <span class="text-xl leading-none">⚡</span>
                  <div>
                    <h4 class="font-bold text-white text-sm">Architecture Mastery</h4>
                    <p class="text-xs text-slate-400 mt-0.5">End-to-end operational workflows.</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <span class="text-xl leading-none">🛡️</span>
                  <div>
                    <h4 class="font-bold text-white text-sm">Enterprise Standards</h4>
                    <p class="text-xs text-slate-400 mt-0.5">Production governance and compliance.</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <span class="text-xl leading-none">📈</span>
                  <div>
                    <h4 class="font-bold text-white text-sm">High-Demand Career Path</h4>
                    <p class="text-xs text-slate-400 mt-0.5">Specialized consulting and implementation roles.</p>
                  </div>
                </div>
              </>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
