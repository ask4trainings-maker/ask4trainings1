---
import GuidewireInfographic from './infographics/GuidewireInfographic.astro';
import SAPInfographic from './infographics/SAPInfographic.astro';
import CloudDevOpsInfographic from './infographics/CloudDevOpsInfographic.astro';
import DataAIInfographic from './infographics/DataAIInfographic.astro';
import SiemensPLMInfographic from './infographics/SiemensPLMInfographic.astro';
import DefaultEnterpriseInfographic from './infographics/DefaultEnterpriseInfographic.astro';

export interface Props {
  aboutCourse?: string;
  courseTitle?: string;
  category?: string;
  whyMaster?: {
    title?: string;
    description?: string;
  };
  valueProp?: string;
}

const { aboutCourse, courseTitle = "the Course", category, whyMaster, valueProp } = Astro.props;

// Resolve display values: whyMaster fields take priority, fall back to legacy aboutCourse
const bodyText = whyMaster?.description || aboutCourse;
const sectionTitle = whyMaster?.title || `Why Master ${courseTitle}?`;

if (!bodyText && !whyMaster?.title && !valueProp) {
  return null;
}
---
<section id="about" class="bg-white py-16 scroll-mt-28">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Column (60%) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-block px-3 py-1 bg-emerald-50 text-emerald-700 text-sm font-semibold rounded-full border border-emerald-100">
          Course Deep Dive
        </div>
        <h2 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-slate-900 break-words min-w-0">{sectionTitle}</h2>
        {bodyText ? (
          <div class="space-y-4 prose prose-slate prose-emerald max-w-none text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed">
            {bodyText.split('\n\n').map((paragraph) => (
              paragraph.trim() && <p>{paragraph.trim()}</p>
            ))}
          </div>
        ) : (
          <div class="space-y-4 prose prose-slate prose-emerald max-w-none text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed">
            <p>{valueProp}</p>
          </div>
        )}
      </div>
      
      <!-- Right Column (40%) -->
      <div class="lg:col-span-5 w-full">
        <div class="bg-slate-900 text-white rounded-2xl border border-slate-800 p-6 sm:p-8 shadow-md">
          <!-- Enterprise SVG Graphic -->
          <div class="w-full overflow-x-auto no-scrollbar sm:overflow-visible my-6">
            <div class="min-w-[340px] sm:min-w-0 flex justify-center aspect-[4/3] bg-slate-900 rounded-xl mb-6 p-4">
              {category === 'guidewire' ? <GuidewireInfographic /> :
               category === 'sap' ? <SAPInfographic /> :
               ['cloud-computing', 'devops'].includes(category || '') ? <CloudDevOpsInfographic /> :
               category === 'trending-courses' ? <DataAIInfographic /> :
               category === 'siemens' ? <SiemensPLMInfographic /> :
               <DefaultEnterpriseInfographic />}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
