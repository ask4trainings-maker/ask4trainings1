---
export interface Props {
  faqs?: { question: string; answer: string }[];
}

const { faqs = [] } = Astro.props;

if (!faqs || faqs.length === 0) {
  return null;
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---
<section id="faqs" class="py-16 bg-white border-b border-slate-100 scroll-mt-24">
  <div class="max-w-7xl mx-auto px-4">
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <h2 class="text-3xl font-heading font-bold text-slate-900 mb-4">Frequently Asked Questions</h2>
      <p class="text-slate-600">Got questions? We have got answers.</p>
    </div>
    
    <div class="space-y-4 max-w-4xl mx-auto">
      {faqs.map(faq => (
        <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-emerald-500/40 transition-colors shadow-sm">
          <summary class="flex items-center justify-between px-6 py-5 cursor-pointer list-none select-none font-medium text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600">
            <span class="pr-6 text-lg">{faq.question}</span>
            <svg class="w-5 h-5 text-slate-500 shrink-0 transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="px-6 pb-6 pt-2 text-slate-600 border-t border-slate-100 leading-relaxed bg-slate-50/50">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  /* Custom summary marker hide — cross-browser */
  details > summary::-webkit-details-marker { display: none; }
  details > summary::marker { display: none; }
</style>
