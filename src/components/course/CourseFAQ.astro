---
export interface Props {
  faqs?: { question: string; answer: string }[];
}

const { faqs = [] } = Astro.props;

if (!faqs || faqs.length === 0) {
  return null;
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---
<section id="faqs" class="py-16 bg-white scroll-mt-28">
  <div class="max-w-7xl mx-auto px-4">
    <div class="mb-10 flex flex-col items-center sm:items-start text-center sm:text-left max-w-2xl mx-auto sm:mx-0">
      <h2 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-slate-900 mb-4">Frequently Asked Questions</h2>
      <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl">Got questions? We have got answers.</p>
    </div>
    
    <div class="space-y-4 max-w-4xl mx-auto" data-faqs-container>
      {faqs.map((faq, idx) => (
        <div class={`group bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-emerald-500/40 transition-all shadow-sm ${idx === 0 ? 'is-open' : ''} [&.is-open]:border-emerald-500/40`}>
          <div class="flex items-center justify-between px-6 py-5 cursor-pointer select-none font-medium text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 list-none">
            <span class="pr-6 text-sm sm:text-base font-semibold text-slate-800">{faq.question}</span>
            <svg class="w-5 h-5 text-slate-400 shrink-0 transition-transform duration-300 group-[.is-open]:rotate-180 group-[.is-open]:text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>
          
          <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-[.is-open]:grid-rows-[1fr]">
            <div class="overflow-hidden">
              <div class="px-6 pb-6 pt-2 text-sm sm:text-base md:text-lg text-slate-600 border-t border-slate-100 leading-relaxed bg-slate-50/50">
                {faq.answer}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.querySelector('[data-faqs-container]');
      if (!container) return;
      const items = container.querySelectorAll('.group');
      
      let isTouch = false;
      window.addEventListener('touchstart', () => { isTouch = true; }, { passive: true });

      items.forEach((item) => {
        item.addEventListener('mouseenter', () => {
          if (isTouch || window.innerWidth < 1024) return;
          items.forEach((sibling) => {
            if (sibling !== item) sibling.classList.remove('is-open');
          });
          item.classList.add('is-open');
        });
        
        const header = item.firstElementChild;
        if (header) {
          header.addEventListener('click', () => {
            const isOpen = item.classList.contains('is-open');
            items.forEach((sibling) => sibling.classList.remove('is-open'));
            if (!isOpen) item.classList.add('is-open');
          });
        }
      });
    });
  </script>
</section>

