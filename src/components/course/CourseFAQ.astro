---
export interface Props {
  faqs?: { question: string; answer: string }[];
}

const { faqs = [] } = Astro.props;

if (!faqs || faqs.length === 0) {
  return null;
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---
<section id="faqs" class="py-16 bg-white scroll-mt-28">
  <div class="max-w-7xl mx-auto px-4">
    <div class="mb-10 flex flex-col items-center sm:items-start text-center sm:text-left max-w-2xl mx-auto sm:mx-0">
      <h2 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-slate-900 mb-4">Frequently Asked Questions</h2>
      <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl">Got questions? We have got answers.</p>
    </div>
    
    <div class="space-y-4 max-w-4xl mx-auto" data-faqs-container>
      {faqs.map((faq, idx) => (
        <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-emerald-500/40 transition-colors shadow-sm open:border-emerald-500/40" open={idx === 0}>
          <summary class="flex items-center justify-between px-6 py-5 cursor-pointer select-none font-medium text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 list-none">
            <span class="pr-6 text-sm sm:text-base font-semibold text-slate-800">{faq.question}</span>
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition-transform duration-200 group-open:rotate-180 group-open:bg-emerald-50 group-open:text-emerald-600 text-xs">
              ▼
            </span>
          </summary>
          
          <div class="px-6 pb-6 pt-2 text-sm sm:text-base md:text-lg text-slate-600 border-t border-slate-100 leading-relaxed bg-slate-50/50">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.querySelector('[data-faqs-container]');
      if (!container) return;
      const items = container.querySelectorAll('details');

      items.forEach((item) => {
        item.addEventListener('mouseenter', () => {
          items.forEach((sibling) => {
            if (sibling !== item) sibling.removeAttribute('open');
          });
          item.setAttribute('open', '');
        });
      });
    });
  </script>
</section>

