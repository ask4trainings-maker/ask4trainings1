---
interface Props {
  certification?: { title?: string; description?: string };
  courseTitle: string;
}
const { certification, courseTitle } = Astro.props;
---
{certification && certification.description && (
  <section id="certification" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16 border-t border-slate-100">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Certificate Graphic (lg:col-span-5) -->
      <div class="lg:col-span-5 flex justify-center order-2 lg:order-1 max-w-md mx-auto w-full">
        <div class="relative w-full group">
          <!-- Subtle Glow Backdrop -->
          <div class="absolute -inset-1.5 rounded-2xl bg-linear-to-r from-emerald-500/20 via-teal-500/10 to-emerald-600/20 blur-lg opacity-70 group-hover:opacity-100 transition-opacity duration-300"></div>

          <!-- Certificate Frame -->
          <div class="relative overflow-hidden rounded-2xl border border-slate-800/90 bg-[#06090e] shadow-2xl transition-transform duration-300 group-hover:scale-[1.01]">
            <img
              src="/assets/certificate.svg"
              alt={`Official Certificate of Completion for ${courseTitle}`}
              width="800"
              height="600"
              class="w-full h-auto block select-none"
              loading="lazy"
              decoding="async"
            />

            <!-- Verification Footer Pill -->
            <div class="flex items-center justify-between px-4 py-2.5 bg-slate-950/90 border-t border-slate-800/80 text-xs text-slate-400">
              <span class="inline-flex items-center gap-1.5 font-medium text-emerald-400">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                Verified Enterprise Credential
              </span>
              <a
                href="/assets/certificate.svg"
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-400 hover:text-white transition-colors underline-offset-2 hover:underline"
              >
                View Full Size ↗
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Certification Copy (lg:col-span-7) -->
      <div class="lg:col-span-7 space-y-4 order-1 lg:order-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Official Credential</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          {certification.title || `${courseTitle} Certification`}
        </h2>
        <div class="space-y-4 text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed">
          {certification.description.split('\n\n').map((para) => (
            <p>{para.trim()}</p>
          ))}
        </div>
      </div>

    </div>
  </section>
)}
