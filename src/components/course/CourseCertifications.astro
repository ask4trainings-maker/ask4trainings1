---
interface Props {
  certification?: { title?: string; description?: string };
  courseTitle: string;
}
const { certification, courseTitle } = Astro.props;
---
{certification && certification.description && (
  <section id="certification" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-slate-100">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 space-y-4">
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Official Credential</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">
          {certification.title || `${courseTitle} Certification`}
        </h2>
        <div class="space-y-4 text-slate-600 text-sm sm:text-base leading-relaxed">
          {certification.description.split('\n\n').map((para) => (
            <p>{para.trim()}</p>
          ))}
        </div>
      </div>
      <div class="lg:col-span-5 flex justify-center">
        <!-- Standardized Certificate Showcase Mockup Card -->
        <div class="rounded-2xl border border-slate-200 bg-linear-to-b from-slate-50 to-white p-6 shadow-sm text-center max-w-md w-full">
          <div class="h-12 w-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-4 font-bold text-xl">
            🎓
          </div>
          <h3 class="font-bold text-slate-900 text-base">Certificate of Completion</h3>
          <p class="text-xs text-slate-500 mt-1">Accredited Enterprise Credential from Ask4Trainings</p>
        </div>
      </div>
    </div>
  </section>
)}
