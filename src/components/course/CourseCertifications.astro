---
export interface Props {
  certifications?: {
    title: string;
    description: string;
    badges: (string | Record<string, any>)[];
  };
}

const { certifications } = Astro.props;

if (!certifications || !certifications.title) {
  return null;
}
---
<section id="certifications" class="bg-slate-50/50 py-16 border-y border-slate-200/70 scroll-mt-28">
  <div class="max-w-7xl mx-auto px-4">
    <div class="bg-gradient-to-br from-slate-900 to-slate-800 rounded-3xl overflow-hidden shadow-2xl relative">
      <!-- Decorative background -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-emerald-500/20 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl"></div>
      </div>
      
      <div class="relative p-10 md:p-16 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm font-medium mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
            Certification Ready
          </div>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-6 leading-tight">
            {certifications.title}
          </h2>
          <p class="text-slate-300 text-lg mb-8 leading-relaxed">
            {certifications.description}
          </p>
          
          {certifications.badges && certifications.badges.length > 0 && (
            <div class="space-y-4">
              <p class="text-sm font-semibold text-slate-400 uppercase tracking-wider">Covered Exams / Credentials</p>
              <div class="flex flex-wrap gap-3">
                {certifications.badges.map(badge => (
                  <span class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-white font-medium backdrop-blur-sm shadow-sm flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
                    {typeof badge === 'string' ? badge : (badge.text || badge.title || badge.badge || JSON.stringify(badge))}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
        
        <!-- Illustration -->
        <div class="relative hidden lg:block">
           <div class="w-full aspect-square max-w-sm mx-auto rounded-full border border-dashed border-slate-700 flex items-center justify-center p-8 relative z-10">
              <div class="w-full h-full rounded-full bg-gradient-to-tr from-emerald-500/20 to-blue-500/20 backdrop-blur flex items-center justify-center border border-white/10 shadow-2xl">
                 <svg class="w-32 h-32 text-white opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
              </div>
           </div>
        </div>
      </div>
    </div>
  </div>
</section>
