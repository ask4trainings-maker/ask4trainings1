---
export interface Props {
  syllabus: { moduleTitle?: string; module?: string; topics: string[] }[];
  brochureUrl?: string;
}

const { syllabus = [], brochureUrl } = Astro.props;

if (!syllabus || syllabus.length === 0) {
  return null;
}
---
<div class="bg-white rounded-xl">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col items-center sm:items-start text-center sm:text-left md:flex-row md:items-end justify-between gap-6 mb-10 mx-auto sm:mx-0">
      <div>
        <h2 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-slate-900 mb-2">Course Curriculum</h2>
        <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl">Comprehensive syllabus covering fundamental to advanced topics.</p>
      </div>
      {brochureUrl && (
        <a href={brochureUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-slate-900 hover:bg-emerald-600 text-white font-medium px-5 py-2.5 rounded-lg transition-colors shadow-sm whitespace-nowrap">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          Download Detailed Curriculum (PDF)
        </a>
      )}
    </div>
    
    <div class="space-y-3">
      {syllabus.map((mod, i) => (
        <div data-module-card class="module-accordion rounded-2xl border border-slate-200 bg-white p-5 transition-all duration-300 hover:shadow-md cursor-pointer">
          <!-- Module Header -->
          <div class="flex items-center justify-between select-none">
            <div class="flex items-center gap-4">
              <span class="w-9 h-9 shrink-0 rounded-xl bg-emerald-50 text-emerald-700 font-bold flex items-center justify-center text-sm transition-colors duration-300">
                {i + 1}
              </span>
              <h3 class="font-semibold text-slate-800 text-sm sm:text-base transition-colors">
                {mod.moduleTitle || mod.module}
              </h3>
            </div>
            <div class="flex items-center gap-3">
              <span class="hidden sm:inline-block text-xs text-slate-400 bg-slate-100 px-2.5 py-1 rounded-full">{mod.topics.length} topics</span>
              <svg data-module-chevron class="w-5 h-5 text-slate-400 shrink-0 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>

          <!-- Smooth Animated Drawer -->
          <div data-module-body class="max-h-0 opacity-0 overflow-hidden transition-all duration-300 ease-in-out">
            <ul class="pt-4 mt-3 border-t border-slate-100 space-y-2.5">
              {mod.topics.map((topic) => (
                <li class="flex items-start gap-2.5 text-sm text-slate-600">
                  <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{topic}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const moduleCards = document.querySelectorAll('[data-module-card]');
    if (!moduleCards.length) return;

    function activateModule(targetCard) {
      moduleCards.forEach(card => {
        const body = card.querySelector('[data-module-body]');
        const icon = card.querySelector('[data-module-chevron]');
        const isTarget = (card === targetCard);

        if (isTarget) {
          card.classList.add('border-emerald-500', 'bg-emerald-50/20');
          if (body) {
            body.style.maxHeight = body.scrollHeight + 20 + 'px'; // add some padding room
            body.classList.remove('hidden', 'opacity-0', 'max-h-0');
            body.classList.add('opacity-100', 'py-3');
          }
          if (icon) icon.classList.add('rotate-180', 'text-emerald-600');
        } else {
          card.classList.remove('border-emerald-500', 'bg-emerald-50/20');
          if (body) {
            body.style.maxHeight = '0px';
            body.classList.remove('opacity-100', 'py-3');
            body.classList.add('opacity-0');
          }
          if (icon) icon.classList.remove('rotate-180', 'text-emerald-600');
        }
      });
    }

    // Default open first module
    if (moduleCards.length > 0) {
      activateModule(moduleCards[0]);
    }

    // Desktop: Hover trigger (mouseenter)
    // Mobile/Tablet: Tap trigger (click)
    moduleCards.forEach(card => {
      card.addEventListener('mouseenter', () => {
        if (window.innerWidth >= 1024) {
          activateModule(card);
        }
      });

      card.addEventListener('click', () => {
        activateModule(card);
      });
    });
  });
</script>
</div>

