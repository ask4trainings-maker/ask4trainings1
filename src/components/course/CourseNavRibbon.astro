---
// src/components/course/CourseNavRibbon.astro
---
<div id="course-nav-ribbon" class="sticky top-14 sm:top-16 z-30 w-full bg-white/95 backdrop-blur-md border-y border-slate-200/80 shadow-xs transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav 
      class="flex items-center sm:justify-center overflow-x-auto no-scrollbar py-2 sm:py-3 gap-1 sm:gap-2 snap-x snap-mandatory"
      aria-label="Course section navigation"
    >
      <a href="#overview" class="shrink-0 snap-start px-3 py-1.5 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Overview</a>
      <a href="#curriculum" class="shrink-0 snap-start px-3 py-1.5 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Curriculum</a>
      <a href="#objectives" class="shrink-0 snap-start px-3 py-1.5 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Objectives</a>
      <a href="#benefits" class="shrink-0 snap-start px-3 py-1.5 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Benefits</a>
      <a href="#why-choose" class="shrink-0 snap-start px-3 py-1.5 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Why Choose Us</a>
      <a href="#eligibility" class="shrink-0 snap-start px-3 py-1.5 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Eligibility</a>
      <a href="#certifications" class="shrink-0 snap-start px-3 py-1.5 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Certifications</a>
      <a href="#job-roles" class="shrink-0 snap-start px-3 py-1.5 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Job Roles</a>
      <a href="#trainer-profile" class="shrink-0 snap-start px-3 py-1.5 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Trainer Profile</a>
      <a href="#faqs" class="shrink-0 snap-start px-3 py-1.5 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">FAQs</a>
    </nav>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navLinks = document.querySelectorAll('#course-nav-ribbon nav a');
    const sections = Array.from(navLinks).map((link) => {
      const url = new URL((link as HTMLAnchorElement).href);
      return document.querySelector(url.hash);
    }).filter(Boolean);

    if (sections.length > 0) {
      const scrollspyObserver = new IntersectionObserver(
        (entries) => {
          let activeId: string | null = null;
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              activeId = entry.target.id;
            }
          });

          if (activeId) {
            navLinks.forEach(link => {
              const url = new URL((link as HTMLAnchorElement).href);
              if (url.hash === `#${activeId}`) {
                link.classList.add('text-emerald-700', 'bg-emerald-50');
                link.classList.remove('text-slate-700');
                link.scrollIntoView({ inline: 'center', behavior: 'smooth', block: 'nearest' });
              } else {
                link.classList.remove('text-emerald-700', 'bg-emerald-50');
                link.classList.add('text-slate-700');
              }
            });
          }
        },
        { rootMargin: '-20% 0px -65% 0px' }
      );

      sections.forEach(section => { if (section) scrollspyObserver.observe(section as Element); });
    }
  });
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
