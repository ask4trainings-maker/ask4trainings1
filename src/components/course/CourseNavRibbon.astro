---
// src/components/course/CourseNavRibbon.astro
---
<div id="course-nav-placeholder" class="w-full"></div>
<div id="course-nav-ribbon" class="w-full bg-slate-50 border-b border-slate-200 transition-all duration-300 z-40">
  <div class="flex items-center gap-4 overflow-x-auto scrollbar-none py-3.5 px-4 max-w-7xl mx-auto">
    <a href="#overview" class="text-xs md:text-sm font-medium whitespace-nowrap text-slate-700 hover:text-emerald-600 transition-colors py-1 px-3 rounded-lg hover:bg-emerald-50">Overview</a>
    <a href="#curriculum" class="text-xs md:text-sm font-medium whitespace-nowrap text-slate-700 hover:text-emerald-600 transition-colors py-1 px-3 rounded-lg hover:bg-emerald-50">Curriculum</a>
    <a href="#objectives" class="text-xs md:text-sm font-medium whitespace-nowrap text-slate-700 hover:text-emerald-600 transition-colors py-1 px-3 rounded-lg hover:bg-emerald-50">Objectives</a>
    <a href="#benefits" class="text-xs md:text-sm font-medium whitespace-nowrap text-slate-700 hover:text-emerald-600 transition-colors py-1 px-3 rounded-lg hover:bg-emerald-50">Benefits</a>
    <a href="#why-choose" class="text-xs md:text-sm font-medium whitespace-nowrap text-slate-700 hover:text-emerald-600 transition-colors py-1 px-3 rounded-lg hover:bg-emerald-50">Why Choose Us</a>
    <a href="#eligibility" class="text-xs md:text-sm font-medium whitespace-nowrap text-slate-700 hover:text-emerald-600 transition-colors py-1 px-3 rounded-lg hover:bg-emerald-50">Eligibility</a>
    <a href="#certifications" class="text-xs md:text-sm font-medium whitespace-nowrap text-slate-700 hover:text-emerald-600 transition-colors py-1 px-3 rounded-lg hover:bg-emerald-50">Certifications</a>
    <a href="#job-roles" class="text-xs md:text-sm font-medium whitespace-nowrap text-slate-700 hover:text-emerald-600 transition-colors py-1 px-3 rounded-lg hover:bg-emerald-50">Job Roles</a>
    <a href="#trainer-profile" class="text-xs md:text-sm font-medium whitespace-nowrap text-slate-700 hover:text-emerald-600 transition-colors py-1 px-3 rounded-lg hover:bg-emerald-50">Trainer Profile</a>
    <a href="#faqs" class="text-xs md:text-sm font-medium whitespace-nowrap text-slate-700 hover:text-emerald-600 transition-colors py-1 px-3 rounded-lg hover:bg-emerald-50">FAQs</a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const ribbon = document.getElementById('course-nav-ribbon');
    const placeholder = document.getElementById('course-nav-placeholder');
    const mainHeader = document.getElementById('main-header') || document.querySelector('header');
    
    if (ribbon && placeholder) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
              // Scrolled past the placeholder, pin ribbon and hide main header
              const height = ribbon.offsetHeight;
              placeholder.style.height = `${height}px`;
              
              ribbon.classList.add('fixed', 'top-0', 'left-0', 'bg-white/95', 'backdrop-blur-md', 'shadow-sm');
              ribbon.classList.remove('bg-slate-50');
              
              if (mainHeader) {
                mainHeader.style.transition = 'transform 0.3s ease';
                mainHeader.style.transform = 'translateY(-100%)';
              }
            } else {
              // Scrolled above the placeholder, unpin ribbon and show main header
              placeholder.style.height = '0px';
              
              ribbon.classList.remove('fixed', 'top-0', 'left-0', 'bg-white/95', 'backdrop-blur-md', 'shadow-sm');
              ribbon.classList.add('bg-slate-50');
              
              if (mainHeader) {
                mainHeader.style.transform = 'translateY(0)';
              }
            }
          });
        },
        { threshold: [1.0] }
      );
      
      observer.observe(placeholder);
    }

    // Scrollspy logic
    const navLinks = document.querySelectorAll('#course-nav-ribbon a');
    const sections = Array.from(navLinks).map((link) => {
      const url = new URL((link as HTMLAnchorElement).href);
      return document.querySelector(url.hash);
    }).filter(Boolean);

    if (sections.length > 0) {
      const scrollspyObserver = new IntersectionObserver(
        (entries) => {
          let activeId: string | null = null;
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              activeId = entry.target.id;
            }
          });

          if (activeId) {
            navLinks.forEach(link => {
              const url = new URL((link as HTMLAnchorElement).href);
              if (url.hash === `#${activeId}`) {
                link.classList.add('font-bold', 'text-emerald-700', 'bg-emerald-50', 'border-b-2', 'border-emerald-500');
                link.classList.remove('text-slate-700', 'font-medium');
                // Auto-scroll the ribbon on mobile
                link.scrollIntoView({ inline: 'center', behavior: 'smooth', block: 'nearest' });
              } else {
                link.classList.remove('font-bold', 'text-emerald-700', 'bg-emerald-50', 'border-b-2', 'border-emerald-500');
                link.classList.add('text-slate-700', 'font-medium');
              }
            });
          }
        },
        { rootMargin: '-20% 0px -65% 0px' }
      );

      sections.forEach(section => { if (section) scrollspyObserver.observe(section as Element); });
    }
  });
</script>

<style>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
