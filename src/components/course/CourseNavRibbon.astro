---
// src/components/course/CourseNavRibbon.astro
---
<div 
  id="course-nav-ribbon" 
  class="sticky top-0 z-30 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs transition-all duration-300"
  style="top: var(--ribbon-dock-top, 0px);"
>
  <div class="max-w-7xl mx-auto">
    <nav 
      class="flex items-center overflow-x-auto no-scrollbar px-4 sm:px-6 gap-2 sm:gap-3 py-2.5 sm:py-3 snap-x snap-mandatory scroll-smooth touch-pan-x"
      aria-label="Course section navigation"
    >
      <a href="#overview" class="nav-tab min-h-[40px] flex items-center justify-center px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-bold whitespace-nowrap rounded-lg shrink-0 snap-start transition-colors bg-emerald-50 text-emerald-700">Overview</a>
      <a href="#curriculum" class="nav-tab min-h-[40px] flex items-center justify-center px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold whitespace-nowrap rounded-lg shrink-0 snap-start transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Curriculum</a>
      <a href="#objectives" class="nav-tab min-h-[40px] flex items-center justify-center px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap shrink-0 snap-start transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Objectives</a>
      <a href="#benefits" class="nav-tab min-h-[40px] flex items-center justify-center px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap shrink-0 snap-start transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Benefits</a>
      <a href="#why-choose" class="nav-tab min-h-[40px] flex items-center justify-center px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap shrink-0 snap-start transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Why Choose Us</a>
      <a href="#eligibility" class="nav-tab min-h-[40px] flex items-center justify-center px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap shrink-0 snap-start transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Eligibility</a>
      <a href="#certifications" class="nav-tab min-h-[40px] flex items-center justify-center px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap shrink-0 snap-start transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Certifications</a>
      <a href="#job-roles" class="nav-tab min-h-[40px] flex items-center justify-center px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap shrink-0 snap-start transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Job Roles</a>
      <a href="#trainer-profile" class="nav-tab min-h-[40px] flex items-center justify-center px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap shrink-0 snap-start transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">Trainer Profile</a>
      <a href="#faqs" class="nav-tab min-h-[40px] flex items-center justify-center px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg whitespace-nowrap shrink-0 snap-start transition-colors text-slate-700 hover:text-emerald-600 hover:bg-emerald-50">FAQs</a>
    </nav>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navLinks = document.querySelectorAll('#course-nav-ribbon nav a');
    const sections = Array.from(navLinks).map((link) => {
      const url = new URL((link as HTMLAnchorElement).href);
      return document.querySelector(url.hash);
    }).filter(Boolean);

    if (sections.length > 0) {
      const scrollspyObserver = new IntersectionObserver(
        (entries) => {
          let activeId: string | null = null;
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              activeId = entry.target.id;
            }
          });

          if (activeId) {
            navLinks.forEach(link => {
              const url = new URL((link as HTMLAnchorElement).href);
              if (url.hash === `#${activeId}`) {
                link.classList.add('text-emerald-700', 'bg-emerald-50', 'font-bold');
                link.classList.remove('text-slate-700', 'font-semibold');
                link.scrollIntoView({ inline: 'center', behavior: 'smooth', block: 'nearest' });
              } else {
                link.classList.remove('text-emerald-700', 'bg-emerald-50', 'font-bold');
                link.classList.add('text-slate-700', 'font-semibold');
              }
            });
          }
        },
        { rootMargin: '-15% 0px -70% 0px' }
      );

      sections.forEach(section => { if (section) scrollspyObserver.observe(section as Element); });
    }
  });
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
