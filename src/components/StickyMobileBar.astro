---
import WhatsAppCTA from './WhatsAppCTA.astro';
export interface Props {
  courseName?: string;
}
const { courseName } = Astro.props;
---
<div class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] flex border-t border-slate-200">
  <a href="tel:+918099949888" class="flex-1 flex justify-center items-center gap-2 py-4 text-slate-700 font-medium border-r border-slate-200 hover:bg-slate-50 transition-colors" aria-label="Call Ask 4 Trainings">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
    </svg>
    Call Now
  </a>
  <WhatsAppCTA courseName={courseName} className="flex-1 py-4 !rounded-none !bg-emerald-600 text-slate-900" />
</div>
