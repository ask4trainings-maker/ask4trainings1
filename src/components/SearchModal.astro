---
---
<div id="search-modal" class="fixed inset-0 z-50 bg-ink-900/80 hidden opacity-0 transition-opacity duration-200 flex items-start justify-center pt-24 px-4 backdrop-blur-sm">
  <div class="bg-surface-0 w-full max-w-2xl rounded-xl shadow-2xl overflow-hidden transform -translate-y-4 transition-transform duration-200" id="search-container">
    <div class="p-4 border-b border-border flex justify-between items-center bg-surface-50">
      <h2 class="font-heading font-semibold text-ink-900">Search Courses</h2>
      <button id="close-search" class="text-ink-500 hover:text-error transition-colors p-1" aria-label="Close search">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="p-4 min-h-[300px]">
      <div id="search-ui" class="w-full"></div>
    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById('search-trigger');
  const modal = document.getElementById('search-modal');
  const container = document.getElementById('search-container');
  const close = document.getElementById('close-search');
  let loaded = false;

  const openModal = async () => {
    if (!modal) return;
    modal.classList.remove('hidden');
    // Allow paint
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      container?.classList.remove('-translate-y-4');
    });

    if (!loaded) {
      // Load standard pagefind CSS/JS from built assets
      try {
        // Create CSS link
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/_pagefind/pagefind-ui.css';
        document.head.appendChild(link);
        
        // Load UI script, ignoring Vite build step since pagefind runs post-build
        const { PagefindUI } = await import(/* @vite-ignore */ '/_pagefind/pagefind-ui.js' as any);
        new PagefindUI({ element: "#search-ui", showSubResults: true });
        loaded = true;
      } catch (e) {
        console.error('Pagefind not found. Make sure you build the site first.', e);
        const el = document.getElementById('search-ui');
        if (el) el.innerHTML = '<p class="text-error">Search is only available in the production build.</p>';
      }
    }
  };

  const closeModal = () => {
    modal?.classList.add('opacity-0');
    container?.classList.add('-translate-y-4');
    setTimeout(() => {
      modal?.classList.add('hidden');
    }, 200);
  };

  trigger?.addEventListener('click', openModal);
  close?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>

<style is:global>
  /* Customise Pagefind UI */
  .pagefind-ui__search-input {
    @apply border-border focus:ring-primary focus:border-primary rounded-lg w-full outline-none p-3;
  }
</style>
