---
export interface Props {
  category: string;
  badge?: string;
  slug?: string;
}

const { 
  category, 
  badge,
  slug
} = Astro.props;

// Fallback logic for badge if not provided
const displayBadge = badge || (slug ? slug.split('-').map(w => w[0]).join('').substring(0, 4).toUpperCase() : 'CC');
const displayCategory = category.replace(/-/g, ' ') || 'Domain';

// Domain pattern matching engine
let theme = "emerald";
let SvgContent = "";

const cat = category.toLowerCase();

if (cat.includes('guidewire')) {
  theme = "emerald";
  SvgContent = `<path d="M50 10 L85 25 L85 75 L50 90 L15 75 L15 25 Z" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="50" cy="50" r="15" fill="none" stroke="currentColor" stroke-width="3"/><line x1="50" y1="10" x2="50" y2="35" stroke="currentColor" stroke-width="3"/><line x1="15" y1="25" x2="38" y2="42" stroke="currentColor" stroke-width="3"/><line x1="85" y1="25" x2="62" y2="42" stroke="currentColor" stroke-width="3"/>`;
} else if (cat.includes('siemens') || cat.includes('teamcenter') || cat.includes('polarion')) {
  theme = "cyan";
  SvgContent = `<rect x="10" y="10" width="80" height="80" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 30 H90 M10 50 H90 M10 70 H90 M30 10 V90 M50 10 V90 M70 10 V90" stroke="currentColor" stroke-width="0.5" opacity="0.6"/><circle cx="50" cy="50" r="25" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="50" cy="50" r="15" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="4 4"/>`;
} else if (cat.includes('cloud') || cat.includes('devops')) {
  theme = "sky";
  SvgContent = `<path d="M30 50 C30 20, 70 20, 70 50 C70 80, 30 80, 30 50" fill="none" stroke="currentColor" stroke-width="4"/><circle cx="30" cy="50" r="8" fill="currentColor"/><circle cx="70" cy="50" r="8" fill="currentColor"/><path d="M10 50 Q 30 30 50 50 T 90 50" fill="none" stroke="currentColor" stroke-width="2" opacity="0.5"/>`;
} else if (cat.includes('data') || cat.includes('trending')) {
  theme = "indigo";
  SvgContent = `<path d="M20 80 L50 20 L80 80 M50 20 L50 80 M20 80 L80 80" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="50" cy="20" r="6" fill="currentColor"/><circle cx="20" cy="80" r="6" fill="currentColor"/><circle cx="80" cy="80" r="6" fill="currentColor"/><circle cx="50" cy="80" r="6" fill="currentColor"/><circle cx="35" cy="50" r="5" fill="currentColor"/><circle cx="65" cy="50" r="5" fill="currentColor"/>`;
} else if (cat.includes('sap') || cat.includes('oracle') || cat.includes('ms-d365') || cat.includes('microsoft')) {
  theme = "amber";
  SvgContent = `<rect x="25" y="20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3"/><rect x="55" y="20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3"/><rect x="25" y="48" width="50" height="20" fill="none" stroke="currentColor" stroke-width="3"/><rect x="25" y="76" width="20" height="4" fill="currentColor"/><rect x="55" y="76" width="20" height="4" fill="currentColor"/>`;
} else {
  theme = "slate";
  SvgContent = `<circle cx="50" cy="50" r="40" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="50" cy="50" r="25" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="50" cy="50" r="10" fill="currentColor"/><line x1="50" y1="0" x2="50" y2="100" stroke="currentColor" stroke-width="1.5"/><line x1="0" y1="50" x2="100" y2="50" stroke="currentColor" stroke-width="1.5"/>`;
}

// Color mapping to ensure Tailwind compiles all classes
const colors = {
  emerald: { bg: "bg-emerald-50", border: "border-emerald-200", text: "text-emerald-800", dot: "bg-emerald-500", icon: "text-emerald-500", emblem: "text-emerald-600", watermark: "text-emerald-600" },
  cyan: { bg: "bg-cyan-50", border: "border-cyan-200", text: "text-cyan-800", dot: "bg-cyan-500", icon: "text-cyan-500", emblem: "text-cyan-600", watermark: "text-cyan-600" },
  sky: { bg: "bg-sky-50", border: "border-sky-200", text: "text-sky-800", dot: "bg-sky-500", icon: "text-sky-500", emblem: "text-sky-600", watermark: "text-sky-600" },
  indigo: { bg: "bg-indigo-50", border: "border-indigo-200", text: "text-indigo-800", dot: "bg-indigo-500", icon: "text-indigo-500", emblem: "text-indigo-600", watermark: "text-indigo-600" },
  amber: { bg: "bg-amber-50", border: "border-amber-200", text: "text-amber-800", dot: "bg-amber-500", icon: "text-amber-500", emblem: "text-amber-600", watermark: "text-amber-600" },
  slate: { bg: "bg-slate-100", border: "border-slate-300", text: "text-slate-800", dot: "bg-slate-500", icon: "text-slate-500", emblem: "text-slate-600", watermark: "text-slate-400" },
};
const c = colors[theme as keyof typeof colors] || colors.slate;
---
<div class="w-full aspect-[16/10] sm:aspect-[16/9] max-h-[210px] relative rounded-2xl overflow-hidden shadow-sm border border-slate-200 bg-white group flex flex-col">
  
  <!-- Dynamic SVG Background Watermark -->
  <div class={`absolute inset-0 opacity-15 sm:opacity-20 pointer-events-none overflow-hidden flex items-center justify-end ${c.watermark} pr-6 sm:pr-12`}>
    <svg viewBox="0 0 100 100" class="w-48 h-48 sm:w-64 sm:h-64 scale-125 transform translate-x-1/4 sm:translate-x-0 group-hover:scale-110 transition-transform duration-700 ease-out">
      <Fragment set:html={SvgContent} />
    </svg>
  </div>
  
  <!-- Content Area -->
  <div class="relative z-10 flex-1 p-5 sm:p-7 flex flex-col justify-center">
    <div class="flex items-center gap-5">
      
      <!-- Short-Code Emblem -->
      <div class="shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-white shadow-md border border-slate-100 flex items-center justify-center relative">
        <div class={`absolute inset-0 rounded-2xl opacity-10 ${c.bg}`}></div>
        <span class={`font-extrabold text-xl sm:text-2xl tracking-wider ${c.emblem}`}>{displayBadge}</span>
      </div>
      
      <!-- Domain Pill & Assurance Markers -->
      <div class="flex flex-col gap-2.5 items-start">
        
        <!-- Category Pill -->
        <div class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full ${c.bg} border ${c.border}`}>
          <div class={`w-2 h-2 rounded-full ${c.dot} animate-pulse`}></div>
          <span class={`text-[11px] sm:text-xs font-bold uppercase tracking-widest ${c.text}`}>
            {displayCategory}
          </span>
        </div>
        
        <!-- Verification Badges -->
        <div class="flex flex-col gap-1.5">
          <div class="text-[11px] sm:text-xs font-semibold text-slate-600 bg-slate-50/80 backdrop-blur-sm px-2.5 py-1 rounded border border-slate-200 shadow-sm flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Live Sandbox Environment
          </div>
          <div class="text-[11px] sm:text-xs font-semibold text-slate-600 bg-slate-50/80 backdrop-blur-sm px-2.5 py-1 rounded border border-slate-200 shadow-sm flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Production Project Syllabus
          </div>
        </div>
      </div>
      
    </div>
  </div>

  <!-- Footer Strip -->
  <div class="h-12 border-t border-slate-100 bg-slate-50/50 backdrop-blur-md flex items-center px-5 sm:px-7 justify-between mt-auto">
    <div class="flex items-center gap-4 sm:gap-6">
      <div class="flex items-center gap-1.5">
        <svg class={`w-4 h-4 ${c.icon}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-[10px] sm:text-[11px] font-bold text-slate-600 uppercase tracking-wide">100% Practical Labs</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class={`w-4 h-4 ${c.icon}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-[10px] sm:text-[11px] font-bold text-slate-600 uppercase tracking-wide">Enterprise Grade</span>
      </div>
    </div>
  </div>
</div>
