---
export interface Props {
  title: string;
  badge?: string;
  category?: string;
}

const { 
  title, 
  badge, 
  category 
} = Astro.props;

// Fallback logic for badge if not provided
const displayBadge = badge || (title.split(' ').map(w => w[0]).join('').substring(0, 3).toUpperCase());
const displayCategory = category || 'Domain';
---
<div class="w-full aspect-[16/10] sm:aspect-video relative rounded-2xl overflow-hidden shadow-xl border border-slate-200 bg-slate-900 group">
  
  <!-- Ambient Underlay Glow -->
  <div class="absolute inset-0 bg-slate-900 overflow-hidden pointer-events-none">
    <div class="absolute -top-1/2 -left-1/2 w-full h-full bg-emerald-500/20 rounded-full blur-3xl transform group-hover:scale-110 transition-transform duration-700"></div>
    <div class="absolute -bottom-1/2 -right-1/2 w-full h-full bg-teal-500/10 rounded-full blur-3xl transform group-hover:scale-110 transition-transform duration-700 delay-150"></div>
  </div>

  <!-- Geometric SVG Background Mesh -->
  <svg class="absolute inset-0 w-full h-full opacity-20 pointer-events-none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="grid-mesh" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" class="text-emerald-500" stroke-width="1" stroke-opacity="0.3"/>
        <circle cx="40" cy="40" r="1" class="fill-emerald-500" opacity="0.5" />
      </pattern>
      <pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1" class="fill-slate-400" opacity="0.3"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#dots)" />
    <rect width="100%" height="100%" fill="url(#grid-mesh)" />
  </svg>

  <!-- Glassmorphic Surface & Content -->
  <div class="relative w-full h-full flex flex-col z-10">
    
    <!-- Window Chrome / Top Bar -->
    <div class="h-10 border-b border-white/10 bg-white/5 backdrop-blur-md flex items-center px-4 justify-between">
      <div class="flex gap-1.5">
        <div class="w-2.5 h-2.5 rounded-full bg-slate-600/50"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-slate-600/50"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-slate-600/50"></div>
      </div>
      <div class="text-[10px] font-mono text-slate-400 uppercase tracking-widest bg-slate-800/50 px-2 py-0.5 rounded border border-white/5">
        system.preview
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 p-6 sm:p-8 flex flex-col justify-center relative">
      
      <!-- Category Tag -->
      <div class="mb-5 flex items-center">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 backdrop-blur-sm">
          <div class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></div>
          <span class="text-xs font-semibold text-emerald-300 uppercase tracking-wider">{displayCategory}</span>
        </div>
      </div>

      <!-- Identity Block -->
      <div class="flex items-start gap-4 sm:gap-5 mb-2">
        <div class="hidden sm:flex shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-600 items-center justify-center shadow-lg shadow-emerald-500/20 border border-white/10">
          <span class="text-white font-bold text-sm tracking-wide">{displayBadge}</span>
        </div>
        <div class="flex-1 min-w-0 flex flex-col justify-center">
          <!-- Text wrapping and semantic HTML for title -->
          <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white tracking-tight leading-tight break-words" style="word-break: break-word;">
            {title}
          </h2>
        </div>
      </div>
    </div>

    <!-- Status Verification Strip -->
    <div class="h-10 bg-black/20 backdrop-blur-md border-t border-white/10 flex items-center px-6 mt-auto">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-xs font-medium text-slate-300">Enterprise Syllabus · Verified Cohort</span>
      </div>
    </div>

  </div>
</div>
