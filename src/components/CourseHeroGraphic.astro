---
import categoriesData from '../content/categories.json';

export interface Props {
  category?: string;
  courseTitle?: string;
  heroTagline?: string;
}

const { category = 'default', courseTitle, heroTagline } = Astro.props;

const catKey = category.toLowerCase();
const categoryMeta = (categoriesData as Record<string, any>)[catKey];

// Setup fallback map (Tier 3)
const domainArchetypeFallback: Record<string, string> = {
  'guidewire': 'P&C insurance core platform coverage across PolicyCenter, ClaimCenter, and BillingCenter.',
  'siemens': 'Digital enterprise lifecycle management, Active Workspace client, and industrial engineering workflows.',
  'cloud-computing': 'Enterprise cloud architecture, multi-tenant CRM, and scalable data cloud warehousing.',
  'devops': 'Automated CI/CD pipelines, container orchestration, and infrastructure as code across cloud ecosystems.',
  'development': 'Full-stack architecture, backend enterprise APIs, and modern responsive frontend engineering.',
  'sap': 'Enterprise resource planning, financial accounting (FICO), materials management, and sales distribution.',
  'oracle': 'Fusion cloud financials, human capital management, and core banking technology architectures.',
  'ms-d365': 'Cloud ERP and CRM customization, financial operations, and enterprise technical development.',
  'microsoft-dynamics-365': 'Cloud ERP and CRM customization, financial operations, and enterprise technical development.',
  'trending-courses': 'Next-generation AI, predictive data science, enterprise intelligence, and defensive cybersecurity.',
  'new-courses': 'Emerging procurement automation, supply chain planning, and modern digital marketing ecosystems.',
  'other-tools': 'Enterprise low-code BPM, modern automated software testing, and agile delivery tools.'
};

let domainLabel = categoryMeta?.label || "Professional Program";
let IconSvg = "";

// Icon mapping (since this is graphic)
if (catKey.includes('guidewire')) {
  // Minimalist Shield with geometric node lines
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`;
} else if (catKey.includes('siemens') || catKey.includes('teamcenter') || catKey.includes('polarion')) {
  // Clean mechanical gear
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><circle cx="12" cy="12" r="3" stroke-linecap="round" stroke-linejoin="round" />`;
} else if (catKey.includes('cloud')) {
  // Concentric cloud nodes
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />`;
} else if (catKey.includes('devops')) {
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />`;
} else if (catKey.includes('data') || catKey.includes('trending')) {
  // Geometric cube or interconnected neural matrix
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />`;
} else if (catKey.includes('sap')) {
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />`;
} else if (catKey.includes('oracle')) {
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />`;
} else if (catKey.includes('ms-d365') || catKey.includes('microsoft')) {
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />`;
} else if (catKey.includes('new-courses')) {
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`;
} else if (catKey.includes('development')) {
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`;
} else {
  // Universal abstract architecture emblem
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`;
}

// Resolution logic
let resolvedTagline = '';
if (heroTagline) {
  resolvedTagline = heroTagline;
} else if (categoryMeta?.intro) {
  resolvedTagline = categoryMeta.intro.split('\n')[0].trim();
} else {
  resolvedTagline = domainArchetypeFallback[catKey] || domainArchetypeFallback['other-tools'];
}

// Fallback truncate to ~120 characters if necessary to preserve whitespace
if (resolvedTagline.length > 130) {
  resolvedTagline = resolvedTagline.substring(0, 127) + '...';
}
---
<div class="relative overflow-hidden rounded-2xl border border-slate-800 bg-slate-950 aspect-[16/9] min-h-[220px] max-h-[340px] flex flex-col items-center justify-between p-6 w-full shadow-md shadow-slate-950/20">

  <!-- Layer 1 & 2: Midnight Canvas, Aurora Spotlight, Concentric Geometry -->
  <div class="absolute inset-0 pointer-events-none z-0">
    <!-- Aurora Radial Spotlight -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(16,185,129,0.18)_0%,rgba(10,15,29,0)_70%)]"></div>
    
    <!-- Embedded Dark Blueprint Pattern & Orbital Geometry -->
    <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="dotPatternDark" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" class="fill-slate-700/80" />
        </pattern>
      </defs>
      
      <!-- Pattern Base -->
      <rect width="100%" height="100%" fill="url(#dotPatternDark)" />
      
      <!-- Concentric Orbital Rings -->
      <circle cx="50%" cy="50%" r="60" stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="3 3" fill="none" />
      <circle cx="50%" cy="50%" r="95" stroke="rgba(255,255,255,0.04)" stroke-width="1" fill="none" />
      
      <!-- Satellite Accent Dots (Inner Ring, r=60) -->
      <circle cx="calc(50% + 42px)" cy="calc(50% - 42px)" r="1.5" fill="#34d399" opacity="0.8" />
      <circle cx="calc(50% - 42px)" cy="calc(50% + 42px)" r="1.5" fill="#ffffff" opacity="0.4" />
    </svg>

    <!-- Corner Precision Crosshairs -->
    <svg class="absolute top-3 left-3 w-2 h-2 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2v20m10-10H2" /></svg>
    <svg class="absolute top-3 right-3 w-2 h-2 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2v20m10-10H2" /></svg>
    <svg class="absolute bottom-3 left-3 w-2 h-2 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2v20m10-10H2" /></svg>
    <svg class="absolute bottom-3 right-3 w-2 h-2 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2v20m10-10H2" /></svg>
  </div>

  <div class="relative z-10 flex flex-col items-center w-full flex-1 justify-center pt-2">
    <!-- Layer 3: Luminous Frosted-Glass Central Emblem -->
    <div class="h-16 w-16 sm:h-18 sm:w-18 rounded-2xl bg-white/[0.07] backdrop-blur-md border border-white/20 ring-1 ring-emerald-500/30 shadow-[0_0_25px_rgba(16,185,129,0.2),inset_0_1px_1px_rgba(255,255,255,0.2)] flex items-center justify-center transition-transform duration-300 hover:scale-105 mb-4">
      <svg class="h-7 w-7 sm:h-8 sm:w-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.85">
        <Fragment set:html={IconSvg} />
      </svg>
    </div>

    <!-- Layer 4: Floating Glass Status Badge -->
    <div class="mb-2">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/[0.06] border border-white/10 shadow-sm backdrop-blur-md text-[10px] sm:text-[11px] font-semibold text-slate-200 tracking-widest uppercase">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_#34d399]"></span>
        {domainLabel}
      </span>
    </div>
  </div>

  <!-- Layer 5: Contextual Micro-Copy -->
  <div class="relative z-10 w-full border-t border-white/5 pt-4 mt-auto">
    <p class="text-xs sm:text-[13px] text-slate-300/90 leading-relaxed text-center max-w-xs sm:max-w-sm mx-auto">
      {resolvedTagline}
    </p>
  </div>

</div>
