---
export interface Props {
  category: string;
  courseTitle?: string;
}

const { category, courseTitle } = Astro.props;

// Dynamically resolve domain identity from category
let domainTitle = "Professional Tech Program";
let IconSvg = "";

const cat = category.toLowerCase();

if (cat.includes('guidewire')) {
  domainTitle = "Insurance Technology";
  // Policy & Claim Protection Shield
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`;
} else if (cat.includes('cloud') || cat.includes('devops')) {
  domainTitle = "Cloud & DevOps";
  // Cloud Infrastructure & Deployment Rocket
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />`;
} else if (cat.includes('data') || cat.includes('trending')) {
  domainTitle = "Data Analytics & AI";
  // Growth Analytics & Neural Network
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />`;
} else if (cat.includes('sap') || cat.includes('oracle') || cat.includes('ms-d365') || cat.includes('microsoft')) {
  domainTitle = "Enterprise Business Systems";
  // Global Architecture & Systems
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`;
} else {
  domainTitle = "Professional Tech Program";
  // Verified Career Track
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />`;
}
---
<div class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-gradient-to-b from-white to-slate-50/80 shadow-sm flex flex-col w-full aspect-[16/10] sm:aspect-[16/9] max-h-[220px]">
  
  <!-- Background Ambience -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute -top-10 -left-10 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl"></div>
  </div>

  <!-- Core Illustrated SVG Scene -->
  <div class="relative z-10 flex-1 flex items-center justify-center p-4">
    <svg viewBox="0 0 400 240" class="w-full h-auto max-h-[160px]" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
      
      <!-- The Learning Canvas (Stylized Laptop) -->
      <g transform="translate(100, 50)">
        <!-- Screen -->
        <rect x="0" y="0" width="200" height="120" rx="8" fill="#f8fafc" stroke="#cbd5e1" stroke-width="3"/>
        <!-- Base -->
        <path d="M-20 120 L220 120 L230 135 L-30 135 Z" fill="#e2e8f0" stroke="#cbd5e1" stroke-width="2"/>
        <rect x="80" y="120" width="40" height="4" fill="#94a3b8" rx="2"/>
        
        <!-- Dashboard Curves -->
        <path d="M 20 90 Q 60 70 100 80 T 180 40" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" opacity="0.7"/>
        <path d="M 20 100 Q 80 90 120 70 T 180 60" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-dasharray="4 4" opacity="0.6"/>
        
        <!-- Domain Icon Center -->
        <g transform="translate(80, 30)" class="text-slate-700">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <Fragment set:html={IconSvg} />
          </svg>
        </g>
      </g>

      <!-- The Accreditation Seal -->
      <g transform="translate(280, 30)">
        <!-- Ribbon -->
        <path d="M 15 40 L 10 70 L 25 60 L 40 70 L 35 40 Z" fill="#10b981" opacity="0.9"/>
        <!-- Gold Badge -->
        <circle cx="25" cy="25" r="20" fill="#f59e0b" stroke="#fff" stroke-width="3"/>
        <circle cx="25" cy="25" r="14" fill="none" stroke="#fff" stroke-width="1" stroke-dasharray="2 2"/>
        <!-- Star motif -->
        <path d="M 25 15 L 28 21 L 34 22 L 29 26 L 31 33 L 25 29 L 19 33 L 21 26 L 16 22 L 22 21 Z" fill="#fff"/>
      </g>

      <!-- Career Floater Badges -->
      <!-- Top-Left Pill -->
      <g transform="translate(30, 40)">
        <rect x="0" y="0" width="120" height="28" rx="14" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5"/>
        <text x="60" y="18" font-family="sans-serif" font-size="11" font-weight="bold" fill="#0f172a" text-anchor="middle">★ 4.9/5 Mentorship</text>
      </g>

      <!-- Top-Right Pill -->
      <g transform="translate(240, 110)">
        <rect x="0" y="0" width="145" height="28" rx="14" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5"/>
        <text x="72" y="18" font-family="sans-serif" font-size="11" font-weight="bold" fill="#0f172a" text-anchor="middle">Live Project Experience</text>
      </g>

      <!-- Bottom Badge -->
      <g transform="translate(40, 150)">
        <rect x="0" y="0" width="165" height="28" rx="6" fill="#10b981" opacity="0.1"/>
        <rect x="0" y="0" width="165" height="28" rx="6" fill="none" stroke="#10b981" stroke-width="1.5" opacity="0.3"/>
        <text x="82" y="18" font-family="sans-serif" font-size="11" font-weight="bold" fill="#047857" text-anchor="middle">100% Job-Oriented Program</text>
      </g>

      <!-- Domain Title Floating -->
      <g transform="translate(200, 20)">
        <rect x="-80" y="0" width="160" height="24" rx="12" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1"/>
        <text x="0" y="16" font-family="sans-serif" font-size="10" font-weight="bold" fill="#475569" text-anchor="middle" letter-spacing="0.5">{domainTitle.toUpperCase()}</text>
      </g>

    </svg>
  </div>

  <!-- Bottom Assurance Strip -->
  <div class="h-12 border-t border-slate-200/60 bg-white/50 backdrop-blur-sm flex items-center px-4 sm:px-6 justify-between mt-auto">
    <div class="flex items-center gap-4 sm:gap-6">
      <div class="flex items-center gap-1.5">
        <div class="w-4 h-4 rounded-full bg-emerald-100 flex items-center justify-center shrink-0">
          <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <span class="text-[11px] sm:text-xs font-bold text-slate-700">Accredited Curriculum</span>
      </div>
      <div class="flex items-center gap-1.5">
        <div class="w-4 h-4 rounded-full bg-amber-100 flex items-center justify-center shrink-0">
          <svg class="w-3 h-3 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <span class="text-[11px] sm:text-xs font-bold text-slate-700">Industry Practitioner Led</span>
      </div>
    </div>
  </div>
</div>
