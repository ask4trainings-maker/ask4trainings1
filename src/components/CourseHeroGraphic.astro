---
export interface Props {
  category?: string;
  courseTitle?: string;
}

const { category = 'default', courseTitle } = Astro.props;

let domainLabel = "Professional Tech Program";
let IconSvg = "";

const cat = category.toLowerCase();

if (cat.includes('guidewire')) {
  domainLabel = "Insurance Technology";
  // Minimalist Shield with geometric node lines
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`;
} else if (cat.includes('siemens') || cat.includes('teamcenter') || cat.includes('polarion')) {
  domainLabel = "Product Lifecycle Management";
  // Clean mechanical gear
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><circle cx="12" cy="12" r="3" stroke-linecap="round" stroke-linejoin="round" />`;
} else if (cat.includes('cloud') || cat.includes('devops')) {
  domainLabel = "Cloud & DevOps";
  // Concentric cloud nodes
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />`;
} else if (cat.includes('data') || cat.includes('trending')) {
  domainLabel = "Data Analytics & AI";
  // Geometric cube or interconnected neural matrix
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />`;
} else if (cat.includes('sap') || cat.includes('oracle') || cat.includes('ms-d365') || cat.includes('microsoft')) {
  domainLabel = "Enterprise Systems";
  // Database cylinder / Modular stack
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />`;
} else {
  domainLabel = "Professional Tech Program";
  // Universal abstract architecture emblem
  IconSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`;
}
---
<div class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white aspect-[16/9] min-h-[190px] max-h-[260px] flex flex-col items-center justify-center p-6 w-full">

  <!-- Layer 1: Ambient Background & Subtle Geometric Grid -->
  <div class="absolute inset-0 pointer-events-none z-0">
    <!-- Option A: Subtle Dot Matrix -->
    <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="dotPattern" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" class="fill-slate-300/60" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#dotPattern)" />
    </svg>
    
    <!-- Central Spotlight Glow -->
    <div 
      class="absolute inset-0"
      style="background: radial-gradient(circle at center, rgba(16, 185, 129, 0.14) 0%, rgba(255, 255, 255, 0) 70%);"
    ></div>
  </div>

  <!-- Layer 2: Elevated Central Brand Emblem -->
  <div class="h-16 w-16 sm:h-20 sm:w-20 rounded-2xl bg-white/95 border border-slate-200/90 shadow-lg shadow-slate-200/60 backdrop-blur-md flex items-center justify-center relative z-10 transition-transform duration-300 hover:scale-105 ring-1 ring-emerald-500/20">
    <svg class="w-8 h-8 sm:w-10 sm:h-10 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
      <Fragment set:html={IconSvg} />
    </svg>
  </div>

  <!-- Layer 3: Minimal Domain Identifier -->
  <div class="mt-4 relative z-10">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-50 border border-slate-200/80 text-[11px] font-semibold text-slate-600 tracking-wide shadow-xs">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
      {domainLabel.toUpperCase()}
    </span>
  </div>

</div>
