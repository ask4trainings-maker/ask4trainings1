---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import { getOrganizationSchema } from '../utils/seoSchema';

export interface Props {
  title: string;
  description?: string;
  courseName?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: string;
}

const { 
  title, 
  description = 'Ask 4 Trainings - Leading IT Training Institute in Hyderabad', 
  courseName,
  image,
  type = 'website',
  publishDate
} = Astro.props;

// Canonical URL Construction
let pathname = Astro.url.pathname;
if (!pathname.endsWith('/') && !pathname.match(/\.[a-z0-9]+$/i)) {
  pathname += '/';
}
const canonicalUrl = new URL(pathname, Astro.site || 'https://ask4trainings.com').href;
const orgSchema = getOrganizationSchema();
const resolvedOgImage = new URL(image || '/og-default.jpg', Astro.site || 'https://ask4trainings.com').href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Preload Critical Font -->
    <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href="/fonts/geist-latin-wght-normal.woff2" fetchpriority="high" />
    <link rel="preconnect" href="https://ui-avatars.com" />
    <link rel="dns-prefetch" href="https://ui-avatars.com" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="Ask4Trainings" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {type === 'article' && publishDate && <meta property="article:published_time" content={publishDate} />}

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Google Search Console Verification -->
    {import.meta.env.PUBLIC_GSC_VERIFICATION_ID && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION_ID} />
    )}

    <!-- Google Analytics 4 -->
    {import.meta.env.PUBLIC_GA_MEASUREMENT_ID && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_MEASUREMENT_ID}`}></script>
      <script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId, { 'anonymize_ip': true });
      </script>
    )}

    <!-- Global Conversion Telemetry -->
    <script>
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const anchor = target.closest('a');
        if (!anchor || typeof (window as any).gtag !== 'function') return;

        const href = anchor.getAttribute('href') || '';
        
        // WhatsApp Clicks
        if (href.includes('wa.me') || href.includes('whatsapp.com')) {
          const location = anchor.closest('header') ? 'header' :
                           anchor.closest('footer') ? 'footer' :
                           anchor.closest('.fixed') ? 'floating_button' : 'content';
          (window as any).gtag('event', 'click_whatsapp_cta', {
            link_url: href,
            button_location: location
          });
        }
        
        // Student Portal Clicks
        if (href.includes('student-portal') || href.includes('lms')) {
          (window as any).gtag('event', 'click_student_portal');
        }

        // Contact Clicks (Phone/Email)
        if (href.startsWith('tel:')) {
          (window as any).gtag('event', 'click_contact_lead', { contact_type: 'phone' });
        } else if (href.startsWith('mailto:')) {
          (window as any).gtag('event', 'click_contact_lead', { contact_type: 'email' });
        }
      });
    </script>

    <!-- Organization / LocalBusiness Schema -->
    <SchemaOrg schema={orgSchema} />

    <slot name="head" />
    <style is:global>
      @font-face {
        font-family: 'Geist Variable';
        font-style: normal;
        font-display: swap;
        font-weight: 100 900;
        src: url('/fonts/geist-latin-wght-normal.woff2') format('woff2-variations');
      }
      html {
        scroll-behavior: smooth;
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
      body {
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      ::selection {
        background-color: theme('colors.emerald.600');
        color: white;
      }
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: theme('colors.slate.900');
      }
      ::-webkit-scrollbar-thumb {
        background: theme('colors.slate.500');
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: theme('colors.emerald.600');
      }
      
      /* Hide scrollbar for elements with .no-scrollbar */
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;  /* Firefox */
      }

      @media (max-width: 767px) {
        h1, h2, h3, h4, h5, h6 {
          text-align: center;
        }
        p {
          text-align: left;
          font-size: 0.95rem !important;
          line-height: 1.6 !important;
          letter-spacing: -0.01em !important;
          color: #7e8a9d !important;
          margin-bottom: 1rem;
        }
        li:not(nav li) {
          font-size: 0.95rem;
          line-height: 1.6;
          letter-spacing: -0.01em;
          color: #374151;
        }
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 font-body antialiased flex flex-col min-h-screen selection:bg-emerald-600 selection:text-white relative overflow-x-clip">
    <!-- Ambient Background Texture -->
    <div class="fixed inset-0 pointer-events-none -z-20 bg-slate-50 bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:24px_24px] [mask-image:radial-gradient(ellipse_at_center,transparent_20%,black)]"></div>
    <div class="fixed top-0 left-1/4 w-96 h-96 bg-emerald-400/5 blur-[120px] rounded-full pointer-events-none -z-10"></div>
    <div class="fixed bottom-0 right-1/4 w-96 h-96 bg-emerald-400/5 blur-[120px] rounded-full pointer-events-none -z-10"></div>
    
    <Header />
    <main class="flex-grow pb-15 md:pb-0 relative w-full min-w-0">
      <slot />
    </main>
    <Footer />
    <StickyMobileBar courseName={courseName} />
    <WhatsAppButton courseName={courseName} />
  </body>
</html>
