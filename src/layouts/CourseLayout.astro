---
import BaseLayout from './BaseLayout.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import SyllabusAccordion from '../components/SyllabusAccordion.astro';

export interface Props {
  title: string;
  category: string;
  duration: string;
  format: string;
  valueProp: string;
  syllabus: { module: string; topics: string[] }[];
}

const { title, category, duration, format, valueProp, syllabus } = Astro.props;
---
<BaseLayout title={`${title} | Ask 4 Trainings`} description={valueProp}>
  <div class="bg-surface-50 border-b border-border py-12 md:py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-4">
          <a href="/" class="text-sm text-ink-500 hover:text-primary transition-colors">Home</a>
          <span class="text-ink-500 text-sm">/</span>
          <a href={`/courses/${category}`} class="text-sm text-ink-500 hover:text-primary capitalize transition-colors">{category.replace('-', ' ')}</a>
        </div>
        <h1 class="text-3xl md:text-5xl font-heading font-bold text-ink-900 mb-4 leading-tight">{title}</h1>
        <p class="text-lg md:text-xl text-ink-700 mb-8">{valueProp}</p>
        <div class="flex flex-wrap gap-4 items-center">
          <WhatsAppCTA courseName={title} className="px-6 py-3 text-lg" />
          <button class="bg-accent hover:bg-accent-hover text-surface-0 font-medium px-6 py-3 rounded-lg transition-colors text-lg">
            Download Syllabus
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-12 flex flex-col lg:flex-row gap-12 relative">
    <div class="lg:w-2/3">
      <h2 class="text-2xl font-heading font-bold text-ink-900 mb-6">Course Syllabus</h2>
      <SyllabusAccordion syllabus={syllabus} />
    </div>

    <div class="lg:w-1/3">
      <div class="sticky top-24 bg-surface-0 border border-border rounded-xl p-6 shadow-sm">
        <h3 class="text-xl font-heading font-bold text-ink-900 mb-4">Quick Facts</h3>
        <ul class="space-y-3 mb-8 text-ink-700">
          <li class="flex justify-between border-b border-surface-100 pb-2">
            <span class="font-medium text-ink-500">Duration</span>
            <span>{duration}</span>
          </li>
          <li class="flex justify-between border-b border-surface-100 pb-2">
            <span class="font-medium text-ink-500">Format</span>
            <span>{format}</span>
          </li>
        </ul>

        <h3 class="text-xl font-heading font-bold text-ink-900 mb-4">Enquire Now</h3>
        <div class="bg-surface-50 p-4 rounded-lg text-center text-ink-500 border border-dashed border-border text-sm">
          Enquiry Form Component Here
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
