---
import BaseLayout from './BaseLayout.astro';
import CourseHero from '../components/course/CourseHero.astro';
import CourseHighlights from '../components/course/CourseHighlights.astro';
import CourseSyllabus from '../components/course/CourseSyllabus.astro';
import CourseProjects from '../components/course/CourseProjects.astro';
import CourseFAQ from '../components/course/CourseFAQ.astro';
import CourseSidebar from '../components/course/CourseSidebar.astro';

export interface Props {
  title: string;
  slug: string;
  category: string;
  duration: string;
  format: string;
  valueProp: string;
  highlights?: { icon: string; text: string }[];
  syllabus: { module: string; topics: string[] }[];
  faqs?: { question: string; answer: string }[];
  seo?: { metaTitle?: string; metaDescription?: string };
}

const { title, slug, category, duration, format, valueProp, highlights = [], syllabus, faqs = [], seo } = Astro.props;
const siteUrl = Astro.site ? Astro.site.toString() : 'https://ask4trainings.pages.dev/';
const metaDesc = seo?.metaDescription || valueProp;

// SEO Metadata (JSON-LD)
const courseSchema = {
  '@type': 'Course',
  name: title, 
  description: valueProp,
  provider: { '@type': 'EducationalOrganization', name: 'Ask 4 Trainings', sameAs: siteUrl },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: format === 'Online' ? 'online' : format === 'Classroom' ? 'onsite' : 'blended'
  }
};
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: category.replace(/-/g, ' '), item: `${siteUrl}courses/${category}` },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};
const faqSchema = faqs.length > 0 ? {
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({ 
    '@type': 'Question', 
    name: faq.question, 
    acceptedAnswer: { '@type': 'Answer', text: faq.answer } 
  }))
} : null;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [courseSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])]
};
---

<BaseLayout title={seo?.metaTitle || `${title} | Ask 4 Trainings`} description={metaDesc} courseName={title}>
  <Fragment slot="head">
    {slug && <link rel="canonical" href={`${siteUrl}${slug}/`} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </Fragment>

  <!-- Modular Hero Component -->
  <CourseHero 
    title={title}
    category={category}
    duration={duration}
    format={format}
    valueProp={valueProp}
  />

  <!-- Main Content: Two-Column Scaler x Codecrafters Layout -->
  <div class="bg-slate-50">
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full py-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-12">
        
        <!-- Left Column: Syllabus & Curriculum Depth (8 Cols) -->
        <div class="lg:col-span-8">
          <slot />
          
          <CourseHighlights highlights={highlights} />
          <CourseSyllabus syllabus={syllabus} />
          <CourseProjects courseName={title} />
          <CourseFAQ faqs={faqs} />
        </div>

        <!-- Right Column: Sticky Conversion Workbench (4 Cols) -->
        <div class="lg:col-span-4 mt-8 lg:mt-0">
          <CourseSidebar 
            courseName={title}
            duration={duration}
            format={format}
          />
        </div>

      </div>
    </div>
  </div>
</BaseLayout>
