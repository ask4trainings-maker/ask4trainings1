---
import BaseLayout from './BaseLayout.astro';
import CourseHero from '../components/course/CourseHero.astro';
import CourseSidebar from '../components/course/CourseSidebar.astro';
import CourseOverview from '../components/course/CourseOverview.astro';
import CourseCurriculum from '../components/course/CourseCurriculum.astro';
import CourseAbout from '../components/course/CourseAbout.astro';
import KeyFeatures from '../components/course/KeyFeatures.astro';
import CourseObjectives from '../components/course/CourseObjectives.astro';
import CourseBenefits from '../components/course/CourseBenefits.astro';
import CourseWhyChoose from '../components/course/CourseWhyChoose.astro';
import CourseEligibility from '../components/course/CourseEligibility.astro';
import CourseCertifications from '../components/course/CourseCertifications.astro';
import CourseJobRoles from '../components/course/CourseJobRoles.astro';
import CourseTrainerProfile from '../components/course/CourseTrainerProfile.astro';
import CourseFAQ from '../components/course/CourseFAQ.astro';
import RelatedCourses from '../components/course/RelatedCourses.astro';
import CourseNavRibbon from '../components/course/CourseNavRibbon.astro';
import CareerRoiCard from '../components/CareerRoiCard.astro';
import { getCourseSchema, getBreadcrumbSchema, getFaqSchema } from '../utils/seoSchema';
import SchemaOrg from '../components/seo/SchemaOrg.astro';

export interface Props {
  course: any;
}

const { course } = Astro.props;
const data = course.data;

const siteUrl = Astro.site ? Astro.site.toString() : 'https://ask4trainings.com/';

let metaDesc = data.seo?.metaDescription || data.heroTagline || data.overview || '';
if (!data.seo?.metaDescription) {
  metaDesc = `Master ${data.title} with live interactive online training, 24/7 cloud sandbox lab access, real-time projects, and certification mentorship at Ask4Trainings. ${metaDesc}`;
}
if (metaDesc.length > 155) {
  metaDesc = metaDesc.substring(0, 152).replace(/\s+\S*$/, '') + '...';
}
const pageTitle = data.seo?.metaTitle || `${data.title} Training in Hyderabad | Live Online - Ask4Trainings`;
// Limit page title length if it exceeds 65 roughly, though the prompt says 50-60
const finalTitle = pageTitle.length > 65 ? (data.seo?.metaTitle || `${data.title} Training | Ask4Trainings`) : pageTitle;

// SEO Metadata (JSON-LD)
const courseSchema = getCourseSchema(data);
const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Home', path: siteUrl },
  { name: data.category?.replace(/-/g, ' ') || 'Courses', path: `${siteUrl}courses/${data.category}/` },
  { name: data.title, path: `${siteUrl}${data.slug}/` }
]);
const faqSchema = getFaqSchema(data.faqs);

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [courseSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])]
};
---

<BaseLayout title={finalTitle} description={metaDesc} courseName={data.title} type="website" image={data.courseImage}>
  <Fragment slot="head">
    <SchemaOrg schema={schemaGraph} />
    {data.courseImage && (
      <link rel="preload" as="image" href={data.courseImage} fetchpriority="high" />
    )}
  </Fragment>

  <!-- Section 1: Hero / Main Section -->
  <CourseHero 
    title={data.title}
    category={data.category}
    duration={data.duration}
    mode={data.mode}
    rating={data.rating}
    valueProp={data.valueProp}
    videoUrl={data.videoUrl}
    courseImage={data.courseImage}
    heroTagline={data.heroTagline}
  />

  <CourseNavRibbon />

  <!-- Section 2: Course Overview & Curriculum (Shared Grid Container) -->
  <section class="bg-slate-50/70 py-14 border-b border-slate-200/60">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start relative">
      <!-- Left Column: Overview + Curriculum -->
      <div class="lg:col-span-7 xl:col-span-8 space-y-12">
        <div id="overview" class="scroll-mt-28">
          <CourseOverview title={data.title} overview={data.overview}>
            <slot />
          </CourseOverview>
        </div>
        <div id="curriculum" class="scroll-mt-28">
          <CourseCurriculum modules={data.modules} courseTitle={data.title} />
        </div>
      </div>

      <!-- Right Column: Sticky Lead Workbench -->
      <div class="lg:col-span-5 xl:col-span-4 lg:sticky lg:top-24 z-20 self-start transition-none">
        <CourseSidebar 
          courseName={data.title}
          duration={data.duration}
          format={data.mode}
        />
      </div>
    </div>
    </div>
  </section>
  <CourseAbout aboutCourse={data.aboutCourse} courseTitle={data.title} category={data.category} whyMaster={data.whyMaster} valueProp={data.valueProp} />
  <KeyFeatures features={data.keyFeatures} courseTitle={data.title} />
  <CourseObjectives objectives={data.objectives} />
  <CourseBenefits benefits={data.benefits} />
  
  {data.whyChooseCourse && (
    <section id="why-choose" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16 border-t border-slate-100">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left Column: Copy & Value Proposition (lg:col-span-7) -->
        <div class="lg:col-span-7 space-y-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600">
            Market Demand & Viability
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight leading-snug">
            Why Choose {data.title}?
          </h2>
          <div class="space-y-4 text-slate-600 text-sm sm:text-base leading-relaxed pt-2">
            {data.whyChooseCourse.split('\n\n').map((para: string) => (
              para.trim() && <p>{para.trim()}</p>
            ))}
          </div>
        </div>

        <!-- Right Column: Career ROI Metric Card (lg:col-span-5) -->
        <div class="lg:col-span-5 w-full mt-6 lg:mt-0">
          <CareerRoiCard category={data.category} courseTitle={data.title} roiMetrics={data.roiMetrics} />
        </div>
      </div>
    </section>
  )}
  
  <CourseWhyChoose whyChoose={data.whyChoose} />
  <CourseEligibility eligibility={data.whoShouldEnroll?.length ? data.whoShouldEnroll : data.eligibility} />
  <CourseCertifications certification={data.certification} courseTitle={data.title} />
  <CourseJobRoles jobRoles={data.jobRoles} />
  <CourseTrainerProfile courseTitle={data.title} trainerProfile={data.trainer || data.trainerProfile} />
  <CourseFAQ faqs={data.faqs} />
  
  <!-- Section 13: Related Courses -->
  <RelatedCourses currentCourseId={course.id} category={data.category} />

  <!-- Back to Top Button -->
  <button id="back-to-top" class="md:hidden fixed bottom-20 right-4 z-40 w-11 h-11 bg-slate-900/90 text-white rounded-full shadow-lg backdrop-blur flex items-center justify-center border border-slate-700 active:scale-95 transition-all opacity-0 pointer-events-none" aria-label="Back to top">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>
</BaseLayout>

<script>
  // Back to top logic
  document.addEventListener('DOMContentLoaded', () => {
    const backToTopBtn = document.getElementById('back-to-top');
    if (backToTopBtn) {
      let _rafScrollTicking = false;
      window.addEventListener('scroll', () => {
        if (!_rafScrollTicking) {
          window.requestAnimationFrame(() => {
            if (window.scrollY > 350) {
              backToTopBtn.classList.remove('opacity-0', 'pointer-events-none');
              backToTopBtn.classList.add('opacity-100', 'pointer-events-auto');
            } else {
              backToTopBtn.classList.add('opacity-0', 'pointer-events-none');
              backToTopBtn.classList.remove('opacity-100', 'pointer-events-auto');
            }
            _rafScrollTicking = false;
          });
          _rafScrollTicking = true;
        }
      }, { passive: true });
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  });
</script>