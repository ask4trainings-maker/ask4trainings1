---
import BaseLayout from './BaseLayout.astro';
import CourseHero from '../components/course/CourseHero.astro';
import CourseSidebar from '../components/course/CourseSidebar.astro';
import CourseOverview from '../components/course/CourseOverview.astro';
import CourseSyllabus from '../components/course/CourseSyllabus.astro';
import CourseAbout from '../components/course/CourseAbout.astro';
import CourseObjectives from '../components/course/CourseObjectives.astro';
import CourseBenefits from '../components/course/CourseBenefits.astro';
import CourseWhyChoose from '../components/course/CourseWhyChoose.astro';
import CourseEligibility from '../components/course/CourseEligibility.astro';
import CourseCertifications from '../components/course/CourseCertifications.astro';
import CourseJobRoles from '../components/course/CourseJobRoles.astro';
import CourseTrainerProfile from '../components/course/CourseTrainerProfile.astro';
import CourseFAQ from '../components/course/CourseFAQ.astro';
import RelatedCourses from '../components/course/RelatedCourses.astro';
import CourseNavRibbon from '../components/course/CourseNavRibbon.astro';

export interface Props {
  course: any;
}

const { course } = Astro.props;
const data = course.data;

const siteUrl = Astro.site ? Astro.site.toString() : 'https://ask4trainings.pages.dev/';
const metaDesc = data.seo?.metaDescription || data.valueProp || data.overview;

// SEO Metadata (JSON-LD)
const courseSchema = {
  '@type': 'Course',
  name: data.title, 
  description: metaDesc,
  provider: { '@type': 'EducationalOrganization', name: 'Ask 4 Trainings', sameAs: siteUrl },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: data.mode?.toLowerCase().includes('online') ? 'online' : 'blended'
  }
};
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: data.category?.replace(/-/g, ' ') || 'Courses', item: `${siteUrl}courses/${data.category}` },
    { '@type': 'ListItem', position: 3, name: data.title },
  ],
};

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [courseSchema, breadcrumbSchema]
};
---

<BaseLayout title={data.seo?.metaTitle || `${data.title} | Ask 4 Trainings`} description={metaDesc} courseName={data.title}>
  <Fragment slot="head">
    {data.slug && <link rel="canonical" href={`${siteUrl}${data.slug}/`} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </Fragment>

  <!-- Section 1: Hero / Main Section -->
  <CourseHero 
    title={data.title}
    category={data.category}
    duration={data.duration}
    mode={data.mode}
    rating={data.rating}
    valueProp={data.valueProp}
    videoUrl={data.videoUrl}
    courseImage={data.courseImage}
  />

  <CourseNavRibbon />

  <!-- Section 2: Course Overview & Curriculum (Shared Grid Container) -->
  <section class="bg-slate-50/70 py-14 border-b border-slate-200/60">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start relative">
      <!-- Left Column: Overview + Curriculum -->
      <div class="lg:col-span-7 xl:col-span-8 space-y-12">
        <div id="overview" class="scroll-mt-28">
          <CourseOverview title={data.title} overview={data.overview}>
            <slot />
          </CourseOverview>
        </div>
        <div id="curriculum" class="scroll-mt-28">
          <CourseSyllabus syllabus={data.syllabus} brochureUrl={data.brochureUrl} />
        </div>
      </div>

      <!-- Right Column: Sticky Lead Workbench -->
      <div class="lg:col-span-5 xl:col-span-4 lg:sticky lg:top-24 z-20 self-start transition-none">
        <CourseSidebar 
          courseName={data.title}
          duration={data.duration}
          format={data.mode}
        />
      </div>
    </div>
    </div>
  </section>
  <CourseAbout aboutCourse={data.aboutCourse} courseTitle={data.title} category={data.category} whyMaster={data.whyMaster} />
  <CourseObjectives objectives={data.objectives} />
  <CourseBenefits benefits={data.benefits} />
  
  {data.whyChooseCourse && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-slate-100">
      <div class="max-w-3xl">
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Course Value</span>
        <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-slate-900 mt-2 mb-4">
          Why Choose {data.title}?
        </h2>
        <div class="space-y-4 text-slate-600 text-sm sm:text-base leading-relaxed">
          {data.whyChooseCourse.split('\n\n').map((para: string) => (
            <p>{para.trim()}</p>
          ))}
        </div>
      </div>
    </section>
  )}
  
  <CourseWhyChoose whyChoose={data.whyChoose} />
  <CourseEligibility eligibility={data.whoShouldEnroll?.length ? data.whoShouldEnroll : data.eligibility} />
  <CourseCertifications certifications={data.certifications} />
  <CourseJobRoles jobRoles={data.jobRoles} />
  <CourseTrainerProfile courseTitle={data.title} trainerProfile={data.trainer || data.trainerProfile} />
  <CourseFAQ faqs={data.faqs} />
  
  <!-- Section 13: Related Courses -->
  <RelatedCourses currentCourseId={course.id} category={data.category} />

  <!-- Back to Top Button -->
  <button id="back-to-top" class="md:hidden fixed bottom-20 right-4 z-40 w-11 h-11 bg-slate-900/90 text-white rounded-full shadow-lg backdrop-blur flex items-center justify-center border border-slate-700 active:scale-95 transition-all opacity-0 pointer-events-none" aria-label="Back to top">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>
</BaseLayout>

<script>
  // Back to top logic
  document.addEventListener('DOMContentLoaded', () => {
    const backToTopBtn = document.getElementById('back-to-top');
    if (backToTopBtn) {
      let _rafScrollTicking = false;
      window.addEventListener('scroll', () => {
        if (!_rafScrollTicking) {
          window.requestAnimationFrame(() => {
            if (window.scrollY > 350) {
              backToTopBtn.classList.remove('opacity-0', 'pointer-events-none');
              backToTopBtn.classList.add('opacity-100', 'pointer-events-auto');
            } else {
              backToTopBtn.classList.add('opacity-0', 'pointer-events-none');
              backToTopBtn.classList.remove('opacity-100', 'pointer-events-auto');
            }
            _rafScrollTicking = false;
          });
          _rafScrollTicking = true;
        }
      }, { passive: true });
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  });
</script>