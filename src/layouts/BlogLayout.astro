---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  publishDate: Date;
  category: string;
}
const { title, publishDate, category } = Astro.props;
const formattedDate = new Date(publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout title={`${title} | Ask 4 Trainings Blog`}>
  <article class="container mx-auto px-4 py-12 max-w-3xl">
    <header class="mb-10 text-center">
      <span class="text-sm font-bold text-primary tracking-wider uppercase mb-4 block">{category}</span>
      <h1 class="text-3xl md:text-5xl font-heading font-bold text-ink-900 mb-6 leading-tight">{title}</h1>
      <p class="text-ink-500 text-sm">Published on <time datetime={publishDate.toISOString()}>{formattedDate}</time></p>
    </header>

    <div class="prose prose-lg prose-slate mx-auto prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-blockquote:border-primary prose-headings:font-heading">
      <slot />
    </div>
  </article>
</BaseLayout>
