---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/CourseCard.astro';
import categoriesData from '../../content/categories.json';
import { getCollection } from 'astro:content';

const allCourses = await getCollection('courses');
const categories = Object.keys(categoriesData).map(key => ({
  key,
  label: (categoriesData as any)[key].label
}));
---
<BaseLayout title="All Courses | Ask 4 Trainings">
  <div class="bg-surface-50 border-b border-border py-16 text-center">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-ink-900 mb-4">Course Catalog</h1>
      <p class="text-lg text-ink-700 max-w-2xl mx-auto">Browse our comprehensive list of enterprise IT training programs designed to accelerate your career.</p>
    </div>
  </div>

  <div class="container mx-auto px-4 py-16">
    <div class="flex flex-wrap gap-2 justify-center mb-12">
      <a href="/courses" class="bg-primary text-surface-0 px-4 py-2 rounded-full text-sm font-medium">All Courses</a>
      {categories.map(cat => (
        <a href={`/courses/${cat.key}`} class="bg-surface-50 hover:bg-surface-100 text-ink-700 border border-border px-4 py-2 rounded-full text-sm font-medium transition-colors">{cat.label}</a>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allCourses.map(course => (
        <CourseCard 
          title={course.data.title}
          category={course.data.category}
          duration={course.data.batchInfo.duration}
          format={course.data.batchInfo.format}
          slug={course.data.slug}
        />
      ))}
    </div>
    
    {allCourses.length === 0 && (
      <div class="text-center py-12 text-ink-500">
        <p>No courses found. Check back later!</p>
      </div>
    )}
  </div>
</BaseLayout>
