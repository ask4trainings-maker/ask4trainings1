---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/CourseCard.astro';
import SearchModal from '../../components/SearchModal.astro';
import categoriesData from '../../content/categories.json';
import categoriesMeta from '../../data/categories.json';
import { getCollection } from 'astro:content';

const allCoursesRaw = await getCollection('courses');

// Sort alphabetically by title
const allCourses = [...allCoursesRaw].sort((a, b) => a.data.title.localeCompare(b.data.title));

// Order category pills by canonical definition order from src/data/categories.json
const categoryOrder = categoriesMeta.categories.map((c: any) => c.id);
const categories = Object.keys(categoriesData)
  .sort((a, b) => {
    const ai = categoryOrder.indexOf(a);
    const bi = categoryOrder.indexOf(b);
    return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
  })
  .map(key => ({
    key,
    label: (categoriesData as any)[key].label
  }));

function cleanTitle(title: string): string {
  return title
    .replace(/^(Best\s+|Course\s+Tag\s*[-–]?\s*|Courses\s*)/i, '')
    .replace(/\s{2,}/g, ' ')
    .trim();
}
---
<BaseLayout title="All Courses | Ask 4 Trainings" description="Browse our comprehensive list of enterprise IT training programs designed to accelerate your career.">
  <!-- Header Section -->
  <div class="bg-slate-50 border-b border-slate-100 py-16 text-center relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-emerald-600/10 rounded-full blur-[120px]"></div>
    </div>
    
    <div class="relative max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-slate-900 mb-4">Course Catalog</h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto mb-10">Browse our comprehensive list of enterprise IT training programs designed to accelerate your career.</p>
      
      <!-- Search Trigger Bar -->
      <div class="max-w-xl mx-auto relative group">
        <button 
          id="catalog-search-trigger"
          class="w-full bg-white/60 backdrop-blur-md border border-white/20 hover:border-emerald-600/50 text-slate-600 px-6 py-4 rounded-xl text-left flex items-center gap-3 transition-all duration-300 hover:shadow-[0_0_20px_rgba(13,110,79,0.2)] focus:outline-none focus:ring-2 focus:ring-emerald-600"
          aria-label="Search courses"
        >
          <svg class="w-6 h-6 text-slate-500 group-hover:text-emerald-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="text-lg">Search for courses, skills, or tools...</span>
          <div class="ml-auto hidden sm:flex items-center gap-1 opacity-60">
            <kbd class="font-sans px-2 py-0.5 bg-slate-100 border border-slate-200 rounded text-xs">Ctrl</kbd>
            <kbd class="font-sans px-2 py-0.5 bg-slate-100 border border-slate-200 rounded text-xs">K</kbd>
          </div>
        </button>
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <div class="bg-slate-50 relative">
    <!-- Observer target -->
    <div id="catalog-grid-top" class="absolute top-0 left-0 w-full h-1 invisible"></div>
    
    <!-- Sticky Ribbon -->
    <div id="sticky-course-ribbon" class="sticky top-0 z-40 w-full bg-slate-50/95 backdrop-blur-md border-b border-transparent transition-all duration-300">
      <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto">
        <div class="flex items-center gap-2 overflow-x-auto scrollbar-none py-3 px-4 sm:justify-center">
          <button data-category="all" class="category-btn bg-slate-900 text-white font-semibold text-xs md:text-sm px-4 py-2 rounded-xl shadow-sm whitespace-nowrap transition-colors">All Courses</button>
          {categories.map(cat => (
            <button data-category={cat.key} class="category-btn bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs md:text-sm px-4 py-2 rounded-xl whitespace-nowrap transition-colors">{cat.label}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full py-12">
      <!-- Course Grid -->
      <div id="course-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allCourses.map(course => (
          <CourseCard 
            title={cleanTitle(course.data.title)}
            category={course.data.category}
            duration={course.data.duration}
            mode={course.data.mode}
            slug={course.data.slug}
          />
        ))}
      </div>
      
      <!-- Empty State -->
      <div id="empty-state" class="hidden text-center py-20 text-slate-500">
        <svg class="w-16 h-16 mx-auto text-slate-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-xl font-semibold text-slate-700 mb-2">No courses found</h3>
        <p class="text-slate-500 max-w-md mx-auto mb-6">We couldn't find any courses matching your selected criteria. Try adjusting your filters.</p>
        <button id="clear-filters-btn" class="text-emerald-600 hover:text-emerald-700 font-medium hover:underline">Clear all filters</button>
      </div>
    </div>
  </div>

  <SearchModal />

  <script>
    // Search trigger logic
    document.getElementById('catalog-search-trigger')?.addEventListener('click', () => {
      const modal = document.getElementById('search-modal');
      const input = document.getElementById('search-input');
      if (modal && input) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        input.focus();
      }
    });

    // Filtering State
    let activeCategory = 'all';

    const grid = document.getElementById('course-grid');
    const emptyState = document.getElementById('empty-state');
    const cards = Array.from(document.querySelectorAll('.course-card')) as HTMLElement[];
    const buttons = document.querySelectorAll('.category-btn');

    const updateButtonStyles = () => {
      buttons.forEach(btn => {
        if (btn.getAttribute('data-category') === activeCategory) {
          btn.className = 'category-btn bg-slate-900 text-white font-semibold text-xs md:text-sm px-4 py-2 rounded-xl shadow-sm whitespace-nowrap transition-colors';
        } else {
          btn.className = 'category-btn bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs md:text-sm px-4 py-2 rounded-xl whitespace-nowrap transition-colors';
        }
      });
    };

    const applyFilters = () => {
      let visibleCount = 0;
      
      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        const matchCategory = activeCategory === 'all' || cat === activeCategory;
        
        if (matchCategory) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCount === 0) {
        grid?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
      } else {
        grid?.classList.remove('hidden');
        emptyState?.classList.add('hidden');
      }
    };

    const setCategory = (cat: string) => {
      activeCategory = cat;
      updateButtonStyles();
      applyFilters();
      
      // Update URL
      const url = new URL(window.location.href);
      if (cat === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', cat);
      }
      window.history.replaceState(null, '', url.toString());
    };

    // Button Listeners
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');
        if (cat) setCategory(cat);
      });
    });

    document.getElementById('clear-filters-btn')?.addEventListener('click', () => {
      setCategory('all');
    });

    // Hydration
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const catParam = urlParams.get('category');
      
      // Check if param matches a valid button, else default 'all'
      const isValidCat = Array.from(buttons).some(b => b.getAttribute('data-category') === catParam);
      if (catParam && isValidCat) {
        activeCategory = catParam;
      }
      
      updateButtonStyles();
      applyFilters();
    });

    // Intersection Observer for Sticky Header sync
    const header = document.getElementById('main-header');
    const ribbon = document.getElementById('sticky-course-ribbon');
    const observerTarget = document.getElementById('catalog-grid-top');

    if (header && observerTarget) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting && entry.boundingClientRect.top <= 0) {
            // Scrolled past
            header.classList.add('-translate-y-full');
            if (ribbon) {
              ribbon.classList.remove('bg-slate-50/95', 'border-transparent');
              ribbon.classList.add('bg-white/95', 'border-slate-200', 'shadow-sm');
            }
          } else {
            // Scrolled back up
            header.classList.remove('-translate-y-full');
            if (ribbon) {
              ribbon.classList.remove('bg-white/95', 'border-slate-200', 'shadow-sm');
              ribbon.classList.add('bg-slate-50/95', 'border-transparent');
            }
          }
        },
        { threshold: 1.0, rootMargin: "-80px 0px 0px 0px" } 
      );
      observer.observe(observerTarget);
    }
  </script>
</BaseLayout>
