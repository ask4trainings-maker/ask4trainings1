---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/CourseCard.astro';

import categoriesData from '../../content/categories.json';
import categoriesMeta from '../../data/categories.json';
import { getCollection } from 'astro:content';

const allCoursesRaw = await getCollection('courses');

// Sort alphabetically by title
const allCourses = [...allCoursesRaw].sort((a, b) => a.data.title.localeCompare(b.data.title));

// Order category pills by canonical definition order from src/data/categories.json
const categoryOrder = categoriesMeta.categories.map((c: any) => c.id);
const categories = Object.keys(categoriesData)
  .sort((a, b) => {
    const ai = categoryOrder.indexOf(a);
    const bi = categoryOrder.indexOf(b);
    return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
  })
  .map(key => ({
    key,
    label: (categoriesData as any)[key].label
  }));

function cleanTitle(title: string): string {
  return title
    .replace(/^(Best\s+|Course\s+Tag\s*[-–]?\s*|Courses\s*)/i, '')
    .replace(/\s{2,}/g, ' ')
    .trim();
}
---
<BaseLayout title="All Courses | Ask 4 Trainings" description="Browse our comprehensive list of enterprise IT training programs designed to accelerate your career.">
  <!-- Header Section -->
  <div class="bg-slate-50 border-b border-slate-100 py-16 text-center relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-emerald-600/10 rounded-full blur-[120px]"></div>
    </div>
    
    <div class="relative max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-slate-900 mb-4">Course Catalog</h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto mb-10">Browse our comprehensive list of enterprise IT training programs designed to accelerate your career.</p>
    </div>
  </div>

  <!-- Content Section -->
  <section class="bg-slate-50/80 border-t border-slate-200 py-12 min-h-screen relative">
    
    <!-- Ribbon Nav Anchor -->
    <div id="catalog-ribbon-anchor" class="w-full h-0"></div>
    <div id="catalog-ribbon-wrapper" class="w-full bg-white/95 backdrop-blur-md border-b border-slate-200 z-40 transition-all duration-300 sticky">
      <div class="max-w-7xl mx-auto px-4 py-3 flex items-center gap-2 overflow-x-auto scrollbar-none no-scrollbar touch-pan-x sm:justify-center" style="-webkit-overflow-scrolling: touch; overscroll-behavior-x: contain;">
        <button data-category="all" class="category-btn bg-slate-900 text-white font-semibold text-xs md:text-sm px-4 py-2 rounded-xl shadow-sm whitespace-nowrap transition-colors">All Courses</button>
        {categories.map(cat => (
          <button data-category={cat.key} class="category-btn bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs md:text-sm px-4 py-2 rounded-xl whitespace-nowrap transition-colors">{cat.label}</button>
        ))}
      </div>
    </div>

    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full py-12">
      <!-- Course Grid -->
      <div id="course-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allCourses.map(course => (
          <CourseCard 
            title={cleanTitle(course.data.title)}
            category={course.data.category}
            duration={course.data.duration}
            mode={course.data.mode}
            slug={course.data.slug}
          />
        ))}
      </div>
      
      <!-- Empty State -->
      <div id="empty-state" class="hidden text-center py-20 text-slate-500">
        <svg class="w-16 h-16 mx-auto text-slate-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-xl font-semibold text-slate-700 mb-2">No courses found</h3>
        <p class="text-slate-500 max-w-md mx-auto mb-6">We couldn't find any courses matching your selected criteria. Try adjusting your filters.</p>
        <button id="clear-filters-btn" class="text-emerald-600 hover:text-emerald-700 font-medium hover:underline">Clear all filters</button>
      </div>
    </div>
  </section>

  <script>

    // Filtering State
    let activeCategory = 'all';

    const grid = document.getElementById('course-grid');
    const emptyState = document.getElementById('empty-state');
    const cards = Array.from(document.querySelectorAll('.course-card')) as HTMLElement[];
    const buttons = document.querySelectorAll('.category-btn');

    const updateButtonStyles = () => {
      buttons.forEach(btn => {
        if (btn.getAttribute('data-category') === activeCategory) {
          btn.className = 'category-btn bg-slate-900 text-white font-semibold text-xs md:text-sm px-4 py-2 rounded-xl shadow-sm whitespace-nowrap transition-colors';
        } else {
          btn.className = 'category-btn bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs md:text-sm px-4 py-2 rounded-xl whitespace-nowrap transition-colors';
        }
      });
    };

    const applyFilters = () => {
      let visibleCount = 0;
      
      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        const matchCategory = activeCategory === 'all' || cat === activeCategory;
        
        if (matchCategory) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCount === 0) {
        grid?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
      } else {
        grid?.classList.remove('hidden');
        emptyState?.classList.add('hidden');
      }
    };

    const setCategory = (cat: string) => {
      activeCategory = cat;
      updateButtonStyles();
      applyFilters();
      
      // Update URL
      const url = new URL(window.location.href);
      if (cat === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', cat);
      }
      window.history.replaceState(null, '', url.toString());
    };

    // Button Listeners
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');
        if (cat) setCategory(cat);
      });
    });

    document.getElementById('clear-filters-btn')?.addEventListener('click', () => {
      setCategory('all');
    });

    // Hydration
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const catParam = urlParams.get('category');
        
        const isValidCat = Array.from(buttons).some(b => b.getAttribute('data-category') === catParam);
        if (catParam && isValidCat) {
          activeCategory = catParam;
        }
        
        updateButtonStyles();
        applyFilters();
      });
    } else {
      const urlParams = new URLSearchParams(window.location.search);
      const catParam = urlParams.get('category');
      
      const isValidCat = Array.from(buttons).some(b => b.getAttribute('data-category') === catParam);
      if (catParam && isValidCat) {
        activeCategory = catParam;
      }
      
      updateButtonStyles();
      applyFilters();
    }
  </script>

  <script is:inline>
    function initStickyCatalogRibbon() {
      const mainHeader = document.getElementById('main-site-header') || document.querySelector('header');
      const ribbonWrapper = document.getElementById('catalog-ribbon-wrapper');
      const ribbonAnchor = document.getElementById('catalog-ribbon-anchor');

      if (!ribbonWrapper || !ribbonAnchor || !mainHeader) return;

      let headerHeight = mainHeader.offsetHeight || 80;
      ribbonWrapper.style.top = `${headerHeight}px`;

      let isPinned = false;

      function handleScroll() {
        if (window.scrollY === 0) {
          headerHeight = mainHeader.offsetHeight || 80;
        }

        const anchorRect = ribbonAnchor.getBoundingClientRect();
        // Pin when the anchor reaches the bottom of the header
        const shouldPin = anchorRect.top <= headerHeight;

        if (shouldPin && !isPinned) {
          isPinned = true;
          mainHeader.classList.add('-translate-y-full');
          ribbonWrapper.style.top = '0px';
          ribbonWrapper.classList.add('shadow-md');
        } else if (!shouldPin && isPinned) {
          isPinned = false;
          mainHeader.classList.remove('-translate-y-full');
          ribbonWrapper.style.top = `${headerHeight}px`;
          ribbonWrapper.classList.remove('shadow-md');
        }
      }

      window.addEventListener('scroll', handleScroll, { passive: true });
      window.addEventListener('resize', () => {
        if (!isPinned) {
          headerHeight = mainHeader.offsetHeight || 80;
          ribbonWrapper.style.top = `${headerHeight}px`;
        }
      });
      handleScroll(); // Initial check on load
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyCatalogRibbon);
    } else {
      initStickyCatalogRibbon();
    }
  </script>
</BaseLayout>
