---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/CourseCard.astro';

import categoriesData from '../../content/categories.json';
import categoriesMeta from '../../data/categories.json';
import { getCollection } from 'astro:content';

const allCoursesRaw = (await getCollection('courses')).filter(c => !c.data.draft);

// Sort alphabetically by title
const allCourses = [...allCoursesRaw].sort((a, b) => a.data.title.localeCompare(b.data.title));

// Order category pills by canonical definition order from src/data/categories.json
const categoryOrder = categoriesMeta.categories.map((c: any) => c.id);
const categories = Object.keys(categoriesData)
  .sort((a, b) => {
    const ai = categoryOrder.indexOf(a);
    const bi = categoryOrder.indexOf(b);
    return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
  })
  .map(key => ({
    key,
    label: (categoriesData as any)[key].label
  }));

function cleanTitle(title: string): string {
  return title
    .replace(/^(Best\s+|Course\s+Tag\s*[-–]?\s*|Courses\s*)/i, '')
    .replace(/\s{2,}/g, ' ')
    .trim();
}

const MORE_THRESHOLD = 15;

const categoryGroups: Record<string, string[]> = {
  'Enterprise ERP': ['guidewire', 'sap', 'siemens', 'ms-d365', 'oracle'],
  'Cloud & DevOps': ['cloud-computing', 'devops', 'azure', 'aws'],
  'Development & Other': ['development', 'new-courses', 'trending-courses', 'other-tools', 'appian', 'software-engineering', 'general-tools']
};

function getCategoryGroup(catKey: string): string {
  for (const [group, keys] of Object.entries(categoryGroups)) {
    if (keys.includes(catKey)) return group;
  }
  return 'Development & Other';
}

const dropdownGroups: Record<string, typeof categories> = {};
categories.forEach(cat => {
  const group = getCategoryGroup(cat.key);
  if (!dropdownGroups[group]) dropdownGroups[group] = [];
  dropdownGroups[group].push(cat);
});

Object.keys(dropdownGroups).forEach(group => {
  dropdownGroups[group].sort((a, b) => a.label.localeCompare(b.label));
});

const groupOrder = ['Enterprise ERP', 'Cloud & DevOps', 'Development & Other'];
const showSearch = categories.length > 25;
const showMoreButton = categories.length > MORE_THRESHOLD;
---
<BaseLayout title="All IT Courses & Certifications | Ask4Trainings" description="Browse our comprehensive list of enterprise IT training programs designed to accelerate your career.">
  <!-- Header Section -->
  <div class="bg-slate-50 border-b border-slate-100 py-16 text-center relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-emerald-600/10 rounded-full blur-[120px]"></div>
    </div>
    
    <div class="relative max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-slate-900 mb-4">View All Courses</h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto mb-10">Browse our comprehensive list of enterprise IT training programs designed to accelerate your career.</p>
    </div>
  </div>

  <!-- Ribbon Nav Container -->
  <div class="relative w-full z-40">
    <div id="catalog-ribbon-anchor" class="w-full h-0"></div>
    <div id="ribbon-placeholder" class="hidden w-full"></div>
    <div id="catalog-ribbon-wrapper" class="w-full bg-white/95 backdrop-blur-md border-y border-slate-200 transition-all duration-300">
      <div class="max-w-7xl mx-auto relative group">
        <!-- Edge Fades -->
        <div id="scroll-fade-left" class="absolute left-0 top-0 bottom-0 w-8 sm:w-16 bg-gradient-to-r from-white via-white/80 to-transparent pointer-events-none opacity-0 transition-opacity duration-300 z-10 hidden sm:block"></div>
        <div id="scroll-fade-right" class="absolute right-0 top-0 bottom-0 w-8 sm:w-16 bg-gradient-to-l from-white via-white/80 to-transparent pointer-events-none transition-opacity duration-300 z-10 hidden sm:block"></div>

        <!-- Desktop Arrows -->
        <button id="scroll-left-btn" class="absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white shadow-md border border-slate-200 flex items-center justify-center text-slate-600 hover:text-slate-900 hover:scale-105 active:scale-95 opacity-0 md:group-hover:opacity-100 transition-all z-20 disabled:hidden" aria-label="Scroll left">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>

        <button id="scroll-right-btn" class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white shadow-md border border-slate-200 flex items-center justify-center text-slate-600 hover:text-slate-900 hover:scale-105 active:scale-95 opacity-0 md:group-hover:opacity-100 transition-all z-20 disabled:hidden" aria-label="Scroll right">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>

        <!-- Scrollable Area -->
        <div id="category-scroll-container" class="overflow-x-auto scrollbar-none no-scrollbar touch-pan-x px-6 py-3" style="-webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; scroll-behavior: smooth;">
          <div class="flex items-center gap-2 w-max md:mx-auto">
            <button data-category="all" class="category-btn bg-slate-900 text-white font-semibold text-xs md:text-sm px-4 py-2 rounded-xl shadow-sm whitespace-nowrap transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-500">All Courses</button>
            {categories.map(cat => (
              <button data-category={cat.key} class="category-btn bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs md:text-sm px-4 py-2 rounded-xl whitespace-nowrap transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-500">{cat.label}</button>
            ))}
            
            <!-- Overflow More Dropdown -->
            {showMoreButton && (
              <div class="relative inline-block ml-1">
                <button id="more-categories-btn" class="bg-white border border-slate-300 shadow-sm hover:bg-slate-50 text-slate-700 font-medium text-xs md:text-sm px-3 py-2 rounded-xl whitespace-nowrap transition-colors flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-emerald-500" aria-haspopup="true" aria-expanded="false">
                  More <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                
                <div id="dropdown-backdrop" class="fixed inset-0 bg-slate-900/20 z-40 md:hidden opacity-0 invisible transition-opacity duration-200"></div>

                <div id="more-categories-dropdown" class="fixed inset-x-0 bottom-0 md:absolute md:inset-auto md:right-0 md:top-full md:mt-2 md:w-72 max-h-[70vh] md:max-h-[350px] bg-white rounded-t-2xl md:rounded-xl shadow-2xl md:shadow-xl border-t md:border border-slate-200 z-50 opacity-0 invisible transform translate-y-full md:translate-y-0 md:scale-95 transition-all duration-300 md:duration-200 md:origin-top-right flex flex-col">
                  {showSearch && (
                    <div class="p-3 border-b border-slate-100 sticky top-0 bg-white z-10 shrink-0 rounded-t-2xl md:rounded-t-xl">
                      <div class="relative">
                        <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        <input type="text" id="category-search-input" placeholder="Search categories..." class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-shadow" />
                      </div>
                    </div>
                  )}
                  
                  <div class="overflow-y-auto p-2 space-y-4">
                    {groupOrder.map(group => {
                      const groupCats = dropdownGroups[group];
                      if (!groupCats || groupCats.length === 0) return null;
                      return (
                        <div class="category-group">
                          <div class="px-3 pb-1 text-xs font-semibold text-slate-400 uppercase tracking-wider">{group}</div>
                          <div class="space-y-1">
                            {groupCats.map(cat => (
                              <button data-dropdown-category={cat.key} class="dropdown-category-btn w-full text-left px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors focus:outline-none focus:bg-slate-100 flex items-center justify-between">
                                <span class="category-label">{cat.label}</span>
                                <svg class="w-4 h-4 text-emerald-600 opacity-0 checkmark-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                              </button>
                            ))}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <section class="bg-slate-50/80 py-12 min-h-screen relative">

    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full py-12">
      <!-- Course Grid -->
      <div id="course-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allCourses.map(course => (
          <CourseCard 
            title={cleanTitle(course.data.title)}
            category={course.data.category}
            duration={course.data.duration}
            mode={course.data.mode}
            slug={course.data.slug}
          />
        ))}
      </div>
      
      <!-- Empty State -->
      <div id="empty-state" class="hidden text-center py-20 text-slate-500">
        <svg class="w-16 h-16 mx-auto text-slate-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-xl font-semibold text-slate-700 mb-2">No courses found</h3>
        <p class="text-slate-500 max-w-md mx-auto mb-6">We couldn't find any courses matching your selected criteria. Try adjusting your filters.</p>
        <button id="clear-filters-btn" class="text-emerald-600 hover:text-emerald-700 font-medium hover:underline">Clear all filters</button>
      </div>
    </div>
  </section>

  <script>

    // Filtering State
    let activeCategory = 'all';

    const grid = document.getElementById('course-grid');
    const emptyState = document.getElementById('empty-state');
    const cards = Array.from(document.querySelectorAll('.course-card')) as HTMLElement[];
    const buttons = document.querySelectorAll('.category-btn');

    // Ribbon Scroll & Dropdown Logic
    const scrollContainer = document.getElementById('category-scroll-container');
    const scrollLeftBtn = document.getElementById('scroll-left-btn');
    const scrollRightBtn = document.getElementById('scroll-right-btn');
    const fadeLeft = document.getElementById('scroll-fade-left');
    const fadeRight = document.getElementById('scroll-fade-right');

    const moreBtn = document.getElementById('more-categories-btn');
    const dropdown = document.getElementById('more-categories-dropdown');
    const backdrop = document.getElementById('dropdown-backdrop');
    const searchInput = document.getElementById('category-search-input');
    const dropdownBtns = document.querySelectorAll('.dropdown-category-btn');
    
    let isDropdownOpen = false;

    const centerPill = (btn: Element) => {
      if (!scrollContainer || !btn) return;
      const containerRect = scrollContainer.getBoundingClientRect();
      const btnRect = btn.getBoundingClientRect();
      
      const scrollPos = btnRect.left + scrollContainer.scrollLeft - containerRect.left - (containerRect.width / 2) + (btnRect.width / 2);
      
      scrollContainer.scrollTo({
        left: scrollPos,
        behavior: 'smooth'
      });
    };

    const updateScrollState = () => {
      if (!scrollContainer) return;
      const { scrollLeft, scrollWidth, clientWidth } = scrollContainer;
      
      const isAtStart = scrollLeft <= 10;
      const isAtEnd = scrollLeft + clientWidth >= scrollWidth - 10;
      
      if (scrollLeftBtn) (scrollLeftBtn as HTMLButtonElement).disabled = isAtStart;
      if (scrollRightBtn) (scrollRightBtn as HTMLButtonElement).disabled = isAtEnd;
      
      if (fadeLeft) fadeLeft.style.opacity = isAtStart ? '0' : '1';
      if (fadeRight) fadeRight.style.opacity = isAtEnd ? '0' : '1';
    };

    if (scrollContainer) {
      scrollContainer.addEventListener('scroll', updateScrollState, { passive: true });
      window.addEventListener('resize', updateScrollState, { passive: true });
      // Initialize after layout
      setTimeout(updateScrollState, 100);
    }

    if (scrollLeftBtn && scrollContainer) {
      scrollLeftBtn.addEventListener('click', () => {
        scrollContainer.scrollBy({ left: -300, behavior: 'smooth' });
      });
    }
    if (scrollRightBtn && scrollContainer) {
      scrollRightBtn.addEventListener('click', () => {
        scrollContainer.scrollBy({ left: 300, behavior: 'smooth' });
      });
    }

    const toggleDropdown = (show?: boolean) => {
      isDropdownOpen = show !== undefined ? show : !isDropdownOpen;
      if (isDropdownOpen) {
        dropdown?.classList.remove('opacity-0', 'invisible', 'scale-95', 'translate-y-full');
        dropdown?.classList.add('opacity-100', 'visible', 'scale-100', 'translate-y-0');
        
        backdrop?.classList.remove('opacity-0', 'invisible');
        backdrop?.classList.add('opacity-100', 'visible');
        
        moreBtn?.setAttribute('aria-expanded', 'true');
        
        setTimeout(() => {
          if (searchInput) (searchInput as HTMLInputElement).focus();
        }, 100);
      } else {
        dropdown?.classList.add('opacity-0', 'invisible', 'scale-95', 'translate-y-full');
        dropdown?.classList.remove('opacity-100', 'visible', 'scale-100', 'translate-y-0');
        
        backdrop?.classList.add('opacity-0', 'invisible');
        backdrop?.classList.remove('opacity-100', 'visible');
        
        moreBtn?.setAttribute('aria-expanded', 'false');
        
        if (searchInput) {
          (searchInput as HTMLInputElement).value = '';
          dropdownBtns.forEach(btn => (btn as HTMLElement).style.display = '');
          document.querySelectorAll('.category-group').forEach(g => (g as HTMLElement).style.display = '');
        }
      }
    };

    if (moreBtn) {
      moreBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleDropdown();
      });
    }

    document.addEventListener('click', (e) => {
      if (isDropdownOpen && dropdown && moreBtn && !dropdown.contains(e.target as Node) && !moreBtn.contains(e.target as Node)) {
        toggleDropdown(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isDropdownOpen) {
        toggleDropdown(false);
        if (moreBtn) moreBtn.focus();
      }
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        dropdownBtns.forEach(btn => {
          const label = btn.querySelector('.category-label')?.textContent?.toLowerCase() || '';
          if (label.includes(query)) {
            (btn as HTMLElement).style.display = '';
          } else {
            (btn as HTMLElement).style.display = 'none';
          }
        });
        
        document.querySelectorAll('.category-group').forEach(group => {
          const hasVisible = Array.from(group.querySelectorAll('.dropdown-category-btn')).some(b => (b as HTMLElement).style.display !== 'none');
          (group as HTMLElement).style.display = hasVisible ? '' : 'none';
        });
      });
    }

    const updateButtonStyles = () => {
      buttons.forEach(btn => {
        if (btn.getAttribute('data-category') === activeCategory) {
          btn.className = 'category-btn bg-slate-900 text-white font-semibold text-xs md:text-sm px-4 py-2 rounded-xl shadow-sm whitespace-nowrap transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-500';
          centerPill(btn);
        } else {
          btn.className = 'category-btn bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs md:text-sm px-4 py-2 rounded-xl whitespace-nowrap transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-500';
        }
      });

      dropdownBtns.forEach(btn => {
        const checkmark = btn.querySelector('.checkmark-icon');
        if (btn.getAttribute('data-dropdown-category') === activeCategory) {
          btn.classList.add('bg-emerald-50', 'text-emerald-700', 'font-semibold');
          btn.classList.remove('text-slate-600', 'hover:bg-slate-50', 'hover:text-slate-900');
          if (checkmark) checkmark.classList.remove('opacity-0');
        } else {
          btn.classList.remove('bg-emerald-50', 'text-emerald-700', 'font-semibold');
          btn.classList.add('text-slate-600', 'hover:bg-slate-50', 'hover:text-slate-900');
          if (checkmark) checkmark.classList.add('opacity-0');
        }
      });
    };

    const applyFilters = () => {
      let visibleCount = 0;
      
      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        const matchCategory = activeCategory === 'all' || cat === activeCategory;
        
        if (matchCategory) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCount === 0) {
        grid?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
      } else {
        grid?.classList.remove('hidden');
        emptyState?.classList.add('hidden');
      }
    };

    const setCategory = (cat: string) => {
      activeCategory = cat;
      updateButtonStyles();
      applyFilters();
      
      // Update URL
      const url = new URL(window.location.href);
      if (cat === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', cat);
      }
      window.history.replaceState(null, '', url.toString());
    };

    // Button Listeners
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');
        if (cat) setCategory(cat);
      });
    });

    dropdownBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-dropdown-category');
        if (cat) {
          setCategory(cat);
          toggleDropdown(false);
        }
      });
    });

    document.getElementById('clear-filters-btn')?.addEventListener('click', () => {
      setCategory('all');
    });

    // Hydration
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const catParam = urlParams.get('category');
        
        const isValidCat = Array.from(buttons).some(b => b.getAttribute('data-category') === catParam);
        if (catParam && isValidCat) {
          activeCategory = catParam;
        }
        
        updateButtonStyles();
        applyFilters();
      });
    } else {
      const urlParams = new URLSearchParams(window.location.search);
      const catParam = urlParams.get('category');
      
      const isValidCat = Array.from(buttons).some(b => b.getAttribute('data-category') === catParam);
      if (catParam && isValidCat) {
        activeCategory = catParam;
      }
      
      updateButtonStyles();
      applyFilters();
    }
  </script>

  <script is:inline>
    function initStickyCatalogRibbon() {
      const mainHeader = document.getElementById('main-site-header') || document.querySelector('header');
      const ribbonWrapper = document.getElementById('catalog-ribbon-wrapper');
      const ribbonAnchor = document.getElementById('catalog-ribbon-anchor');
      const ribbonPlaceholder = document.getElementById('ribbon-placeholder');

      if (!ribbonWrapper || !ribbonAnchor || !mainHeader) return;

      let isPinned = false;

      function handleScroll() {
        const anchorRect = ribbonAnchor.getBoundingClientRect();
        // Pin when the ribbon's anchor point scrolls to or past the top edge of the viewport
        const shouldPin = anchorRect.top <= 0;

        if (shouldPin && !isPinned) {
          isPinned = true;
          // 1. Slide main header out of view
          mainHeader.classList.add('-translate-y-full');
          
          // 2. Activate height placeholder to prevent content jumps
          if (ribbonPlaceholder) {
            ribbonPlaceholder.style.height = `${ribbonWrapper.offsetHeight}px`;
            ribbonPlaceholder.classList.remove('hidden');
          }

          // 3. Switch category ribbon to fixed positioning at top: 0
          ribbonWrapper.classList.add('fixed', 'top-0', 'left-0', 'shadow-md');
        } else if (!shouldPin && isPinned) {
          isPinned = false;
          // 1. Remove translation from main header
          mainHeader.classList.remove('-translate-y-full');

          // 2. Restore category ribbon to natural flow
          ribbonWrapper.classList.remove('fixed', 'top-0', 'left-0', 'shadow-md');

          // 3. Collapse height placeholder
          if (ribbonPlaceholder) {
            ribbonPlaceholder.classList.add('hidden');
            ribbonPlaceholder.style.height = '0px';
          }
        }
      }

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll(); // Initial check on load
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyCatalogRibbon);
    } else {
      initStickyCatalogRibbon();
    }
  </script>
</BaseLayout>
