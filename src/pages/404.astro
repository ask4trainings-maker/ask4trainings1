---
import BaseLayout from '../layouts/BaseLayout.astro';
import categoriesData from '../data/categories.json';

// Top active categories as requested
const topCategoryIds = ['guidewire', 'sap', 'siemens', 'cloud-computing', 'oracle'];
const topCategories = categoriesData.categories.filter(cat => topCategoryIds.includes(cat.id));
---

<BaseLayout title="Page Not Found | Ask4Trainings">
  <meta name="robots" content="noindex, follow" slot="head" />
  
  <section data-pagefind-ignore class="relative w-full overflow-hidden">
    <!-- Background & Ambient Canvas -->
    <div class="absolute inset-0 pointer-events-none -z-10">
      <div class="absolute inset-0 bg-gradient-to-tr from-emerald-500/10 via-transparent to-teal-500/5 blur-3xl rounded-full"></div>
    </div>
    
    <div class="max-w-3xl mx-auto px-4 py-16 sm:py-24 text-center flex flex-col items-center">
      <!-- Status Pill -->
      <div class="bg-emerald-50 border border-emerald-200/80 text-emerald-800 text-xs font-semibold px-3.5 py-1.5 rounded-full inline-flex items-center gap-2 mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        System Status: 404
      </div>

      <!-- Numeric & Heading Typography -->
      <h1 class="text-6xl sm:text-7xl font-extrabold tabular-nums tracking-tight text-slate-900 mb-4">404</h1>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-800 mb-4">Looking for a Specific Training Program?</h2>
      <p class="text-slate-600 text-lg mb-8 max-w-2xl">
        The page you requested may have moved, but our full enterprise curriculum, syllabus topics, and sandbox labs are accessible below.
      </p>

      <!-- Centered Inline Pagefind Search Integration -->
      <div class="w-full max-w-xl my-8 text-left">
        <div id="inline-pagefind-search" class="w-full"></div>
      </div>

      <!-- Quick Recovery Actions & Dynamic Category Jump Strip -->
      <div class="mt-4 w-full flex flex-col items-center">
        <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-4">Popular Course Domains</h3>
        <div class="flex flex-wrap justify-center gap-3 mb-10">
          {topCategories.map((cat) => (
            <a 
              href={`/courses/${cat.id}/`} 
              class="bg-white border border-slate-200 hover:border-emerald-500 hover:text-emerald-700 text-slate-700 text-xs font-semibold px-3.5 py-2 rounded-xl transition-all shadow-sm"
            >
              {cat.title}
            </a>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/" class="bg-slate-900 hover:bg-slate-800 text-white font-semibold text-sm px-6 py-2.5 rounded-xl transition-colors text-center">
            Return to Homepage
          </a>
          <a href="/courses/" class="border border-slate-300 bg-white hover:border-emerald-600 hover:text-emerald-600 text-slate-700 font-semibold text-sm px-6 py-2.5 rounded-xl transition-colors text-center">
            Browse Full Catalog
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  async function initInlineSearch() {
    const container = document.getElementById('inline-pagefind-search');
    if (!container) return;

    // Guard for local development before first 'pagefind' build execution
    try {
      // Dynamically link Pagefind stylesheet if not already present
      if (!document.querySelector('link[href*="pagefind-ui.css"]')) {
        const cssLink = document.createElement('link');
        cssLink.rel = 'stylesheet';
        cssLink.href = '/pagefind/pagefind-ui.css';
        document.head.appendChild(cssLink);
      }

      // Load Pagefind script
      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = () => {
        new PagefindUI({
          element: '#inline-pagefind-search',
          showImages: false,
          resetStyles: false,
          translations: {
            placeholder: 'Search courses, tools, or syllabus modules (e.g. Guidewire, SAP, DevOps)...'
          }
        });
      };
      document.body.appendChild(script);
    } catch (e) {
      console.warn('Pagefind not yet indexed in local dev mode.');
    }
  }

  document.addEventListener('DOMContentLoaded', initInlineSearch);
</script>

<style is:global>
  /* Pagefind Styling Overrides */
  #inline-pagefind-search .pagefind-ui__search-input {
    border-color: theme('colors.slate.300');
    border-radius: 0.75rem; /* rounded-xl */
    font-family: inherit;
    font-size: 0.875rem; /* text-sm */
    padding: 1rem 1rem 1rem 3rem;
    font-weight: 500;
  }
  
  #inline-pagefind-search .pagefind-ui__search-input:focus {
    outline: none;
    --tw-ring-color: theme('colors.emerald.500');
    --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);
    --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);
    box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);
    border-color: theme('colors.emerald.500');
  }

  #inline-pagefind-search .pagefind-ui__search-clear {
    border-radius: 0.5rem;
  }

  #inline-pagefind-search .pagefind-ui__results-area {
    margin-top: 1rem;
  }

  #inline-pagefind-search .pagefind-ui__result {
    border: 1px solid theme('colors.slate.200');
    border-radius: 0.75rem;
    padding: 1.25rem;
    margin-bottom: 0.75rem;
    background-color: theme('colors.white');
    transition: all 0.2s ease;
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  }

  #inline-pagefind-search .pagefind-ui__result:hover {
    border-color: theme('colors.emerald.500');
    transform: translateY(-1px);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  }

  #inline-pagefind-search .pagefind-ui__result-link {
    color: theme('colors.slate.900');
    font-weight: 600;
    text-decoration: none;
  }

  #inline-pagefind-search .pagefind-ui__result-link:hover {
    color: theme('colors.emerald.600');
  }

  #inline-pagefind-search .pagefind-ui__result-excerpt {
    color: theme('colors.slate.600');
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }

  #inline-pagefind-search .pagefind-ui__button {
    background-color: theme('colors.slate.900');
    color: white;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 0.875rem;
    transition: background-color 0.2s;
  }

  #inline-pagefind-search .pagefind-ui__button:hover {
    background-color: theme('colors.slate.800');
  }

  #inline-pagefind-search mark {
    background-color: theme('colors.emerald.100');
    color: theme('colors.emerald.900');
    font-weight: 600;
    padding: 0 0.125rem;
    border-radius: 0.125rem;
  }
</style>
