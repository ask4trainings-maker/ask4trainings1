---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const aboutEntry = await getEntry('pages', 'about');
const aboutData = aboutEntry?.data || { story: '', faculty: [], infrastructure: [] };
---
<BaseLayout title="About Us | Ask 4 Trainings">
  <div class="bg-slate-50 border-b border-slate-100 py-20 relative overflow-hidden">
    <!-- Ambient glows -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-emerald-600/10 rounded-full blur-[100px]"></div>
    </div>
    
    <div class="relative max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-slate-900 mb-6 text-center leading-[1.15]">About Us</h1>
      <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed max-w-4xl mx-auto text-center mb-16 space-y-4">
        {aboutData.story}
      </p>


      <!-- Section: Faculty -->
      <div class="mb-20">
        <h2 class="text-2xl font-heading font-bold text-slate-900 mb-8 border-b border-slate-200 pb-4 leading-snug">Expert Faculty</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {aboutData.faculty.map((member: any) => (
            <div class="bg-white/60 border border-slate-200 rounded-2xl p-6 text-center hover:border-emerald-600/30 transition-colors">
              <div class="w-20 h-20 mx-auto rounded-full bg-slate-100 border-2 border-emerald-600/50 mb-4 flex items-center justify-center">
                <svg class="w-8 h-8 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900">{member.name}</h3>
              <p class="text-sm text-emerald-600 mb-3">{member.role}</p>
              <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed space-y-4">{member.bio}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Section: Infrastructure -->
      <div class="mb-20">
        <h2 class="text-2xl font-heading font-bold text-slate-900 mb-8 border-b border-slate-200 pb-4 leading-snug">Lab Infrastructure</h2>
        <div class="bg-slate-100/40 border border-slate-200 rounded-2xl p-8 flex flex-col md:flex-row items-center gap-8">
          <div class="md:w-1/2">
            <h3 class="text-xl font-bold text-slate-900 mb-4">24/7 Dedicated Sandbox Access</h3>
            <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed mb-4 space-y-4">We provide high-performance cloud lab environments for all our students. Practice complex integrations and deployments without worrying about local hardware limitations.</p>
            <ul class="space-y-2 text-sm text-slate-500">
              {aboutData.infrastructure.map((item: string) => (
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> {item}</li>
              ))}
            </ul>
          </div>
          <div class="md:w-1/2 bg-white border border-slate-100 rounded-xl p-6 shadow-inner w-full">
            <div class="flex gap-2 mb-4 border-b border-slate-200 pb-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
            <div class="font-mono text-sm text-slate-500 space-y-2">
              <p><span class="text-emerald-600">root@sandbox</span><span class="text-white">:</span><span class="text-blue-400">~</span>$ docker-compose up -d</p>
              <p>Starting enterprise_db ... <span class="text-emerald-600">done</span></p>
              <p>Starting app_server ... <span class="text-emerald-600">done</span></p>
              <p><span class="text-emerald-600">></span> Lab Environment Ready on port 8080</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Section: LMS Platform -->
      <div class="mb-20">
        <div class="mb-8 border-b border-slate-200 pb-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-700 text-xs font-semibold mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Learning Management System · Ask4Trainings Portal
          </div>
          <h2 class="text-2xl font-heading font-bold text-slate-900 leading-snug">Structured Learning Beyond the Live Classroom</h2>
          <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed mt-2 max-w-3xl space-y-4">Every enrolled student receives dedicated credentials to our enterprise LMS, centralizing classroom recordings, architectural notes, and project repositories in one place.</p>
        </div>
        
        <div class="bg-slate-100/40 border border-slate-200 rounded-2xl p-8 flex flex-col md:flex-row items-center gap-8">
          <div class="md:w-1/2">
            <h3 class="text-xl font-bold text-slate-900 mb-6">24/7 Student Portal Access</h3>
            <ul class="space-y-4 text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span><strong class="text-slate-900">Same-Day Session Replays:</strong> High-definition video recordings uploaded within 2 hours of class completion.</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span><strong class="text-slate-900">Digital Study Repositories:</strong> Downloadable architectural blueprints, configuration files, and official curriculum guides.</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span><strong class="text-slate-900">Capstone & Assignment Tracking:</strong> Structured submission workflows with direct feedback from senior mentors.</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span><strong class="text-slate-900">Doubt Resolution Threads:</strong> Dedicated discussion boards paired directly with each training module.</span>
              </li>
            </ul>

          </div>
          
          <div class="md:w-1/2 bg-white border border-slate-200 rounded-xl shadow-lg w-full overflow-hidden flex flex-col">
            <!-- Browser Header -->
            <div class="bg-slate-50 border-b border-slate-200 px-4 py-3 flex items-center gap-4">
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
              </div>
              <div class="bg-white border border-slate-200 rounded-md py-1 px-3 text-xs text-slate-500 font-medium flex-1 text-center flex items-center justify-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                System Online · Student Workspace
              </div>
            </div>
            <!-- Mockup Content -->
            <div class="p-5 bg-slate-50/50 flex-1 space-y-4">
              <!-- Course Card -->
              <div class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm">
                <div class="flex justify-between items-start mb-3">
                  <div>
                    <div class="text-xs font-semibold text-emerald-600 mb-1">Active Course</div>
                    <div class="text-sm font-bold text-slate-900">Guidewire PolicyCenter 10.x</div>
                  </div>
                  <div class="text-xs font-bold text-slate-700 bg-slate-100 px-2 py-1 rounded">100%</div>
                </div>
                <div class="w-full bg-slate-100 rounded-full h-1.5 mb-1">
                  <div class="bg-emerald-500 h-1.5 rounded-full" style="width: 100%"></div>
                </div>
              </div>
              
              <!-- Module Activity -->
              <div class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-emerald-50 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"></path></svg>
                </div>
                <div>
                  <div class="text-sm font-bold text-slate-900">Lecture 14: Custom Plugins & Dataverse Integration</div>
                  <div class="text-xs text-slate-500 mt-0.5">HD Recording Available · 1h 45m</div>
                </div>
              </div>
              
              <!-- Quick Links -->
              <div class="grid grid-cols-2 gap-3">
                <div class="bg-white border border-slate-200 rounded-lg p-3 text-center shadow-sm text-xs font-medium text-slate-600 hover:text-emerald-600 cursor-default transition-colors">
                  Download Syllabus PDF
                </div>
                <div class="bg-white border border-slate-200 rounded-lg p-3 text-center shadow-sm text-xs font-medium text-slate-600 hover:text-emerald-600 cursor-default transition-colors">
                  Access Lab VM Credentials
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>



    </div>
  </div>
</BaseLayout>
