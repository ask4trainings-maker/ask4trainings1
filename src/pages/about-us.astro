---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About Us | Ask 4 Trainings">
  <div class="container mx-auto px-4 py-16 max-w-4xl">
    <h1 class="text-4xl md:text-5xl font-heading font-bold text-ink-900 mb-8 text-center">About Ask 4 Trainings</h1>
    
    <div class="prose prose-lg prose-slate mx-auto text-ink-700">
      <p class="lead text-xl mb-6">Ask 4 Trainings is a premier IT training institute located in Ameerpet, Hyderabad, specializing in enterprise-grade software technologies.</p>
      
      <h2 class="text-2xl font-heading font-bold text-ink-900 mt-10 mb-4">Our Mission</h2>
      <p>Our mission is to bridge the gap between academic education and industry requirements by providing real-time, project-based training that prepares our students for immediate success in the corporate world.</p>
      
      <h2 class="text-2xl font-heading font-bold text-ink-900 mt-10 mb-4">Why Choose Us?</h2>
      <ul class="list-disc list-inside space-y-2 mb-8">
        <li><strong>Expert Trainers:</strong> Learn from working professionals with 10+ years of real-world experience.</li>
        <li><strong>Hands-on Practice:</strong> Focus on practical scenarios and live projects over theoretical knowledge.</li>
        <li><strong>Placement Assistance:</strong> Dedicated support team to help you land your dream job with top MNCs.</li>
        <li><strong>Flexible Formats:</strong> Online, classroom, and corporate training options to suit your schedule.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
