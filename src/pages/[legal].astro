---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const policies = await getCollection('legal');
  return policies.map(entry => ({
    params: { legal: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title}>
  <main class="min-h-screen bg-slate-50 py-16 sm:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 sm:p-12">
        <article class="prose prose-slate max-w-none prose-headings:font-bold prose-h1:text-3xl prose-h1:mb-8 prose-h2:text-xl prose-h2:mt-8 prose-h2:mb-4 prose-p:text-sm sm:prose-p:text-base prose-p:leading-relaxed prose-p:text-slate-600 prose-a:text-emerald-600 hover:prose-a:text-emerald-500">
          <Content />
        </article>
      </div>
    </div>
  </main>
</BaseLayout>
