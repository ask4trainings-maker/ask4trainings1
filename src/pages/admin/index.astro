---
// Standalone admin shell - bypass all layouts and global styling
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Content Manager | Ask4Trainings</title>
    <!-- Explicit CMS Configuration Binding -->
    <link rel="cms-config-url" type="text/yaml" href="/admin/config.yml" />
    <style is:inline>
      html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        width: 100%;
        background-color: #0f172a;
      }
    </style>
  </head>
  <body>
    <!-- Robust Scroll & Focus Preservation for Sveltia CMS -->
    <script is:inline>
      (function() {
        const scrollState = new Map();
        let lastActiveInput = null;
        let isRestoring = false;
        let scrollTimeout = null;

        // 1. Track Scroll Position Continuously
        window.addEventListener('scroll', (e) => {
          if (isRestoring) return; // Ignore programmatic scrolls during restoration
          
          const target = e.composedPath ? e.composedPath()[0] : e.target;
          
          if (scrollTimeout) clearTimeout(scrollTimeout);
          
          scrollTimeout = setTimeout(() => {
            const hash = window.location.hash;
            if (!hash) return;
            
            let state = scrollState.get(hash);
            if (!state) {
                state = { windowScroll: 0, elements: [] };
                scrollState.set(hash, state);
            }
            
            if (target === document || target === window) {
                state.windowScroll = window.scrollY;
            } else if (target && target.nodeType === 1 && target.tagName !== 'INPUT' && target.tagName !== 'TEXTAREA') {
                // Generate a reliable selector
                let selector = target.tagName.toLowerCase();
                if (target.id) {
                    selector += '#' + target.id;
                } else if (target.className && typeof target.className === 'string') {
                    const safeClasses = target.className.trim().split(/\s+/).filter(c => /^[a-zA-Z0-9_-]+$/.test(c));
                    if (safeClasses.length > 0) {
                        selector += '.' + safeClasses.join('.');
                    }
                }
                
                let found = false;
                for (let i = 0; i < state.elements.length; i++) {
                    if (state.elements[i].selector === selector) {
                        state.elements[i].scrollTop = target.scrollTop;
                        found = true;
                        break;
                    }
                }
                if (!found && target.scrollTop > 0) {
                    state.elements.push({
                        selector: selector,
                        scrollTop: target.scrollTop,
                        tag: target.tagName.toLowerCase()
                    });
                }
            }
            
            const active = document.activeElement;
            if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.isContentEditable)) {
                lastActiveInput = active;
            } else {
                lastActiveInput = null;
            }
          }, 150);
        }, true); // Capture phase to catch all internal scrolling containers

        // 2. Active Enforcer on Re-entry
        const restoreState = () => {
           const hash = window.location.hash;
           const state = scrollState.get(hash);
           if (!state) return;
           
           isRestoring = true;
           let attempts = 0;
           let restoreInterval;
           
           const doRestore = () => {
               attempts++;
               // Aggressive enforcement for 2.5 seconds to outlast async rendering and data fetching
               if (attempts > 50) {
                   isRestoring = false;
                   clearInterval(restoreInterval);
                   return;
               }
               
               if (state.windowScroll > 0) {
                   window.scrollTo(0, state.windowScroll);
               }
               
               for (const elData of state.elements) {
                   try {
                       // Try precise selector first
                       let els = Array.from(document.querySelectorAll(elData.selector));
                       if (els.length === 0) {
                           // Fallback to tag name
                           els = Array.from(document.querySelectorAll(elData.tag));
                       }
                       
                       for (const el of els) {
                           if (el.scrollHeight >= elData.scrollTop && el.clientHeight > 100) {
                               el.scrollTop = elData.scrollTop;
                           }
                       }
                   } catch(e) {}
               }
               
               if (lastActiveInput && document.body.contains(lastActiveInput)) {
                   if (document.activeElement !== lastActiveInput) {
                       lastActiveInput.focus({ preventScroll: true });
                   }
               }
           };
           
           restoreInterval = setInterval(doRestore, 50);
           doRestore(); // Execute immediately once
           
           // If user interacts, abort the forceful restoration
           const cancelRestore = () => {
               isRestoring = false;
               clearInterval(restoreInterval);
               window.removeEventListener('wheel', cancelRestore, {capture: true});
               window.removeEventListener('touchstart', cancelRestore, {capture: true});
               window.removeEventListener('keydown', cancelRestore, {capture: true});
               window.removeEventListener('mousedown', cancelRestore, {capture: true});
           };
           window.addEventListener('wheel', cancelRestore, {once:true, passive:true, capture: true});
           window.addEventListener('touchstart', cancelRestore, {once:true, passive:true, capture: true});
           window.addEventListener('keydown', cancelRestore, {once:true, passive:true, capture: true});
           window.addEventListener('mousedown', cancelRestore, {once:true, passive:true, capture: true});
        };

        window.addEventListener('focus', restoreState);
        document.addEventListener('visibilitychange', () => {
           if (document.visibilityState === 'visible') {
               restoreState();
           }
        });
      })();
    </script>
    
    <!-- Use is:inline so Vite does not hoist, bundle, or delay Sveltia CMS -->
    <script is:inline src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js"></script>
  </body>
</html>
