---
// Standalone admin shell - bypass all layouts and global styling
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Content Manager | Ask4Trainings</title>
    <!-- Explicit CMS Configuration Binding -->
    <link rel="cms-config-url" type="text/yaml" href="/admin/config.yml" />
    <style is:inline>
      html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        width: 100%;
        background-color: #0f172a;
      }
    </style>
  </head>
  <body>
    <!-- Scroll Preservation for Sveltia CMS (scroll-only, no focus stealing) -->
    <script is:inline>
      (function () {
        // Map of URL hash → { el, top } for the currently scrolled editor pane
        var scrollCache = {};
        var saveTimer = null;

        // Save scroll position on any scroll event (capture phase)
        document.addEventListener('scroll', function (e) {
          var target = (e.composedPath && e.composedPath()[0]) || e.target;
          // Ignore inputs and non-element nodes
          if (!target || target.nodeType !== 1) return;
          var tag = target.tagName;
          if (tag === 'INPUT' || tag === 'TEXTAREA') return;

          if (saveTimer) clearTimeout(saveTimer);
          saveTimer = setTimeout(function () {
            var hash = window.location.hash || '__root__';
            scrollCache[hash] = { el: target, top: target.scrollTop };
            // Also capture window scroll
            scrollCache[hash + '_win'] = window.scrollY;
          }, 100);
        }, true); // capture phase

        // Clear cache on hash change (new entry opened)
        window.addEventListener('hashchange', function () {
          // Don't clear — each hash is its own key, so navigating back still restores
        });

        // On tab re-focus: restore scroll without touching focus
        function restoreScroll() {
          var hash = window.location.hash || '__root__';
          var cached = scrollCache[hash];
          var winScroll = scrollCache[hash + '_win'];

          // Two-pass restore: immediate + one rAF later to survive async re-renders
          function apply() {
            if (cached && cached.el && document.body.contains(cached.el)) {
              cached.el.scrollTop = cached.top;
            }
            if (winScroll > 0) {
              window.scrollTo(0, winScroll);
            }
          }

          apply();
          requestAnimationFrame(apply);
        }

        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'visible') restoreScroll();
        });
        window.addEventListener('focus', restoreScroll);
      })();
    </script>
    

    <!-- Use is:inline so Vite does not hoist, bundle, or delay Sveltia CMS -->
    <script is:inline src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js"></script>
  </body>
</html>
