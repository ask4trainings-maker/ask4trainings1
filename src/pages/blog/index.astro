---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resolveExcerpt, decodeHtmlEntities } from '../../utils/text';

const allBlogPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

// Sort by pubDate descending
const sortedPosts = allBlogPosts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
const posts = sortedPosts.length > 0 ? sortedPosts : [
  {
    id: 'fallback',
    data: {
      title: 'Building Enterprise Architecture in 2026',
      description: 'Explore the key concepts in scaling cloud-native enterprise systems.',
      tags: ['Architecture'],
      pubDate: new Date().toISOString(),
      image: '/logo.svg',
      author: 'Admin'
    },
    body: ''
  }
];

function getPostUrl(id: string): string {
  const cleanSlug = id.replace(/\.mdx?$/, '');
  return `/blog/${cleanSlug}/`;
}
---

<BaseLayout title="Blog | Insights, Trends & Enterprise Career Guides">
  <section class="pt-24 pb-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-heading font-extrabold text-slate-900 mb-6">Insights, Trends & Enterprise Career Guides</h1>
        <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed space-y-4">Stay updated with the latest in Enterprise IT, Cloud, and Software Engineering.</p>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map(post => {
          const wordCount = post.body ? post.body.split(/\s+/).length : 200;
          const readTime = Math.max(1, Math.ceil(wordCount / 200)) + " min read";
          const category = post.data.tags?.[0] || (post.data as any).category || "Career Guide";
          const formattedDate = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(post.data.pubDate));
          const decodedTitle = decodeHtmlEntities(post.data.title);
          const excerpt = resolveExcerpt(post.data.description, post.body || '');

          return (
            <a href={getPostUrl(post.id)} class="group relative flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-7 shadow-xs hover:border-emerald-500/60 hover:shadow-lg hover:shadow-emerald-500/10 hover:-translate-y-1 transition-all duration-300">
              <div class="flex flex-col flex-grow">
                
                {/* Top Meta Row */}
                <div class="flex items-center justify-between mb-4">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-[11px] font-semibold text-emerald-700 tracking-wide">
                    {category}
                  </span>
                  <div class="text-xs text-slate-400 font-medium flex items-center gap-2">
                    <time datetime={new Date(post.data.pubDate).toISOString()}>{formattedDate}</time>
                    <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                    <span>{readTime}</span>
                  </div>
                </div>
                
                {/* Card Body */}
                <h3 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight leading-snug line-clamp-2 mt-2 group-hover:text-emerald-600 transition-colors">
                  {decodedTitle}
                </h3>
                <p class="text-sm sm:text-base leading-relaxed text-slate-600 line-clamp-3 mt-3 flex-grow">
                  {excerpt}
                </p>
                
                {/* Footer Action Row */}
                <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                  <span class="text-xs font-medium text-slate-500">
                    {post.data.author || 'Ask4Trainings Editorial'}
                  </span>
                  <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-600 group-hover:text-emerald-500">
                    <span>Read Article</span>
                    <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
                  </span>
                </div>
                
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
