---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allBlogPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

// Sort by publishDate descending
const sortedPosts = allBlogPosts.sort(
  (a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()
);
const posts = sortedPosts.length > 0 ? sortedPosts : [
  {
    id: 'fallback',
    data: {
      title: 'Building Enterprise Architecture in 2026',
      description: 'Explore the key concepts in scaling cloud-native enterprise systems.',
      category: 'Architecture',
      publishDate: new Date().toISOString(),
      image: '/logo.svg'
    }
  }
];

function getPostUrl(id: string): string {
  const cleanSlug = id.replace(/\.mdx?$/, '');
  return `/blog/${cleanSlug}/`;
}
---

<BaseLayout title="Blog | Insights, Trends & Enterprise Career Guides">
  <section class="pt-24 pb-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-heading font-extrabold text-slate-900 mb-6">Insights, Trends & Enterprise Career Guides</h1>
        <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed space-y-4">Stay updated with the latest in Enterprise IT, Cloud, and Software Engineering.</p>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map(post => (
          <article class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-xl hover:border-emerald-200 transition-all duration-300 flex flex-col group relative">
            {post.data.image && (
              <div class="aspect-video w-full overflow-hidden bg-slate-100">
                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            )}
            <div class="p-6 flex flex-col flex-grow">
              <div class="flex items-center gap-3 mb-4">
                <span class="bg-emerald-50 text-emerald-700 text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider">
                  {post.data.category}
                </span>
                <time class="text-sm text-slate-500 font-medium" datetime={new Date(post.data.publishDate).toISOString()}>
                  admin / {new Date(post.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
              <h2 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-emerald-700 transition-colors line-clamp-2">
                <a href={getPostUrl(post.id)} class="focus:outline-none before:absolute before:inset-0">
                  {post.data.title}
                </a>
              </h2>
              <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed mb-6 line-clamp-3 flex-grow space-y-4">
                {post.data.description}
              </p>
              <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-emerald-600 font-semibold text-sm flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  Read More &rarr; <svg class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
