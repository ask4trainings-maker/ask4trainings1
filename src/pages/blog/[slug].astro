---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allBlogPosts = await getCollection('blog');
  return allBlogPosts.map(entry => {
    const slug = entry.id.replace(/\.mdx?$/, '');
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
import { decodeHtmlEntities } from '../../utils/text';

const decodedTitle = decodeHtmlEntities(entry.data.title);
const decodedDesc = decodeHtmlEntities(entry.data.description);

const formattedDate = new Date(entry.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={`${decodedTitle} | Ask 4 Trainings Blog`} description={decodedDesc}>
  
  <article class="pt-24 pb-20">
    <div class="max-w-4xl mx-auto px-6 sm:px-10 xl:px-0">
      
      <!-- Breadcrumbs -->
      <nav class="flex text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-emerald-600 transition-colors">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              <a href="/blog/" class="hover:text-emerald-600 transition-colors">Blog</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-slate-400 mx-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              <span class="text-slate-700 font-medium line-clamp-1">{decodedTitle}</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-12 border-b border-slate-200 pb-10 text-center">
        {entry.data.tags && entry.data.tags.map((tag: string) => (
          <span class="inline-block bg-emerald-50 text-emerald-700 text-sm font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-6 mr-2">
            {tag}
          </span>
        ))}
        <h1 class="text-3xl md:text-5xl font-heading font-extrabold text-slate-900 mb-6 leading-tight">
          {decodedTitle}
        </h1>
        <div class="flex items-center justify-center gap-4 text-slate-500 font-medium">
          <span>{entry.data.author || 'Ask4Trainings Editorial'}</span>
          <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
          <time datetime={new Date(entry.data.pubDate).toISOString()}>{formattedDate}</time>
        </div>
      </header>

      <!-- Featured Image -->
      {entry.data.image && (
        <div class="mb-12 aspect-[21/9] overflow-hidden rounded-2xl shadow-lg border border-slate-200">
          <img src={entry.data.image} alt={entry.data.title} class="w-full h-full object-cover" loading="lazy" />
        </div>
      )}

      <!-- Content -->
      <article class="prose prose-slate max-w-4xl mx-auto prose-emerald prose-a:text-emerald-600 hover:prose-a:text-emerald-500 prose-a:underline prose-a:underline-offset-2 prose-a:font-medium prose-a:transition-colors prose-headings:scroll-mt-20 prose-h2:mt-10 sm:prose-h2:mt-12 prose-h2:mb-4">
        <Content />
      </article>

      {entry.data.cta?.enabled !== false && (
        <div class="rounded-3xl border border-emerald-500/20 bg-slate-900 p-8 sm:p-10 text-center md:text-left mt-16 mb-8 shadow-xl flex flex-col md:flex-row items-center justify-between gap-8 w-full relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/10 to-transparent pointer-events-none"></div>
          <div class="flex-grow max-w-2xl relative z-10">
            <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">{entry.data.cta?.headline || 'Need a Demo Session? Let’s Connect'}</h3>
            <p class="text-base sm:text-lg text-slate-300 mt-3">{entry.data.cta?.subheadline || 'Get in touch with our expert advisors to book a free live interactive demo.'}</p>
          </div>
          <div class="flex flex-col sm:flex-row items-center justify-center md:justify-end gap-4 shrink-0 w-full md:w-auto mt-2 md:mt-0 relative z-10">
            <a href={`https://wa.me/918099949888?text=${encodeURIComponent(entry.data.cta?.whatsappMessage || 'Hi Ask4Trainings, I read your blog and want to attend a free live demo session.')}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-6 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-emerald-500 transition-all w-full sm:w-auto">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              WhatsApp Us
            </a>
            <a href={entry.data.cta?.enrollUrl || '/contact-us/'} class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/10 px-6 py-3.5 text-base font-semibold text-white hover:bg-white/20 transition-all w-full sm:w-auto">
              Enroll Now
            </a>
          </div>
        </div>
      )}

    </div>
  </article>

  <!-- Bottom Navigation / CTA -->
  <section class="bg-slate-50 py-16 border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Ready to accelerate your career?</h2>
      <p class="text-slate-600 mb-8 max-w-xl mx-auto">Discover our hands-on, expert-led training programs designed for Enterprise IT professionals.</p>
      <a href="/courses/" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-emerald-600 text-white font-semibold hover:bg-emerald-700 transition-all shadow-md hover:-translate-y-0.5">
        Explore Related Enterprise Courses <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.prose a').forEach(a => {
        try {
          if (a.hostname !== window.location.hostname) {
            a.setAttribute('target', '_blank');
            a.setAttribute('rel', 'noopener noreferrer');
          }
        } catch (e) {}
      });
    });
  </script>
</BaseLayout>
