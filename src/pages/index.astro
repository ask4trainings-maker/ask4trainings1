---
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Ask 4 Trainings",
  "url": "https://ask4trainings.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Ameerpet",
    "addressRegion": "Telangana",
    "addressCountry": "IN"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+91-8099949888",
    "contactType": "customer service"
  }
};

import BaseLayout from '../layouts/BaseLayout.astro';
import categoriesData from '../data/categories.json';
import homeData from '../data/pages/home.json';
import { getCollection } from 'astro:content';
import CourseCard from '../components/CourseCard.astro';
import EnquiryForm from '../components/EnquiryForm.astro';

const allCourses = await getCollection('courses');
// Sort or get featured courses (limit to 6 for the catalog display)
const displayCourses = allCourses.slice(0, 9);
const categories = Object.keys(categoriesData).map(key => ({
  slug: key,
  label: (categoriesData as any)[key].label
}));
---
<BaseLayout title="Ask 4 Trainings | Master Enterprise IT">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </Fragment>

  <!-- Hero Section -->
  <section class="relative overflow-hidden min-h-[90vh] flex items-center pt-24 pb-20 bg-white">
    <!-- Ambient Glows -->
    <div class="absolute -top-20 -right-20 w-96 h-96 bg-emerald-100/50 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute -bottom-20 left-1/4 w-80 h-80 bg-teal-50/60 rounded-full blur-3xl pointer-events-none -z-10"></div>
    
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-12 items-center">
      
      <!-- Left: Scaler Value Prop (7 cols) -->
      <div class="lg:col-span-7 xl:col-span-7 animate-fade-in-up">
        <!-- Live Batch Pill -->
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold px-3.5 py-1.5 rounded-full inline-flex items-center gap-2 mb-8">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          {homeData.hero.badge}
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-7xl font-heading font-extrabold text-slate-900 mb-6 leading-[1.1] tracking-tight">
          <Fragment set:html={homeData.hero.headline} />
          <span class="bg-gradient-to-r from-emerald-600 to-teal-500 bg-clip-text text-transparent font-extrabold">{homeData.hero.headlineGradient}</span>
        </h1>
        
        <p class="text-slate-600 text-lg leading-relaxed font-normal md:text-xl mb-10 max-w-2xl">
          {homeData.hero.subheadline}
        </p>

        <!-- Metric Counter Strip -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-10 border-y border-slate-200 py-6">
          {homeData.metrics.map((metric: any) => (
            <div>
              <div class="text-slate-900 font-bold text-2xl lg:text-3xl mb-1">{metric.value}</div>
              <div class="text-slate-500 text-xs font-semibold uppercase tracking-wider">{metric.label}</div>
            </div>
          ))}
        </div>

        <!-- Dual CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#course-catalog" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold transition-all duration-200 hover:bg-emerald-700 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-emerald-600/25 active:translate-y-0 group text-sm md:text-base">
            {homeData.hero.primaryCta}
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="#enquiry-section" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white border border-slate-200 text-slate-700 font-semibold transition-all duration-200 hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50/40 hover:-translate-y-0.5 text-sm md:text-base">
            {homeData.hero.secondaryCta}
          </a>
        </div>
      </div>

      <!-- Right: Human Illustration (5 cols) -->
      <div class="lg:col-span-5 xl:col-span-5 relative flex items-center justify-center lg:justify-end w-full animate-fade-in" style="animation-delay: 0.2s;">
        <!-- Illustration Container -->
        <div class="relative w-full max-w-lg aspect-square flex items-center justify-center">
          <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full drop-shadow-2xl">
            <!-- Background Blob -->
            <path d="M304.5 106.5C345.5 146.5 358.5 211.5 334.5 259.5C310.5 307.5 249.5 338.5 186.5 331.5C123.5 324.5 58.5 279.5 39.5 219.5C20.5 159.5 47.5 84.5 98.5 46.5C149.5 8.5 224.5 25.5 264.5 66.5Z" fill="#ecfdf5"/>
            <!-- Desk -->
            <rect x="50" y="280" width="300" height="15" rx="7.5" fill="#cbd5e1"/>
            <rect x="80" y="295" width="20" height="80" fill="#94a3b8"/>
            <rect x="300" y="295" width="20" height="80" fill="#94a3b8"/>
            <!-- Body -->
            <path d="M120 280C120 200 160 160 200 160C240 160 280 200 280 280H120Z" fill="#10b981"/>
            <path d="M140 280C140 220 170 190 200 190C230 190 260 220 260 280H140Z" fill="#059669"/>
            <!-- Head -->
            <circle cx="200" cy="120" r="45" fill="#fde68a"/>
            <!-- Hair -->
            <path d="M155 120C155 80 180 70 200 70C220 70 245 80 245 120C245 100 220 90 200 90C180 90 155 100 155 120Z" fill="#0f766e"/>
            <!-- Laptop -->
            <path d="M220 280H310L290 210H200L220 280Z" fill="#64748b"/>
            <rect x="180" y="275" width="150" height="10" rx="4" fill="#475569"/>
            <path d="M240 240H270" stroke="#f8fafc" stroke-width="4" stroke-linecap="round"/>
          </svg>

          <!-- Floating Badges -->
          <div class="absolute -bottom-3 left-4 bg-white/95 backdrop-blur-md border border-emerald-100 shadow-xl rounded-xl p-3 flex items-center gap-2.5 text-xs text-slate-800">
            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            100% Practical Labs
          </div>
          <div class="absolute top-4 -right-2 bg-white/95 backdrop-blur-md border border-emerald-100 shadow-xl rounded-xl p-3 flex items-center gap-2.5 text-xs text-slate-800">
            <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            Industry Mentors
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Category Filter & Course Catalog -->
  <section id="course-catalog" class="py-20 relative">
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-4">Enterprise Course Catalog</h2>
        <p class="text-slate-500 max-w-2xl mx-auto">Filter by specialized domains to find your targeted career track.</p>
      </div>

      <!-- Horizontal Pill Selector -->
      <div class="flex gap-3 overflow-x-auto pb-4 mb-10 scrollbar-hide snap-x justify-start md:justify-center">
        <button class="filter-btn active shrink-0 px-5 py-2 rounded-full border border-primary text-primary-light bg-primary/20 text-sm font-semibold transition-all hover:bg-primary/30" data-filter="all">
          All Courses
        </button>
        {categories.map(cat => (
          <button class="filter-btn shrink-0 px-5 py-2 rounded-full border border-slate-200 text-slate-600 bg-white/5 text-sm font-medium transition-all hover:border-white/30 hover:bg-white/10" data-filter={cat.slug}>
            {cat.label}
          </button>
        ))}
      </div>

      <!-- 3-Column Course Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="course-grid">
        {displayCourses.map(course => (
          <div class="course-item" data-category={course.data.category}>
            <CourseCard 
              title={course.data.title}
              category={course.data.category}
              duration={course.data.batchInfo.duration}
              format={course.data.batchInfo.format}
              slug={course.data.slug}
            />
          </div>
        ))}
      </div>
      
      <div class="mt-12 text-center">
        <a href="/courses" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-slate-900 group border-b border-dashed border-slate-600 hover:border-surface-0 transition-all pb-1">
          View Entire Catalog 
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- LMS Learning Ecosystem Bento Grid -->
  <section class="py-24 relative">
    <!-- Ambient Glow -->
    <div class="absolute top-1/2 left-0 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-radial from-primary/10 via-transparent to-transparent opacity-50 pointer-events-none"></div>
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <div class="mb-12">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-4">The Ask4Trainings Learning Ecosystem</h2>
        <p class="text-slate-500 max-w-2xl">A complete end-to-end framework designed for enterprise skill mastery.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[280px]">
        
        <!-- Live Classes -->
        <div class="lg:col-span-2 bg-white/50 backdrop-blur-md border border-slate-200 rounded-2xl p-8 flex flex-col justify-end relative overflow-hidden group hover:border-primary/40 transition-colors">
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent z-10 pointer-events-none"></div>
          <div class="absolute top-0 right-0 w-64 h-64 bg-primary/20 blur-[80px] group-hover:bg-primary/30 transition-colors"></div>
          
          <div class="relative z-20">
            <div class="w-12 h-12 rounded-xl bg-primary/20 flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-primary-light" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="text-2xl font-bold font-heading text-slate-900 mb-2">{homeData.bento[0].title}</h3>
            <p class="text-slate-500">{homeData.bento[0].description}</p>
          </div>
        </div>

        <!-- Cloud Sandboxes -->
        <div class="bg-white/50 backdrop-blur-md border border-slate-200 rounded-2xl p-8 flex flex-col justify-end relative overflow-hidden group hover:border-accent/40 transition-colors">
          <div class="absolute top-0 left-0 w-48 h-48 bg-accent/10 blur-[60px] group-hover:bg-accent/20 transition-colors"></div>
          
          <div class="relative z-20">
            <div class="w-12 h-12 rounded-xl bg-accent/20 flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-accent-light" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
            </div>
            <h3 class="text-xl font-bold font-heading text-slate-900 mb-2">{homeData.bento[1].title}</h3>
            <p class="text-slate-500 text-sm">{homeData.bento[1].description}</p>
          </div>
        </div>

        <!-- PDF Vault -->
        <div class="bg-white/50 backdrop-blur-md border border-slate-200 rounded-2xl p-8 flex flex-col justify-end relative overflow-hidden group hover:border-blue-500/40 transition-colors">
          <div class="absolute bottom-0 right-0 w-48 h-48 bg-blue-500/10 blur-[60px] group-hover:bg-blue-500/20 transition-colors"></div>
          
          <div class="relative z-20">
            <div class="w-12 h-12 rounded-xl bg-blue-500/20 flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <h3 class="text-xl font-bold font-heading text-slate-900 mb-2">{homeData.bento[2].title}</h3>
            <p class="text-slate-500 text-sm">{homeData.bento[2].description}</p>
          </div>
        </div>

        <!-- Mock Interviews -->
        <div class="lg:col-span-2 bg-white/50 backdrop-blur-md border border-slate-200 rounded-2xl p-8 flex flex-col justify-end relative overflow-hidden group hover:border-whatsapp/40 transition-colors">
          <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMiIgY3k9IjIiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wNSkiLz48L3N2Zz4=')] opacity-50"></div>
          <div class="absolute bottom-0 left-0 w-64 h-64 bg-whatsapp/10 blur-[80px] group-hover:bg-whatsapp/20 transition-colors"></div>
          
          <div class="relative z-20">
            <div class="w-12 h-12 rounded-xl bg-whatsapp/20 flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-whatsapp" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <h3 class="text-2xl font-bold font-heading text-slate-900 mb-2">{homeData.bento[3].title}</h3>
            <p class="text-slate-500">{homeData.bento[3].description}</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Career Transition Roadmap -->
  <section class="py-24 relative">
    <!-- Ambient Glow -->
    <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-radial from-accent/5 via-transparent to-transparent opacity-50 pointer-events-none"></div>
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-4">Structured Career Roadmap</h2>
        <p class="text-slate-500 max-w-2xl mx-auto">From fundamentals to your first offer letter.</p>
      </div>

      <div class="relative max-w-5xl mx-auto">
        <!-- Connecting Line -->
        <div class="absolute top-1/2 left-0 w-full h-1 bg-white/5 -translate-y-1/2 hidden md:block"></div>
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative z-10">
          <!-- Step 1 -->
          <div class="bg-white/80 backdrop-blur-md border border-slate-200 p-6 rounded-2xl text-center relative group hover:border-primary/40 transition-colors">
            <div class="w-12 h-12 rounded-full bg-slate-100 border-2 border-primary text-primary-light flex items-center justify-center text-lg font-bold mx-auto mb-4 relative">
              1
              <div class="absolute -bottom-2 -right-2 w-4 h-4 bg-primary rounded-full border-2 border-slate-900"></div>
            </div>
            <h4 class="font-bold text-slate-900 mb-2">{homeData.roadmap[0].title}</h4>
            <p class="text-xs text-slate-500">{homeData.roadmap[0].description}</p>
          </div>
          <!-- Step 2 -->
          <div class="bg-white/80 backdrop-blur-md border border-slate-200 p-6 rounded-2xl text-center relative group hover:border-primary/40 transition-colors">
            <div class="w-12 h-12 rounded-full bg-slate-100 border-2 border-primary text-primary-light flex items-center justify-center text-lg font-bold mx-auto mb-4 relative">
              2
              <div class="absolute -bottom-2 -right-2 w-4 h-4 bg-primary rounded-full border-2 border-slate-900"></div>
            </div>
            <h4 class="font-bold text-slate-900 mb-2">{homeData.roadmap[1].title}</h4>
            <p class="text-xs text-slate-500">{homeData.roadmap[1].description}</p>
          </div>
          <!-- Step 3 -->
          <div class="bg-white/80 backdrop-blur-md border border-slate-200 p-6 rounded-2xl text-center relative group hover:border-accent/40 transition-colors">
            <div class="w-12 h-12 rounded-full bg-slate-100 border-2 border-accent text-accent-light flex items-center justify-center text-lg font-bold mx-auto mb-4 relative">
              3
              <div class="absolute -bottom-2 -right-2 w-4 h-4 bg-accent rounded-full border-2 border-slate-900"></div>
            </div>
            <h4 class="font-bold text-slate-900 mb-2">{homeData.roadmap[2].title}</h4>
            <p class="text-xs text-slate-500">{homeData.roadmap[2].description}</p>
          </div>
          <!-- Step 4 -->
          <div class="bg-white/80 backdrop-blur-md border border-slate-200 p-6 rounded-2xl text-center relative group hover:border-whatsapp/40 transition-colors">
            <div class="w-12 h-12 rounded-full bg-slate-100 border-2 border-whatsapp text-whatsapp flex items-center justify-center text-lg font-bold mx-auto mb-4 relative">
              4
              <div class="absolute -bottom-2 -right-2 w-4 h-4 bg-whatsapp rounded-full border-2 border-slate-900 animate-pulse"></div>
            </div>
            <h4 class="font-bold text-slate-900 mb-2">{homeData.roadmap[3].title}</h4>
            <p class="text-xs text-slate-500">{homeData.roadmap[3].description}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion Bottom Section -->
  <section id="enquiry-section" class="py-24 relative overflow-hidden">
    <!-- Glows -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/10 rounded-full blur-[150px] pointer-events-none"></div>

    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full grid lg:grid-cols-2 gap-16 items-center relative z-10">
      <div>
        <h2 class="text-3xl md:text-5xl font-heading font-bold text-slate-900 mb-6 leading-tight">
          <Fragment set:html={homeData.conversion.headline} />
        </h2>
        <p class="text-lg text-slate-500 mb-8 max-w-lg leading-relaxed">
          {homeData.conversion.subtext}
        </p>
        <div class="flex items-center gap-4 text-sm text-slate-600">
          <div class="flex -space-x-3">
            <img class="w-10 h-10 rounded-full border-2 border-slate-900" src="https://ui-avatars.com/api/?name=Admin&background=0D6E4F&color=fff" alt="Counselor">
            <img class="w-10 h-10 rounded-full border-2 border-slate-900" src="https://ui-avatars.com/api/?name=Tech&background=F59E0B&color=fff" alt="Counselor">
            <div class="w-10 h-10 rounded-full border-2 border-slate-900 bg-slate-100 flex items-center justify-center text-xs font-bold">+5</div>
          </div>
          <div>
            <div class="font-bold text-slate-900">Response time: &lt; 2 hours</div>
            <div class="text-slate-500">During business hours</div>
          </div>
        </div>
      </div>
      
      <div class="w-full max-w-md mx-auto lg:mr-0 lg:ml-auto">
        <EnquiryForm title="Request Call Back" subtitle="Our team will contact you shortly." />
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // Course Category Filtering Logic
  const filterBtns = document.querySelectorAll('.filter-btn');
  const courseItems = document.querySelectorAll('.course-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active button styling
      filterBtns.forEach(b => {
        b.classList.remove('active', 'border-primary', 'text-primary-light', 'bg-primary/20');
        b.classList.add('border-slate-200', 'text-slate-600', 'bg-white/5');
      });
      btn.classList.remove('border-slate-200', 'text-slate-600', 'bg-white/5');
      btn.classList.add('active', 'border-primary', 'text-primary-light', 'bg-primary/20');

      const filter = btn.getAttribute('data-filter');

      // Filter courses
      courseItems.forEach(item => {
        if (filter === 'all' || item.getAttribute('data-category') === filter) {
          (item as HTMLElement).style.display = 'block';
          // Small animation restart
          (item as HTMLElement).style.animation = 'none';
          (item as HTMLElement).offsetHeight; // trigger reflow
          (item as HTMLElement).style.animation = 'fadeInUp 0.4s ease forwards';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
