</BaseLayout>

<script>
  // Hero Section IDE Tab Switcher Logic
  const tabs = document.querySelectorAll('.ide-tab');
  const contents = document.querySelectorAll('.ide-content');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Remove active states
      tabs.forEach(t => {
        t.classList.remove('active', 'border-primary', 'text-white/80', 'bg-white/5');
        t.classList.add('border-transparent', 'text-slate-500');
      });
      contents.forEach(c => {
        c.classList.remove('opacity-100');
        c.classList.add('opacity-0', 'pointer-events-none');
      });

      // Add active state to clicked
      tab.classList.remove('border-transparent', 'text-slate-500');
      tab.classList.add('active', 'border-primary', 'text-white/80', 'bg-white/5');
      
      const targetId = tab.getAttribute('data-target');
      if (targetId) {
        const targetContent = document.getElementById(targetId);
        if (targetContent) {
          targetContent.classList.remove('opacity-0', 'pointer-events-none');
          targetContent.classList.add('opacity-100');
        }
      }
    });
  });

  // Course Category Filtering Logic
  const filterBtns = document.querySelectorAll('.filter-btn');
  const courseItems = document.querySelectorAll('.course-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active button styling
      filterBtns.forEach(b => {
        b.classList.remove('active', 'border-primary', 'text-primary-light', 'bg-primary/20');
        b.classList.add('border-white/10', 'text-slate-300', 'bg-white/5');
      });
      btn.classList.remove('border-white/10', 'text-slate-300', 'bg-white/5');
      btn.classList.add('active', 'border-primary', 'text-primary-light', 'bg-primary/20');

      const filter = btn.getAttribute('data-filter');

      // Filter courses
      courseItems.forEach(item => {
        if (filter === 'all' || item.getAttribute('data-category') === filter) {
          (item as HTMLElement).style.display = 'block';
          // Small animation restart
          (item as HTMLElement).style.animation = 'none';
          (item as HTMLElement).offsetHeight; // trigger reflow
          (item as HTMLElement).style.animation = 'fadeInUp 0.4s ease forwards';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
