---
import BaseLayout from '../layouts/BaseLayout.astro';
import categoriesData from '../content/categories.json';
import { getCollection } from 'astro:content';
import CourseCard from '../components/CourseCard.astro';

const allCourses = await getCollection('courses');
const featuredCourses = allCourses.slice(0, 3);
const categories = Object.keys(categoriesData).map(key => ({
  key,
  label: (categoriesData as any)[key].label
}));
---
<BaseLayout title="Ask 4 Trainings | Leading IT Training Institute in Hyderabad">
  <!-- Hero Section -->
  <section class="bg-surface-50 border-b border-border py-20 relative overflow-hidden">
    <div class="container mx-auto px-4 text-center max-w-4xl relative z-10">
      <h1 class="text-4xl md:text-6xl font-heading font-bold text-ink-900 mb-6 leading-tight">Accelerate Your IT Career with Expert-Led Training</h1>
      <p class="text-xl text-ink-700 mb-10">Master Enterprise Technologies like Guidewire, SAP, Salesforce, and Cloud Computing with 100% Placement Assistance.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/courses" class="bg-primary hover:bg-primary-hover text-surface-0 font-medium px-8 py-4 rounded-lg transition-colors text-lg">Explore Courses</a>
        <a href="/contact-us" class="bg-surface-0 text-primary border border-primary hover:bg-surface-50 font-medium px-8 py-4 rounded-lg transition-colors text-lg">Contact Us</a>
      </div>
    </div>
  </section>

  <!-- Metrics/Trust -->
  <section class="py-12 bg-primary text-surface-0">
    <div class="container mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <div class="text-3xl md:text-4xl font-bold font-heading mb-2">15+</div>
        <div class="text-primary-light">Years Experience</div>
      </div>
      <div>
        <div class="text-3xl md:text-4xl font-bold font-heading mb-2">50,000+</div>
        <div class="text-primary-light">Students Trained</div>
      </div>
      <div>
        <div class="text-3xl md:text-4xl font-bold font-heading mb-2">100%</div>
        <div class="text-primary-light">Placement Support</div>
      </div>
      <div>
        <div class="text-3xl md:text-4xl font-bold font-heading mb-2">200+</div>
        <div class="text-primary-light">Corporate Clients</div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-center text-ink-900 mb-12">Browse by Category</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {categories.map(cat => (
          <a href={`/courses/${cat.key}`} class="group bg-surface-50 border border-border rounded-xl p-6 text-center hover:shadow-md hover:border-primary transition-all">
            <h3 class="font-heading font-semibold text-ink-900 group-hover:text-primary transition-colors">{cat.label}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Courses -->
  <section class="py-20 bg-surface-50 border-t border-border">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-center text-ink-900 mb-12">Trending Courses</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredCourses.map(course => (
          <CourseCard 
            title={course.data.title}
            category={course.data.category}
            duration={course.data.batchInfo.duration}
            format={course.data.batchInfo.format}
            slug={course.data.slug}
          />
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/courses" class="inline-block border-2 border-primary text-primary hover:bg-primary hover:text-surface-0 font-medium px-8 py-3 rounded-lg transition-colors">View All Courses</a>
      </div>
    </div>
  </section>
</BaseLayout>
