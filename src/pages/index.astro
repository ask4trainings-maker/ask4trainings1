            <p class="text-xs text-slate-400">{homeData.roadmap[3].description}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion Bottom Section -->
  <section id="enquiry-section" class="py-24 relative overflow-hidden">
    <!-- Glows -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/10 rounded-full blur-[150px] pointer-events-none"></div>

    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full grid lg:grid-cols-2 gap-16 items-center relative z-10">
      <div>
        <h2 class="text-3xl md:text-5xl font-heading font-bold text-surface-0 mb-6 leading-tight">
          <Fragment set:html={homeData.conversion.headline} />
        </h2>
        <p class="text-lg text-slate-400 mb-8 max-w-lg leading-relaxed">
          {homeData.conversion.subtext}
        </p>
        <div class="flex items-center gap-4 text-sm text-slate-300">
          <div class="flex -space-x-3">
            <img class="w-10 h-10 rounded-full border-2 border-slate-900" src="https://ui-avatars.com/api/?name=Admin&background=0D6E4F&color=fff" alt="Counselor">
            <img class="w-10 h-10 rounded-full border-2 border-slate-900" src="https://ui-avatars.com/api/?name=Tech&background=F59E0B&color=fff" alt="Counselor">
            <div class="w-10 h-10 rounded-full border-2 border-slate-900 bg-slate-800 flex items-center justify-center text-xs font-bold">+5</div>
          </div>
          <div>
            <div class="font-bold text-surface-0">Response time: &lt; 2 hours</div>
            <div class="text-slate-500">During business hours</div>
          </div>
        </div>
      </div>
      
      <div class="w-full max-w-md mx-auto lg:mr-0 lg:ml-auto">
        <EnquiryForm title="Request Call Back" subtitle="Our team will contact you shortly." />
      </div>
    </div>
