---
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Ask 4 Trainings",
  "url": "https://ask4trainings.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Ameerpet",
    "addressRegion": "Telangana",
    "addressCountry": "IN"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+91-8099949888",
    "contactType": "customer service"
  }
};

import BaseLayout from '../layouts/BaseLayout.astro';
import categoriesData from '../data/categories.json';
import homeData from '../data/pages/home.json';
import { getCollection } from 'astro:content';
import CourseCard from '../components/CourseCard.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Ecosystem from '../components/Ecosystem.astro';

const allCourses = await getCollection('courses');
// Sort alphabetically by title for consistent ordering
const sortedCourses = [...allCourses].sort((a, b) => a.data.title.localeCompare(b.data.title));
const totalCourses = sortedCourses.length;

// Derive unique categories from the live collection, ordered by category definition
const categoryOrder = categoriesData.categories.map((c: any) => c.id);
const uniqueCategoryIds = [...new Set(sortedCourses.map(c => c.data.category))]
  .sort((a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b));
const categories = uniqueCategoryIds.map(id => {
  const meta = categoriesData.categories.find((c: any) => c.id === id);
  return { slug: id, label: meta?.title ?? id };
});

// Clean title: strip legacy prefixes from display
function cleanTitle(title: string): string {
  return title
    .replace(/^(Best\s+|Course\s+Tag\s*[-–]?\s*|Courses\s*)/i, '')
    .replace(/\s{2,}/g, ' ')
    .trim();
}
---
<BaseLayout title="Ask 4 Trainings | Master Enterprise IT">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </Fragment>

  <!-- Hero Section -->
  <section class="relative overflow-hidden min-h-[90vh] flex items-center pt-24 pb-20 bg-white">
    <!-- Ambient Glows -->
    <div class="absolute -top-20 -right-20 w-96 h-96 bg-emerald-100/50 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute -bottom-20 left-1/4 w-80 h-80 bg-teal-50/60 rounded-full blur-3xl pointer-events-none -z-10"></div>
    
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-12 items-center">
      
      <!-- Left: Scaler Value Prop (7 cols) -->
      <div class="lg:col-span-7 xl:col-span-7 animate-fade-in-up">
        <!-- Live Batch Pill -->
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold px-3.5 py-1.5 rounded-full inline-flex items-center gap-2 mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          {homeData.hero.badge}
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-7xl font-heading font-extrabold text-slate-900 mb-6 leading-[1.1] tracking-tight">
          <Fragment set:html={homeData.hero.headline} />
          <span class="bg-gradient-to-r from-emerald-600 to-teal-500 bg-clip-text text-transparent font-extrabold">{homeData.hero.headlineGradient}</span>
        </h1>
        
        <p class="text-slate-600 text-lg leading-relaxed font-normal md:text-xl mb-8 max-w-2xl">
          {homeData.hero.subheadline}
        </p>

        <!-- Dual CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          <a href="#course-catalog" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 text-white font-semibold transition-all duration-200 hover:bg-emerald-700 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-emerald-600/25 active:translate-y-0 group text-sm md:text-base">
            {homeData.hero.primaryCta}
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="#enquiry-section" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-slate-900 bg-white text-slate-900 font-bold hover:bg-slate-900 hover:text-white transition-all shadow-sm text-sm md:text-base hover:-translate-y-0.5">
            {homeData.hero.secondaryCta}
          </a>
        </div>

        <!-- Metric Counter Strip -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-10 border-y border-slate-200 py-6">
          {homeData.metrics.map((metric: any) => (
            <div>
              <div class="text-slate-900 font-bold text-2xl lg:text-3xl mb-1">{metric.value}</div>
              <div class="text-slate-500 text-xs font-semibold uppercase tracking-wider">{metric.label}</div>
            </div>
          ))}
        </div>

        <!-- Enterprise Hiring Partner Trust Bar -->
        <div>
          <div class="text-[11px] font-semibold tracking-wider uppercase text-slate-400 mb-3">
            Alumni Working At Top Global Enterprises
          </div>
          <div class="flex flex-wrap items-center gap-6 md:gap-10 text-slate-400 font-semibold text-xs tracking-wider uppercase">
            <span class="grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all duration-300">Accenture</span>
            <span class="grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all duration-300">Deloitte</span>
            <span class="grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all duration-300">Capgemini</span>
            <span class="grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all duration-300">Cognizant</span>
          </div>
        </div>
      </div>

      <!-- Right: Hero Student Image (5 cols) -->
      <div class="lg:col-span-5 xl:col-span-5 relative flex items-center justify-center lg:justify-end w-full animate-fade-in" style="animation-delay: 0.2s;">
        <!-- Image Container with Floating Elements -->
        <div class="relative w-full max-w-sm sm:max-w-md">
          <!-- Ambient Glow behind Image -->
          <div class="absolute -inset-4 bg-gradient-to-tr from-emerald-500/15 to-teal-500/10 rounded-3xl blur-2xl -z-10 pointer-events-none" aria-hidden="true"></div>

          <!-- Rounded Image Card with Fade Mask -->
          <div class="relative w-full aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl shadow-emerald-950/10 border border-slate-100/80 bg-slate-50">
            <img
              src="/assets/student_image.jpg"
              alt="Ask 4 Trainings student preparing for enterprise IT careers"
              class="w-full h-full object-cover object-top transform hover:scale-105 transition-transform duration-500 ease-out [mask-image:linear-gradient(to_bottom,black_85%,transparent_100%)]"
              width="417"
              height="626"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <!-- Floating Badges -->
          <div class="absolute -bottom-3 -left-3 sm:-left-5 backdrop-blur-md bg-white/90 dark:bg-slate-900/90 border border-white/20 dark:border-slate-700/50 shadow-xl rounded-2xl p-3 flex items-center gap-3 z-10">
            <span class="relative flex h-3 w-3 shrink-0">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
            </span>
            <span class="text-sm font-semibold text-slate-800 dark:text-white">24/7 Live Sandbox Access</span>
          </div>
          <div class="absolute top-6 -right-2 sm:-right-4 backdrop-blur-md bg-white/90 dark:bg-slate-900/90 border border-white/20 dark:border-slate-700/50 shadow-xl rounded-2xl p-3 flex items-center gap-3 z-10">
            <span class="text-xl leading-none">⭐</span>
            <span class="flex flex-col text-left">
              <span class="text-sm font-semibold text-slate-800 dark:text-white leading-tight">4.9/5</span>
              <span class="text-[10px] font-normal text-slate-500 dark:text-slate-400 leading-tight">(10k+ Reviews)</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Category Filter & Course Catalog -->
  <section id="course-catalog" class="py-20 relative">
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-4">Enterprise Course Catalog</h2>
        <p class="text-slate-500 max-w-2xl mx-auto">Filter by specialized domains to find your targeted career track.</p>
      </div>

      <!-- Horizontal Pill Selector -->
      <div class="flex gap-3 overflow-x-auto pb-4 mb-10 scrollbar-hide snap-x justify-start md:justify-center">
        <button class="filter-btn shrink-0 px-5 py-2 rounded-full border text-sm font-medium transition-all data-[active=true]:bg-emerald-600 data-[active=true]:text-white data-[active=true]:border-emerald-600 data-[active=true]:shadow-sm data-[active=false]:bg-white data-[active=false]:border-slate-200 data-[active=false]:text-slate-700 hover:data-[active=false]:border-emerald-500 hover:data-[active=false]:text-emerald-600" data-filter="all" data-active="true">
          All Courses
        </button>
        {categories.map(cat => (
          <button class="filter-btn shrink-0 px-5 py-2 rounded-full border text-sm font-medium transition-all data-[active=true]:bg-emerald-600 data-[active=true]:text-white data-[active=true]:border-emerald-600 data-[active=true]:shadow-sm data-[active=false]:bg-white data-[active=false]:border-slate-200 data-[active=false]:text-slate-700 hover:data-[active=false]:border-emerald-500 hover:data-[active=false]:text-emerald-600" data-filter={cat.slug} data-active="false">
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Course Count Badge -->
      <div class="flex items-center justify-center gap-3 mb-8">
        <span class="text-xs font-mono text-slate-400 tabular-nums">
          Showing <span id="visible-count" class="font-bold text-slate-700">{totalCourses}</span> of <span class="font-bold text-emerald-600">{totalCourses}</span> courses
        </span>
      </div>

      <!-- 3-Column Course Grid (all courses, progressive disclosure) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="course-grid">
        {sortedCourses.map((course, idx) => (
          <div
            class={`course-item transition-all duration-300${idx >= 12 ? ' catalog-extra hidden' : ''}`}
            data-category={course.data.category}
          >
            <CourseCard 
              title={cleanTitle(course.data.title)}
              category={course.data.category}
              duration={course.data.batchInfo.duration}
              format={course.data.batchInfo.format}
              slug={course.data.slug}
            />
          </div>
        ))}
      </div>

      <!-- Progressive Disclosure Controls -->
      <div class="mt-10 text-center flex flex-col sm:flex-row items-center justify-center gap-4">
        <button
          id="show-more-btn"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-slate-100 hover:bg-emerald-50 border border-slate-200 hover:border-emerald-400 text-sm font-semibold text-slate-700 hover:text-emerald-700 transition-all"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          Show All {totalCourses} Courses
        </button>
        <a href="/courses/" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-emerald-600 group border-b border-dashed border-slate-300 hover:border-emerald-400 transition-all pb-1">
          View Full Catalog →
        </a>
      </div>
    </div>
  </section>

  <Ecosystem />

  <!-- Career Transition Roadmap -->
  <section class="py-24 relative">
    <!-- Ambient Glow -->
    <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-radial from-accent/5 via-transparent to-transparent opacity-50 pointer-events-none"></div>
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-4">Structured Career Roadmap</h2>
        <p class="text-slate-500 max-w-2xl mx-auto">From fundamentals to your first offer letter.</p>
      </div>

      <div class="relative max-w-5xl mx-auto">
        <!-- Connecting Line -->
        <div class="absolute top-1/2 left-0 w-full h-1 bg-slate-200 -translate-y-1/2 hidden md:block"></div>
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative z-10">
          <!-- Step 1 -->
          <div class="bg-white/80 backdrop-blur-md border border-slate-200 p-6 rounded-2xl text-center relative group hover:border-emerald-600/40 transition-colors shadow-sm">
            <div class="w-12 h-12 rounded-full bg-slate-100 border-2 border-emerald-600 text-emerald-600 flex items-center justify-center text-lg font-bold mx-auto mb-4 relative">
              1
              <div class="absolute -bottom-2 -right-2 w-4 h-4 bg-emerald-600 rounded-full border-2 border-white shadow-sm"></div>
            </div>
            <h4 class="font-bold text-slate-900 mb-2">{homeData.roadmap[0].title}</h4>
            <p class="text-xs text-slate-500">{homeData.roadmap[0].description}</p>
          </div>
          <!-- Step 2 -->
          <div class="bg-white/80 backdrop-blur-md border border-slate-200 p-6 rounded-2xl text-center relative group hover:border-emerald-600/40 transition-colors shadow-sm">
            <div class="w-12 h-12 rounded-full bg-slate-100 border-2 border-emerald-600 text-emerald-600 flex items-center justify-center text-lg font-bold mx-auto mb-4 relative">
              2
              <div class="absolute -bottom-2 -right-2 w-4 h-4 bg-emerald-600 rounded-full border-2 border-white shadow-sm"></div>
            </div>
            <h4 class="font-bold text-slate-900 mb-2">{homeData.roadmap[1].title}</h4>
            <p class="text-xs text-slate-500">{homeData.roadmap[1].description}</p>
          </div>
          <!-- Step 3 -->
          <div class="bg-white/80 backdrop-blur-md border border-slate-200 p-6 rounded-2xl text-center relative group hover:border-emerald-600/40 transition-colors shadow-sm">
            <div class="w-12 h-12 rounded-full bg-slate-100 border-2 border-emerald-600 text-emerald-600 flex items-center justify-center text-lg font-bold mx-auto mb-4 relative">
              3
              <div class="absolute -bottom-2 -right-2 w-4 h-4 bg-emerald-600 rounded-full border-2 border-white shadow-sm"></div>
            </div>
            <h4 class="font-bold text-slate-900 mb-2">{homeData.roadmap[2].title}</h4>
            <p class="text-xs text-slate-500">{homeData.roadmap[2].description}</p>
          </div>
          <!-- Step 4 -->
          <div class="bg-white/80 backdrop-blur-md border border-slate-200 p-6 rounded-2xl text-center relative group hover:border-emerald-600/40 transition-colors shadow-sm">
            <div class="w-12 h-12 rounded-full bg-slate-100 border-2 border-emerald-600 text-emerald-600 flex items-center justify-center text-lg font-bold mx-auto mb-4 relative">
              4
              <div class="absolute -bottom-2 -right-2 w-4 h-4 bg-emerald-600 rounded-full border-2 border-white shadow-sm animate-pulse"></div>
            </div>
            <h4 class="font-bold text-slate-900 mb-2">{homeData.roadmap[3].title}</h4>
            <p class="text-xs text-slate-500">{homeData.roadmap[3].description}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion Bottom Section -->
  <section id="enquiry-section" class="py-24 relative overflow-hidden">
    <!-- Glows -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-emerald-600/10 rounded-full blur-[150px] pointer-events-none"></div>

    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full grid lg:grid-cols-2 gap-16 items-center relative z-10">
      <div>
        <h2 class="text-3xl md:text-5xl font-heading font-bold text-slate-900 mb-6 leading-tight">
          <Fragment set:html={homeData.conversion.headline} />
        </h2>
        <p class="text-lg text-slate-500 mb-8 max-w-lg leading-relaxed">
          {homeData.conversion.subtext}
        </p>
        <div class="flex items-center gap-4 text-sm text-slate-600">
          <div class="flex -space-x-3">
            <img class="w-10 h-10 rounded-full border-2 border-white shadow-sm" src="https://ui-avatars.com/api/?name=Admin&background=0D6E4F&color=fff" alt="Counselor">
            <img class="w-10 h-10 rounded-full border-2 border-white shadow-sm" src="https://ui-avatars.com/api/?name=Tech&background=F59E0B&color=fff" alt="Counselor">
            <div class="w-10 h-10 rounded-full border-2 border-white bg-slate-100 flex items-center justify-center text-xs font-bold shadow-sm">+5</div>
          </div>
          <div>
            <div class="font-bold text-slate-900">Response time: &lt; 2 hours</div>
            <div class="text-slate-500">During business hours</div>
          </div>
        </div>
      </div>
      
      <div class="w-full max-w-md mx-auto lg:mr-0 lg:ml-auto">
        <EnquiryForm title="Request Call Back" subtitle="Our team will contact you shortly." />
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // ── Course Catalog: Filtering + Progressive Disclosure ─────────────────
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const courseItems = document.querySelectorAll<HTMLElement>('.course-item');
  const showMoreBtn = document.getElementById('show-more-btn') as HTMLButtonElement | null;
  const visibleCountEl = document.getElementById('visible-count');

  let expandedAll = false;
  let currentFilter = 'all';

  function updateVisibleCount() {
    const visible = document.querySelectorAll<HTMLElement>('.course-item:not([style*="display: none"])').length;
    if (visibleCountEl) visibleCountEl.textContent = String(visible);
  }

  function applyFilter(filter: string) {
    currentFilter = filter;
    let shownCount = 0;

    courseItems.forEach((item) => {
      const matchesCategory = filter === 'all' || item.getAttribute('data-category') === filter;
      const isExtra = item.classList.contains('catalog-extra');

      if (matchesCategory && (!isExtra || expandedAll || filter !== 'all')) {
        item.style.display = 'block';
        item.style.animation = 'none';
        void item.offsetHeight;
        item.style.animation = 'fadeInUp 0.35s ease forwards';
        shownCount++;
      } else if (!matchesCategory) {
        item.style.display = 'none';
      } else if (isExtra && !expandedAll && filter === 'all') {
        item.style.display = 'none';
      } else {
        item.style.display = 'block';
        shownCount++;
      }
    });

    updateVisibleCount();

    // Hide show-more when a specific category is active (show all for that category)
    if (showMoreBtn) {
      showMoreBtn.style.display = filter === 'all' && !expandedAll ? 'inline-flex' : 'none';
    }
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.setAttribute('data-active', 'false'));
      btn.setAttribute('data-active', 'true');
      const filter = btn.getAttribute('data-filter') ?? 'all';
      expandedAll = false; // reset expand state on filter change
      applyFilter(filter);
    });
  });

  showMoreBtn?.addEventListener('click', () => {
    expandedAll = true;
    showMoreBtn.style.display = 'none';
    applyFilter(currentFilter);
  });

  // Init
  applyFilter('all');
</script>
