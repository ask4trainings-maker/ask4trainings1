---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
---
<BaseLayout title="Contact Us | Ask 4 Trainings">
  <div class="container mx-auto px-4 py-16 max-w-6xl">
    <h1 class="text-4xl md:text-5xl font-heading font-bold text-ink-900 mb-12 text-center">Get in Touch</h1>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <h2 class="text-2xl font-heading font-bold text-ink-900 mb-6">Contact Information</h2>
        <div class="space-y-6 text-ink-700">
          <div class="flex items-start gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div>
              <h3 class="font-bold text-ink-900">Visit Us</h3>
              <p>Ameerpet, Hyderabad<br>Telangana, India</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <div>
              <h3 class="font-bold text-ink-900">Email Us</h3>
              <a href="mailto:ask4trainings@gmail.com" class="hover:text-primary transition-colors">ask4trainings@gmail.com</a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <div>
              <h3 class="font-bold text-ink-900">Call Us</h3>
              <a href="tel:+918099949888" class="hover:text-primary transition-colors">+91 8099949888</a>
            </div>
          </div>
        </div>
        
        <div class="mt-10">
          <WhatsAppCTA className="px-8 py-3 w-full max-w-xs" />
        </div>
      </div>
      
      <div class="bg-surface-50 p-8 rounded-xl border border-border">
        <h2 class="text-2xl font-heading font-bold text-ink-900 mb-6">Send an Enquiry</h2>
        <form class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-ink-700 mb-1">Full Name</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-2 rounded-lg border border-border focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-shadow">
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-ink-700 mb-1">Email Address</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-2 rounded-lg border border-border focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-shadow">
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-ink-700 mb-1">Phone Number</label>
            <input type="tel" id="phone" name="phone" required class="w-full px-4 py-2 rounded-lg border border-border focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-shadow">
          </div>
          <div>
            <label for="course" class="block text-sm font-medium text-ink-700 mb-1">Interested Course</label>
            <select id="course" name="course" class="w-full px-4 py-2 rounded-lg border border-border focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-shadow bg-surface-0">
              <option value="">Select a course...</option>
              <option value="guidewire">Guidewire</option>
              <option value="sap">SAP</option>
              <option value="oracle">Oracle</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-ink-700 mb-1">Message (Optional)</label>
            <textarea id="message" name="message" rows="3" class="w-full px-4 py-2 rounded-lg border border-border focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-shadow"></textarea>
          </div>
          <button type="submit" class="w-full bg-primary hover:bg-primary-hover text-surface-0 font-bold py-3 rounded-lg transition-colors">
            Submit Enquiry
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>
