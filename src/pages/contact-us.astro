---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import IconFacebook from '../components/icons/IconFacebook.astro';
import IconX from '../components/icons/IconX.astro';
import IconLinkedIn from '../components/icons/IconLinkedIn.astro';
import IconYouTube from '../components/icons/IconYouTube.astro';
import IconInstagram from '../components/icons/IconInstagram.astro';
import { getEntry } from 'astro:content';

const contactEntry = await getEntry('pages', 'contact');
const contactData = contactEntry?.data || { headline: '', subheadline: '', inquiryNotice: '', phoneNumbers: [], emailAddresses: [], centerAddress: { street: '', area: '', pincode: '', mapsLink: '' }, formHeader: '', formSubtext: '' };

const footerEntry = await getEntry('settings', 'footer');
const footerData = footerEntry?.data || { socialLinks: [] };
const socials = (footerData.socialLinks || []).reduce((acc: any, curr: any) => {
  acc[curr.platform.toLowerCase()] = curr.url;
  return acc;
}, {});

const formatSocialHandle = (url: string, platform: string) => {
  try {
    const pathname = new URL(url).pathname.replace(/\/$/, '');
    const lastSegment = pathname.split('/').pop() || platform;
    if (platform === 'facebook' || platform === 'linkedin') return lastSegment;
    if (lastSegment.startsWith('@')) return lastSegment;
    return `@${lastSegment}`;
  } catch {
    return platform;
  }
};
---
<BaseLayout title="Contact & Free Demo Registration | Ask4Trainings Hyderabad">
  <div class="bg-slate-50 border-b border-slate-100 py-20 relative overflow-hidden">
    <!-- Ambient glows -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-emerald-600/10 rounded-full blur-[100px]"></div>
    </div>

    <div class="relative max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-slate-900 mb-4 leading-[1.15]">{contactData.headline}</h1>
        <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto space-y-4">{contactData.subheadline}</p>
      </div>

      <!-- Inquiry Notice Banner -->
      {contactData.inquiryNotice && (
        <div class="max-w-4xl mx-auto bg-emerald-50 border border-emerald-100 rounded-xl p-6 text-center mb-16 shadow-sm">
          <p class="text-emerald-800 font-medium">
            {contactData.inquiryNotice}
          </p>
        </div>
      )}
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left Column: Contact Info & Map (7 cols) -->
        <div class="lg:col-span-7 space-y-12">
          
          <div>
            <h2 class="text-2xl font-heading font-bold text-slate-900 mb-8 border-b border-slate-200 pb-4 leading-snug">Contact Information</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-slate-600">
              <div class="flex items-start gap-4 group">
                <div class="bg-white/5 border border-slate-200 p-3.5 rounded-xl group-hover:bg-emerald-600/20 group-hover:border-emerald-600/50 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div class="mt-1">
                  <h3 class="font-bold text-slate-900 text-lg mb-1">Visit Us</h3>
                  <p class="leading-relaxed whitespace-pre-line">{contactData.centerAddress.street}, {contactData.centerAddress.area}<br/>{contactData.centerAddress.pincode}</p>
                </div>
              </div>
              
              <div class="flex items-start gap-4 group">
                <div class="bg-white/5 border border-slate-200 p-3.5 rounded-xl group-hover:bg-emerald-600/20 group-hover:border-emerald-600/50 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="mt-1">
                  <h3 class="font-bold text-slate-900 text-lg mb-1">Email Us</h3>
                  {contactData.emailAddresses.map((email: string) => (
                    <a href={`mailto:${email}`} class="hover:text-emerald-500 transition-colors block mb-1">{email}</a>
                  ))}
                </div>
              </div>
              
              <div class="flex items-start gap-4 group">
                <div class="bg-white/5 border border-slate-200 p-3.5 rounded-xl group-hover:bg-emerald-600/20 group-hover:border-emerald-600/50 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div class="mt-1">
                  <h3 class="font-bold text-slate-900 text-lg mb-1">Call Us</h3>
                  {contactData.phoneNumbers.map((phone: string) => (
                    <a href={`tel:${phone.replace(/[\s-()]/g, '')}`} class="hover:text-emerald-500 transition-colors block">{phone}</a>
                  ))}
                </div>
              </div>
            </div>
            
            <div class="mt-12">
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-6">Connect with Us</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {socials.facebook && (
                  <a href={socials.facebook} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 rounded-xl bg-white border border-slate-200 hover:bg-emerald-50 hover:border-emerald-300 transition-all group shadow-sm hover:shadow-md">
                    <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-slate-50 text-slate-500 group-hover:text-emerald-600 group-hover:bg-emerald-100/50 transition-colors">
                      <IconFacebook class="w-5 h-5"/>
                    </div>
                    <span class="font-medium text-slate-700 group-hover:text-emerald-700 truncate">{formatSocialHandle(socials.facebook, 'facebook')}</span>
                  </a>
                )}
                {socials.twitter && (
                  <a href={socials.twitter} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 rounded-xl bg-white border border-slate-200 hover:bg-emerald-50 hover:border-emerald-300 transition-all group shadow-sm hover:shadow-md">
                    <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-slate-50 text-slate-500 group-hover:text-emerald-600 group-hover:bg-emerald-100/50 transition-colors">
                      <IconX class="w-5 h-5"/>
                    </div>
                    <span class="font-medium text-slate-700 group-hover:text-emerald-700 truncate">{formatSocialHandle(socials.twitter, 'twitter')}</span>
                  </a>
                )}
                {socials.linkedin && (
                  <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 rounded-xl bg-white border border-slate-200 hover:bg-emerald-50 hover:border-emerald-300 transition-all group shadow-sm hover:shadow-md">
                    <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-slate-50 text-slate-500 group-hover:text-emerald-600 group-hover:bg-emerald-100/50 transition-colors">
                      <IconLinkedIn class="w-5 h-5"/>
                    </div>
                    <span class="font-medium text-slate-700 group-hover:text-emerald-700 truncate">{formatSocialHandle(socials.linkedin, 'linkedin')}</span>
                  </a>
                )}
                {socials.youtube && (
                  <a href={socials.youtube} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 rounded-xl bg-white border border-slate-200 hover:bg-emerald-50 hover:border-emerald-300 transition-all group shadow-sm hover:shadow-md">
                    <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-slate-50 text-slate-500 group-hover:text-emerald-600 group-hover:bg-emerald-100/50 transition-colors">
                      <IconYouTube class="w-5 h-5"/>
                    </div>
                    <span class="font-medium text-slate-700 group-hover:text-emerald-700 truncate">{formatSocialHandle(socials.youtube, 'youtube')}</span>
                  </a>
                )}
                {socials.instagram && (
                  <a href={socials.instagram} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 rounded-xl bg-white border border-slate-200 hover:bg-emerald-50 hover:border-emerald-300 transition-all group shadow-sm hover:shadow-md">
                    <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-slate-50 text-slate-500 group-hover:text-emerald-600 group-hover:bg-emerald-100/50 transition-colors">
                      <IconInstagram class="w-5 h-5"/>
                    </div>
                    <span class="font-medium text-slate-700 group-hover:text-emerald-700 truncate">{formatSocialHandle(socials.instagram, 'instagram')}</span>
                  </a>
                )}
              </div>
            </div>
          </div>

        </div>
          
        <!-- Right Column: Enquiry Form (5 cols) -->
        <div class="lg:col-span-5 w-full">
          <div class="sticky top-28">
            <EnquiryForm 
              title={contactData.formHeader} 
              subtitle={contactData.formSubtext} 
            />
          </div>
        </div>
      </div>

      <div class="mt-12 w-full">
        <div class="mb-4">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 leading-snug">Our Location</h2>
          <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed mt-1 space-y-4">Visit our training and corporate operations center in Hyderabad.</p>
        </div>
        
        <!-- Responsive Map Embed Shell -->
        <div class="w-full h-[380px] sm:h-[440px] md:h-[480px] rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-100">
          <iframe 
            src={contactData.centerAddress.mapsLink}
            class="w-full h-full border-0" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="strict-origin-when-cross-origin"
            title="Ask4Trainings Corporate Center Location">
          </iframe>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
