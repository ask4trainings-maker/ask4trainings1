---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import IconFacebook from '../components/icons/IconFacebook.astro';
import IconX from '../components/icons/IconX.astro';
import IconLinkedIn from '../components/icons/IconLinkedIn.astro';
import IconYouTube from '../components/icons/IconYouTube.astro';
import IconInstagram from '../components/icons/IconInstagram.astro';
import contactData from '../data/pages/contact.json';
import settingsData from '../data/settings.json';
---
<BaseLayout title="Contact Us | Ask 4 Trainings">
  <div class="bg-slate-50 border-b border-slate-100 py-20 relative overflow-hidden">
    <!-- Ambient glows -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-emerald-600/10 rounded-full blur-[100px]"></div>
    </div>

    <div class="relative max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-6 sm:px-10 xl:px-16 w-full">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-slate-900 mb-16 text-center">Get in Touch</h1>
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left Column: Contact Info & Map (7 cols) -->
        <div class="lg:col-span-7 space-y-12">
          
          <div>
            <h2 class="text-2xl font-heading font-bold text-slate-900 mb-8 border-b border-slate-200 pb-4">Contact Information</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-slate-600">
              <div class="flex items-start gap-4 group">
                <div class="bg-white border border-slate-200 p-3.5 rounded-xl shadow-sm group-hover:bg-emerald-50 group-hover:border-emerald-300 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div class="mt-1">
                  <h3 class="font-bold text-slate-900 text-lg mb-1">Visit Us</h3>
                  <p class="leading-relaxed whitespace-pre-line">{settingsData.contact.address}</p>
                </div>
              </div>
              
              <div class="flex items-start gap-4 group">
                <div class="bg-white border border-slate-200 p-3.5 rounded-xl shadow-sm group-hover:bg-emerald-50 group-hover:border-emerald-300 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="mt-1">
                  <h3 class="font-bold text-slate-900 text-lg mb-1">Email Us</h3>
                  <a href={`mailto:${settingsData.contact.email}`} class="hover:text-emerald-600 transition-colors block mb-1">{settingsData.contact.email}</a>
                </div>
              </div>
              
              <div class="flex items-start gap-4 group">
                <div class="bg-white border border-slate-200 p-3.5 rounded-xl shadow-sm group-hover:bg-emerald-50 group-hover:border-emerald-300 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div class="mt-1">
                  <h3 class="font-bold text-slate-900 text-lg mb-1">Call Us</h3>
                  <a href={`tel:${settingsData.contact.phone1}`} class="hover:text-emerald-600 transition-colors block mb-1">{settingsData.contact.phone1}</a>
                  <a href={`tel:${settingsData.contact.phone2}`} class="hover:text-emerald-600 transition-colors block">{settingsData.contact.phone2}</a>
                </div>
              </div>
            </div>
            
            <div class="mt-12">
              <h3 class="text-xl font-heading font-bold text-slate-900 mb-6">Connect with Us</h3>
              <div class="flex flex-wrap gap-4">
                {settingsData.socials.facebook && (
                  <a href={settingsData.socials.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-12 h-12 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-600 hover:text-white hover:bg-emerald-600 hover:border-emerald-600 transition-all shadow-md hover:-translate-y-1">
                    <IconFacebook class="w-5 h-5"/>
                  </a>
                )}
                {settingsData.socials.twitter && (
                  <a href={settingsData.socials.twitter} target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="w-12 h-12 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-600 hover:text-white hover:bg-emerald-600 hover:border-emerald-600 transition-all shadow-md hover:-translate-y-1">
                    <IconX class="w-5 h-5"/>
                  </a>
                )}
                {settingsData.socials.linkedin && (
                  <a href={settingsData.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-12 h-12 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-600 hover:text-white hover:bg-emerald-600 hover:border-emerald-600 transition-all shadow-md hover:-translate-y-1">
                    <IconLinkedIn class="w-5 h-5"/>
                  </a>
                )}
                {settingsData.socials.youtube && (
                  <a href={settingsData.socials.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="w-12 h-12 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-600 hover:text-white hover:bg-emerald-600 hover:border-emerald-600 transition-all shadow-md hover:-translate-y-1">
                    <IconYouTube class="w-5 h-5"/>
                  </a>
                )}
                {settingsData.socials.instagram && (
                  <a href={settingsData.socials.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-12 h-12 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-600 hover:text-white hover:bg-emerald-600 hover:border-emerald-600 transition-all shadow-md hover:-translate-y-1">
                    <IconInstagram class="w-5 h-5"/>
                  </a>
                )}
              </div>
            </div>
          </div>

          <div>
            <h2 class="text-2xl font-heading font-bold text-slate-900 mb-6 border-b border-slate-200 pb-4">Our Location</h2>
            <div class="w-full h-80 bg-slate-100 border border-slate-200 rounded-2xl overflow-hidden flex items-center justify-center relative group">
              <!-- Placeholder for Map -->
              <div class="absolute inset-0 bg-white flex flex-col items-center justify-center text-slate-500 z-10 transition-opacity duration-300">
                <svg class="w-12 h-12 mb-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                </svg>
                <span class="font-mono text-sm">[Interactive Google Map Embed]</span>
              </div>
            </div>
          </div>
        </div>
          
        <!-- Right Column: Enquiry Form (5 cols) -->
        <div class="lg:col-span-5 w-full">
          <div class="sticky top-28">
            <EnquiryForm 
              title={contactData.formHeader} 
              subtitle={contactData.formSubtext} 
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
